---
/* =============================================================================
   THE ENDING — the box, fully unpacked. The complete contents are laid out:
   one tile per volume, driven straight from the catalog so it stays aligned
   and simply grows a row as more tools ship. Shipped tools are out (and still
   clickable — take one); anything unshipped is still sealed. Then the last
   line of the slip.
   ========================================================================== */
import { site } from "../data/site.ts";
import { tools } from "../data/tools.ts";

const year = 2026;
const shippedCount = tools.filter((t) => t.shipped).length;
const sealedCount = tools.length - shippedCount;
const volId = (vol: string) => vol.toLowerCase().replace(".", "-");

const foot = [
  { label: "CONTENTS", href: "/#index" },
  { label: "LEDGER", href: "/#ledger" },
  { label: "DOCTRINE", href: "/#doctrine" },
  { label: "DISPATCHES", href: "/dispatches/" },
  { label: "BUILT TO ORDER", href: "/build/" },
  { label: "RSS", href: site.links.rss },
  { label: "CONTACT", href: `mailto:${site.email}` },
];
---

<footer class="foot">
  <div class="wrap foot__ending">
    <p class="foot__eol label" data-reveal>
      <span class="accent" aria-hidden="true">⌀</span> END OF BOX / 001 ·
      {String(shippedCount).padStart(2, "0")} OUT · {String(sealedCount).padStart(2, "0")} SEALED
    </p>

    <ul class="foot__contents" aria-label="Contents of the box, unpacked">
      {
        tools.map((t, i) => {
          const out = t.shipped;
          const href = t.site || t.store || "";
          const isLink = out && Boolean(href);
          const Tag = isLink ? "a" : "div";
          return (
            <li
              class:list={["foot__item", { "foot__item--sealed": !out }]}
              data-reveal
              style={`--reveal-delay:${(i * 0.05).toFixed(2)}s`}
            >
              <Tag
                class="foot__item-in"
                {...(isLink
                  ? {
                      href,
                      target: "_blank",
                      rel: "noopener",
                      "aria-label": `${t.vol} ${t.codename} — ${t.statusLabel}. Unpacked. Opens the tool.`,
                    }
                  : { "aria-label": `${t.vol} — ${t.statusLabel}. Still sealed.` })}
              >
                <span class="foot__item-top">
                  <span class="foot__item-vol mono">{t.vol}</span>
                  <span class:list={["foot__item-mark mono", { "is-out": out }]}>
                    {out ? (
                      <>
                        <svg width="11" height="9" viewBox="0 0 11 9" fill="none" aria-hidden="true">
                          <path d="M1 4.6 L4 7.6 L10 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        OUT
                      </>
                    ) : (
                      "SEALED"
                    )}
                  </span>
                </span>
                <span class="foot__item-name">{t.codename}</span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <p class="foot__closing" data-reveal>The box is open.</p>
    <p class="foot__closing-sub mono" data-reveal>
      NOTHING LEFT INSIDE · NOTHING HIDDEN
    </p>
  </div>

  <div class="wrap foot__inner">
    <nav class="foot__nav" aria-label="Footer">
      {foot.map((f) => <a class="foot__link mono" href={f.href}>{f.label}</a>)}
    </nav>
    <a class="foot__social-link mono" href={site.linkedin} target="_blank" rel="noopener">
      LINKEDIN · YASH DESAI ▸
    </a>
  </div>

  <div class="wrap foot__base">
    <p class="mono">
      © {year} {site.name}. {site.taglineAlt}
    </p>
    <p class="mono foot__sig">
      <span class="glyph accent">✺</span> BUILT BY {site.maker.toUpperCase()} · 0 BYTES UPLOADED
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: var(--hair-strong) solid var(--ink);
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .foot__ending {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .foot__eol {
    margin-bottom: clamp(1.8rem, 4vw, 2.8rem);
  }

  /* the contents, laid out — a grid that stays aligned and grows a row per
     new volume (auto-fit tracks; no fixed geometry to drift out of line) */
  .foot__contents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.7rem;
    width: 100%;
    max-width: 840px;
    margin-bottom: clamp(2.4rem, 5vw, 3.6rem);
    text-align: left;
  }
  .foot__item {
    display: flex;
  }
  .foot__item-in {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.7rem;
    width: 100%;
    padding: 0.85rem 0.95rem;
    border: var(--hair-strong) solid var(--ink);
    border-radius: 2px;
    background: var(--field);
    transition:
      transform 0.18s var(--ease),
      border-color 0.18s var(--ease),
      color 0.18s var(--ease);
  }
  a.foot__item-in:hover,
  a.foot__item-in:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent-text);
    outline: none;
  }
  .foot__item--sealed .foot__item-in {
    border-style: dashed;
    border-color: var(--line-2);
    background: transparent;
  }
  .foot__item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .foot__item-vol {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }
  .foot__item-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .foot__item-mark.is-out {
    color: var(--accent-text);
  }
  .foot__item-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .foot__item--sealed .foot__item-name {
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }
  .foot__closing {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.4rem + 4vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.9rem;
  }
  .foot__closing-sub {
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    color: var(--ink-2);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-top: var(--hair) solid var(--line);
  }
  .foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  .foot__link {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    transition: color 0.15s var(--ease);
  }
  .foot__link:hover {
    color: var(--accent);
  }
  .foot__social-link {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    transition: color 0.15s var(--ease);
  }
  .foot__social-link:hover {
    color: var(--accent);
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.2rem;
    border-top: var(--hair) solid var(--line);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .foot__sig {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
</style>
