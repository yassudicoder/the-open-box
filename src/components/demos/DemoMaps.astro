---
/* =============================================================================
   FIG.04 — MAPS. The demonstration: the Maps results you're already looking at
   become a pitch-ready CSV. The plate's spectacle is the honest blank — the
   email column that Maps never showed. A plausible guess materialises, and the
   tool voids it rather than ship a fabricated lead.

   Everything shown is defensible: it reads what is on the page (no
   content_scripts — it runs on a toolbar click), fills what Maps actually
   displays, and refuses to invent what Maps didn't.
   ========================================================================== */

// Obvious sample data — 555 numbers are the reserved fictional range.
const rows = [
  { name: "Blue Bottle Dental", stars: "4.6", n: "128", phone: "555-0143", site: "bluebottle.com", guess: "info@bluebottle.com" },
  { name: "Riverside Dental", stars: "4.8", n: "92", phone: "555-0177", site: "riverside.com", guess: "hi@riverside.com" },
  { name: "Cedar Park Smiles", stars: "4.3", n: "54", phone: "555-0119", site: "", guess: "hello@cedarpark.com" },
  { name: "Lamar Dental Co", stars: "4.9", n: "211", phone: "555-0164", site: "lamardental.com", guess: "team@lamardental.com" },
];
---

<figure class="fig demo-mp" data-demo="maps" data-phase="static">
  <span class="fig__corner fig__corner--tl" aria-hidden="true"></span>
  <span class="fig__corner fig__corner--tr" aria-hidden="true"></span>
  <span class="fig__corner fig__corner--bl" aria-hidden="true"></span>
  <span class="fig__corner fig__corner--br" aria-hidden="true"></span>

  <div class="fig__bar">
    <span class="fig__bar-label">FIG. 04 — WORKING DEMONSTRATION</span>
    <button class="fig__replay" data-replay type="button" aria-label="Replay the Maps Lead Export demonstration">
      REPLAY ▸
    </button>
  </div>

  <div class="fig__stage mp" aria-hidden="true">
    <!-- what you're already looking at -->
    <div class="mp__page">
      <div class="mp__pagehead mono">
        <span class="mp__query">dentists in austin</span>
        <span class="mp__read" data-read>READ 4</span>
      </div>
      <ul class="mp__results">
        {rows.map((r, i) => (
          <li class="mp__card" style={`--i:${i}`}>
            <span class="mp__pin" aria-hidden="true"></span>
            <span class="mp__cardbody">
              <span class="mp__name">{r.name}</span>
              <span class="mp__meta mono">★ {r.stars} ({r.n}) · {r.phone}</span>
            </span>
            <span class="mp__tick" aria-hidden="true">
              <svg width="9" height="7" viewBox="0 0 9 7" fill="none"><path d="M1 3.6 L3.4 6 L8 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </li>
        ))}
      </ul>
      <span class="mp__toolbar mono" data-toolbar>
        <span class="mp__icon" aria-hidden="true"></span>EXPORT
      </span>
    </div>

    <!-- what comes out -->
    <div class="mp__sheet">
      <div class="mp__sheethead mono">
        <span data-file>maps-leads.csv</span>
      </div>

      <div class="mp__table" role="presentation">
        <!-- the rejection stamp lands across the column Maps never filled -->
        <span class="mp__stamp mono" data-stamp>NOT ON THE PAGE</span>
        <div class="mp__tr mp__tr--head mono">
          <span>NAME</span><span>PHONE</span><span>SITE</span><span>EMAIL</span>
        </div>
        {rows.map((r, i) => (
          <div class="mp__tr mono" style={`--i:${i}`}>
            <span class="mp__cell mp__cell--name">{r.name}</span>
            <span class="mp__cell">{r.phone}</span>
            <span class:list={["mp__cell", { "is-empty": !r.site }]}>{r.site || "—"}</span>
            <span class="mp__cell mp__cell--email">
              <i class="mp__guess">{r.guess}</i>
              <i class="mp__blank">—</i>
            </span>
          </div>
        ))}
      </div>

      <div class="mp__file mono" data-csv>
        <span class="mp__fileicon" aria-hidden="true">
          <svg width="11" height="13" viewBox="0 0 11 13" fill="none"><path d="M1 1h6l3 3v8H1z M7 1v3h3" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
        </span>
        maps-leads.csv · 4 ROWS
      </div>
    </div>
  </div>

  <figcaption class="fig__foot">
    <span class="fig__status" data-status>READS ONLY WHAT'S ON THE PAGE</span>
    <span>NO SERVER · NO ACCOUNT</span>
  </figcaption>
</figure>

<style>
  .mp {
    display: grid;
    grid-template-columns: 4fr 7fr;
    min-height: 268px;
  }

  /* ---- the results you're already looking at ---- */
  .mp__page {
    position: relative;
    display: flex;
    flex-direction: column;
    border-right: var(--hair) dashed var(--line);
    min-width: 0;
  }
  .mp__pagehead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: var(--label-aa);
    border-bottom: var(--hair) dashed var(--line);
  }
  .mp__query::before {
    content: "⌕ ";
    color: var(--accent-text);
  }
  .mp__read {
    color: var(--accent-text);
    font-weight: 700;
    flex: none;
  }
  .mp__results {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem;
    min-width: 0;
  }
  .mp__card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0.32rem 0.4rem;
    border: var(--hair) solid var(--line);
    border-radius: 2px;
    background: var(--paper);
    min-width: 0;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .mp__pin {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.28em;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--line-2);
    transition: background 0.25s var(--ease);
  }
  .mp__cardbody {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .mp__name {
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp__meta {
    font-size: 0.48rem;
    letter-spacing: 0.04em;
    color: var(--label-aa);
    white-space: nowrap;
  }
  .mp__tick {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    border-radius: 1px;
    background: var(--accent-text);
    color: var(--accent-ink);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.2s var(--ease), transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* the toolbar click — nothing runs until you press it */
  .mp__toolbar {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.3em 0.5em;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    background: var(--paper);
    border: var(--hair) solid var(--line-2);
    border-radius: 2px;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.14s var(--ease);
  }
  .mp__icon {
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-radius: 1px;
  }

  /* ---- the sheet that comes out ---- */
  .mp__sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mp__sheethead {
    padding: 0.45rem 0.6rem;
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
    border-bottom: var(--hair) dashed var(--line);
  }
  .mp__table {
    position: relative;
    flex: 1;
    padding: 0.4rem 0.5rem;
    min-width: 0;
  }
  .mp__tr {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1.05fr 1.6fr;
    gap: 0.35rem;
    align-items: center;
    padding: 0.28rem 0.15rem;
    border-bottom: var(--hair) dotted var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.3s var(--ease-out), transform 0.34s var(--ease-out);
  }
  .mp__tr--head {
    opacity: 1;
    transform: none;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--label-aa);
    border-bottom: var(--hair) solid var(--line-2);
  }
  .mp__cell {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp__cell--name {
    font-weight: 600;
  }
  .mp__cell.is-empty {
    color: var(--label-aa);
  }
  /* the email column — where the honest blank happens. The stamp lands
     across it the way an inspector voids a field that can't be verified. */
  .mp__stamp {
    position: absolute;
    right: 0.4rem;
    top: 52%;
    z-index: 3;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    border: 1.5px solid currentColor;
    border-radius: 2px;
    padding: 0.24em 0.42em;
    background: color-mix(in oklab, var(--field) 88%, transparent);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-50%) scale(1.6) rotate(-11deg);
    transition:
      opacity 0.16s var(--ease),
      transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .mp__cell--email {
    position: relative;
    min-width: 0;
  }
  .mp__guess,
  .mp__blank {
    display: block;
    font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* the plausible-looking value the tool refuses to ship */
  .mp__guess {
    color: var(--ink-3);
    opacity: 0;
    transition: opacity 0.25s var(--ease), color 0.25s var(--ease);
    position: relative;
  }
  .mp__guess::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--accent-text);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.3s var(--ease);
  }
  .mp__blank {
    position: absolute;
    inset: 0;
    color: var(--label-aa);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }

  /* the finished file */
  .mp__file {
    position: absolute;
    left: 50%;
    bottom: 0.55rem;
    transform: translateX(-50%) translateY(8px) scale(0.9);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 0.7em;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: var(--ink);
    color: var(--paper);
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.3s var(--ease), transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 2;
    white-space: nowrap;
  }
  .mp__fileicon {
    display: grid;
    color: var(--accent);
  }

  /* ---------------- phase choreography ---------------- */
  /* click: the toolbar button is pressed — nothing ran before this */
  [data-phase="click"] .mp__toolbar {
    color: var(--accent-text);
    border-color: var(--accent-text);
    transform: scale(0.94);
  }

  /* read: each visible card is read in turn */
  [data-phase="read"] .mp__card,
  [data-phase="fill"] .mp__card,
  [data-phase="guess"] .mp__card,
  [data-phase="void"] .mp__card,
  [data-phase="blank"] .mp__card,
  [data-phase="csv"] .mp__card,
  [data-phase="static"] .mp__card {
    border-color: color-mix(in oklab, var(--accent-text) 45%, var(--line));
    transition-delay: calc(var(--i) * 0.16s);
  }
  [data-phase="read"] .mp__pin,
  [data-phase="fill"] .mp__pin,
  [data-phase="guess"] .mp__pin,
  [data-phase="void"] .mp__pin,
  [data-phase="blank"] .mp__pin,
  [data-phase="csv"] .mp__pin,
  [data-phase="static"] .mp__pin {
    background: var(--accent-text);
    transition-delay: calc(var(--i) * 0.16s);
  }
  [data-phase="read"] .mp__tick,
  [data-phase="fill"] .mp__tick,
  [data-phase="guess"] .mp__tick,
  [data-phase="void"] .mp__tick,
  [data-phase="blank"] .mp__tick,
  [data-phase="csv"] .mp__tick,
  [data-phase="static"] .mp__tick {
    opacity: 1;
    transform: scale(1);
    transition-delay: calc(var(--i) * 0.16s);
  }

  /* fill: rows land in the sheet */
  [data-phase="fill"] .mp__tr,
  [data-phase="guess"] .mp__tr,
  [data-phase="void"] .mp__tr,
  [data-phase="blank"] .mp__tr,
  [data-phase="csv"] .mp__tr,
  [data-phase="static"] .mp__tr {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 0.11s);
  }

  /* guess: a plausible email materialises in every row */
  [data-phase="guess"] .mp__guess {
    opacity: 1;
    transition-delay: calc(var(--i) * 0.07s);
  }

  /* void: each guess is struck through — the tool refusing it, one by one */
  [data-phase="void"] .mp__guess {
    opacity: 0.4;
    transition-delay: calc(var(--i) * 0.08s);
  }
  [data-phase="void"] .mp__guess::after,
  [data-phase="blank"] .mp__guess::after,
  [data-phase="csv"] .mp__guess::after {
    transform: scaleX(1);
    transition-delay: calc(var(--i) * 0.08s);
  }

  /* blank: the struck guesses clear, leaving an honest dash + the stamp */
  [data-phase="blank"] .mp__guess,
  [data-phase="csv"] .mp__guess,
  [data-phase="static"] .mp__guess {
    opacity: 0;
    transition-delay: calc(var(--i) * 0.05s);
  }
  [data-phase="blank"] .mp__blank,
  [data-phase="csv"] .mp__blank,
  [data-phase="static"] .mp__blank {
    opacity: 1;
    transition-delay: calc(0.12s + var(--i) * 0.05s);
  }
  [data-phase="blank"] .mp__stamp,
  [data-phase="csv"] .mp__stamp,
  [data-phase="static"] .mp__stamp {
    opacity: 1;
    transform: translateY(-50%) scale(1) rotate(-7deg);
    transition-delay: 0.34s;
  }
  [data-phase="static"] .mp__stamp {
    transition-delay: 0s;
  }

  /* csv: the sheet becomes a file */
  [data-phase="csv"] .mp__file,
  [data-phase="static"] .mp__file {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
    transition-delay: 0.25s;
  }
  [data-phase="static"] .mp__file {
    transition-delay: 0s;
  }
  [data-phase="csv"] .mp__table {
    opacity: 0.32;
    transition: opacity 0.4s var(--ease) 0.2s;
  }

  /* narrow: stack the page above the sheet */
  @media (max-width: 620px) {
    .mp {
      grid-template-columns: 1fr;
    }
    .mp__page {
      border-right: 0;
      border-bottom: var(--hair) dashed var(--line);
    }
    /* reserve the toolbar's own space so it never sits on a result card */
    .mp__results {
      padding-bottom: 2rem;
    }
    .mp__tr {
      grid-template-columns: 1.35fr 0.8fr 1fr 1.5fr;
      font-size: 0.44rem;
      gap: 0.25rem;
    }
    .mp__stamp {
      font-size: 0.44rem;
      right: 0.3rem;
    }
    .mp__table {
      padding-bottom: 2.4rem;
    }
  }
</style>

<script>
  import { attachDemo } from "../../scripts/demo";

  const root = document.querySelector<HTMLElement>('[data-demo="maps"]');
  if (root) {
    const q = (s: string) => root.querySelector<HTMLElement>(s);
    const read = q("[data-read]");
    const status = q("[data-status]");

    attachDemo(root, async (ctx) => {
      ctx.phase("browse");
      ctx.set(read, "READ 0");
      ctx.set(status, "THE RESULTS YOU'RE ALREADY LOOKING AT");
      await ctx.sleep(1100);

      ctx.phase("click");
      ctx.set(status, "NOTHING RUNS UNTIL YOU CLICK");
      await ctx.sleep(700);

      ctx.phase("read");
      ctx.set(status, "READING WHAT'S ON THE PAGE — NOTHING ELSE");
      for (let i = 1; i <= 4; i++) {
        ctx.set(read, `READ ${i}`);
        await ctx.sleep(170);
      }
      await ctx.sleep(500);

      ctx.phase("fill");
      ctx.set(status, "NAME · PHONE · SITE — STRAIGHT OFF THE LISTING");
      await ctx.sleep(1400);

      ctx.phase("guess");
      ctx.set(status, "AN EMAIL WOULD BE EASY TO GUESS…");
      await ctx.sleep(1500);

      ctx.phase("void");
      ctx.set(status, "MAPS NEVER SHOWED ONE — SO IT'S REFUSED");
      await ctx.sleep(1500);

      ctx.phase("blank");
      ctx.set(status, "LEFT HONESTLY BLANK · NO INVENTED LEADS");
      await ctx.sleep(1900);

      ctx.phase("csv");
      ctx.set(status, "PITCH-READY CSV · COLUMNS YOU CAN TRUST");
      await ctx.sleep(2400);
    });
  }
</script>
