---
/* =============================================================================
   01 / THE CONTENTS — what came out of the box.
   Each shipped tool is a bay: an identity plate on one side, a working
   demonstration (FIG.) on the other. The unshipped volume stays sealed.
   Keyboard contract: ↑↓ move between bays, ↵ opens the primary link.
   ========================================================================== */
import SectionHeader from "./SectionHeader.astro";
import DemoCanned from "./demos/DemoCanned.astro";
import DemoContinue from "./demos/DemoContinue.astro";
import DemoBulk from "./demos/DemoBulk.astro";
import DemoMaps from "./demos/DemoMaps.astro";
import { tools, statusOrder } from "../data/tools.ts";

const sorted = [...tools].sort(
  (a, b) => statusOrder[a.status] - statusOrder[b.status],
);
const span = `01–${String(tools.length).padStart(2, "0")}`;
const volId = (vol: string) => vol.toLowerCase().replace(".", "-");

// Which codenames render a FIG. plate beside their identity plate. A shipped
// tool without one gets a full-width plate rather than an empty column.
const HAS_FIG = new Set(["CANNED", "CONTINUE", "BULK", "MAPS"]);
---

<section class="section" id="index" aria-labelledby="index-h">
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="The Contents"
      sublabel="UNPACKED · SCALE 1:1"
      kicker={`CONTENTS / ${span} · ↑↓ INSPECT · ↵ OPEN`}
      id="index-h"
    />

    <ol class="bays" data-index>
      {
        sorted.map((t, i) => {
          const research = t.status === "research";
          return (
            <li
              class:list={["bay", { "bay--sealed": research, "bay--flip": i % 2 === 1 && !research }]}
              id={volId(t.vol)}
              data-irow
              data-vol={t.vol}
            >
              <div class="bay__rail mono" data-reveal>
                <span class="bay__n">{String(i + 1).padStart(2, "0")}</span>
                <span class="bay__vol">{t.vol}</span>
                <span class="pill" data-status={t.status}>{t.statusLabel}</span>
                <span class="bay__kind">{t.kind.toUpperCase()}</span>
              </div>

              {research ? (
                <div class="bay__sealedbody" data-reveal>
                  <div class="bay__minibox" aria-hidden="true">
                    <svg viewBox="0 0 92 66" fill="none">
                      <rect x="6" y="10" width="80" height="50" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" />
                      <path d="M6 32 H86" stroke="var(--accent)" stroke-width="7" opacity="0.85" />
                      <path d="M6 32 H86" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
                    </svg>
                    <span class="bay__minibox-label mono">SEALED</span>
                  </div>
                  <div class="bay__sealedcopy">
                    <h3 class="bay__name bay__name--dim">DO NOT OPEN YET</h3>
                    <p class="bay__line">{t.oneLiner}</p>
                    {t.specs && (
                      <ul class="bay__specs">
                        {t.specs.map((s) => (
                          <li class="mono">{s}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              ) : (
                <div class:list={["bay__grid", { "bay__grid--solo": !HAS_FIG.has(t.codename) }]}>
                  <div class="bay__plate" data-reveal>
                    <h3 class="bay__name">{t.codename}</h3>
                    <p class="bay__full mono">{t.title}</p>
                    <p class="bay__line">{t.oneLiner}</p>

                    {t.specs && (
                      <ul class="bay__specs" aria-label="Specifications">
                        {t.specs.map((s) => (
                          <li class="mono">{s}</li>
                        ))}
                      </ul>
                    )}

                    <ul class="bay__tags" aria-label="Platforms">
                      {t.platforms.map((p) => (
                        <li class="tag mono">{p}</li>
                      ))}
                      {t.installs && <li class="tag mono">{t.installs} INSTALLS</li>}
                    </ul>

                    <div class="bay__cta">
                      {t.site && (
                        <a class="btn btn--accent" href={t.site} target="_blank" rel="noopener">
                          OPEN SITE <span aria-hidden="true">▸</span>
                        </a>
                      )}
                      {t.store && (
                        <a class="btn btn--ghost" href={t.store} target="_blank" rel="noopener">
                          CHROME WEB STORE <span aria-hidden="true">▸</span>
                        </a>
                      )}
                    </div>
                  </div>

                  {HAS_FIG.has(t.codename) && (
                    <div class="bay__fig" data-reveal style="--reveal-delay:0.12s">
                      {t.codename === "CANNED" && <DemoCanned />}
                      {t.codename === "CONTINUE" && <DemoContinue />}
                      {t.codename === "BULK" && <DemoBulk />}
                      {t.codename === "MAPS" && <DemoMaps />}
                    </div>
                  )}
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .bays {
    border-top: var(--hair) solid var(--line);
  }
  .bay {
    position: relative;
    padding: clamp(2rem, 4.5vw, 3.4rem) 0;
    border-bottom: var(--hair) solid var(--line);
    scroll-margin-top: 70px;
  }
  .bay::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--gutter));
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s var(--ease);
  }
  .bay:hover::before,
  .bay:focus-within::before {
    transform: scaleY(1);
  }

  .bay__rail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: clamp(1.1rem, 2.5vw, 1.8rem);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }
  .bay__n {
    color: var(--label-aa);
  }
  .bay__vol {
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .bay__kind {
    margin-left: auto;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--label-aa);
  }

  .bay__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.4rem, 3.5vw, 3rem);
    align-items: start;
  }
  /* a shipped tool with no FIG. plate keeps a single readable column instead
     of leaving an empty half */
  .bay__grid--solo .bay__plate {
    max-width: 62ch;
  }

  .bay__plate {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
  }
  .bay__name {
    font-size: clamp(2.2rem, 1.4rem + 3.6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 0.92;
    text-transform: uppercase;
  }
  .bay__name--dim {
    color: var(--label-aa);
    letter-spacing: 0.04em;
    font-size: clamp(1.4rem, 1rem + 1.8vw, 2.2rem);
  }
  .bay__full {
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .bay__line {
    color: var(--ink-2);
    font-size: 1rem;
    max-width: 46ch;
  }
  .bay__specs {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.3rem;
  }
  .bay__specs li {
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    text-transform: uppercase;
    position: relative;
    padding-left: 1em;
  }
  .bay__specs li::before {
    content: "+";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .bay__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .bay__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.4rem;
  }

  .bay__fig {
    min-width: 0;
  }

  /* sealed VOL.04 — dimmed by ink choice, not by opacity, so it stays legible */
  .bay__sealedbody {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.4rem, 4vw, 3rem);
  }
  .bay__minibox {
    position: relative;
    width: clamp(120px, 18vw, 170px);
    color: var(--ink-3);
    flex: none;
  }
  .bay__minibox svg {
    width: 100%;
    height: auto;
  }
  .bay__minibox-label {
    position: absolute;
    left: 50%;
    top: 48.5%;
    transform: translate(-50%, -50%);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--accent-ink);
  }
  .bay__sealedcopy {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 52ch;
  }

  @media (min-width: 860px) {
    .bay__grid:not(.bay__grid--solo) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
    .bay--flip .bay__grid:not(.bay__grid--solo) {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .bay--flip .bay__plate {
      order: 2;
    }
    .bay--flip .bay__fig {
      order: 1;
    }
  }
</style>

<script>
  // ↑/↓ moves between bays' primary links; ↵ is just the link's native
  // activation. The contract lives on real links — no fake-interactive rows,
  // nothing for a screen reader to guess at.
  function initContents() {
    const primaries = Array.from(
      document.querySelectorAll<HTMLElement>("[data-irow]"),
    )
      .map((row) => row.querySelector<HTMLElement>(".bay__cta a"))
      .filter((a): a is HTMLElement => Boolean(a));
    primaries.forEach((link, i) => {
      link.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          primaries[Math.min(i + 1, primaries.length - 1)].focus();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          primaries[Math.max(i - 1, 0)].focus();
        }
      });
    });
  }
  if (document.readyState !== "loading") initContents();
  else document.addEventListener("DOMContentLoaded", initContents);
</script>
