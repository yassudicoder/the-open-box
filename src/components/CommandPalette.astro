---
import { tools } from "../data/tools.ts";
import { site } from "../data/site.ts";
import { ledger } from "../data/ledger.ts";

type Item = {
  label: string;
  hint: string;
  group: string;
  action: string; // "scroll:#id" | "href:url" | "route:/path"
  keywords?: string;
};

const sections: Item[] = [
  { label: "The Box / Top", hint: "00 · UNBOX", group: "GO", action: "scroll:#top", keywords: "home start box hero seal" },
  { label: "The Contents", hint: "01 · CATALOG", group: "GO", action: "scroll:#index", keywords: "tools catalog vol index demos" },
  { label: "The Ledger", hint: "02 · MANIFEST", group: "GO", action: "scroll:#ledger", keywords: "stats shipped installs" },
  { label: "The Doctrine", hint: "03 · CONSTRAINTS", group: "GO", action: "scroll:#doctrine", keywords: "manifesto principles rules" },
  { label: "In the Lab", hint: "04 · RESTRICTED", group: "GO", action: "scroll:#lab", keywords: "next building research" },
  { label: "Build", hint: "05 · WEBSITES", group: "GO", action: "scroll:#build", keywords: "websites clients salon clinic cafe demos catalogue showroom design" },
  { label: "Dispatches", hint: "06 · FIELD REPORTS", group: "GO", action: "scroll:#dispatches", keywords: "blog news field notes changelog" },
  { label: "The Maker", hint: "07 · SIGNATURE", group: "GO", action: "scroll:#colophon", keywords: "about contact stack uses colophon" },
];

const toolItems: Item[] = tools.flatMap((t) => {
  const out: Item[] = [];
  if (t.site)
    out.push({
      label: `${t.vol} ${t.codename} — Site`,
      hint: t.statusLabel,
      group: "OPEN",
      action: `href:${t.site}`,
      keywords: t.title.toLowerCase(),
    });
  if (t.store)
    out.push({
      label: `${t.vol} ${t.codename} — Chrome Web Store`,
      hint: "STORE",
      group: "OPEN",
      action: `href:${t.store}`,
      keywords: t.title.toLowerCase() + " extension install",
    });
  return out;
});

const extra: Item[] = [
  { label: "All Dispatches", hint: "INDEX", group: "OPEN", action: "route:/dispatches/", keywords: "blog all posts" },
  { label: "RSS Feed", hint: "XML", group: "OPEN", action: `route:${site.links.rss}`, keywords: "feed subscribe" },
  { label: "Email Yash", hint: site.email, group: "OPEN", action: `href:mailto:${site.email}`, keywords: "contact mail" },
];

const items = [...sections, ...toolItems, ...extra];

const paletteData = {
  items,
  console: {
    maker: site.maker,
    name: site.name,
    tagline: site.tagline,
    toolsShipped: ledger.toolsShipped,
    lastShipped: `${ledger.lastShipped} · ${ledger.lastShippedVol}`,
    vols: tools.map((t) => ({
      vol: t.vol,
      codename: t.codename,
      title: t.title,
      status: t.statusLabel,
      site: t.site || "",
      line: t.oneLiner,
    })),
  },
};
---

<div class="palette" data-palette hidden>
  <div class="palette__scrim" data-palette-scrim></div>
  <div
    class="palette__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
    data-palette-panel
  >
    <div class="palette__inputrow">
      <span class="palette__prompt mono" aria-hidden="true">⌀</span>
      <input
        class="palette__input mono"
        type="text"
        placeholder="Jump to a tool or section — or type a command (try: help)"
        aria-label="Search or run a command"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-results"
        aria-autocomplete="list"
        data-palette-input
      />
      <kbd class="palette__esc">ESC</kbd>
    </div>

    <div class="palette__console mono" data-palette-console hidden></div>

    <ul
      class="palette__results"
      role="listbox"
      aria-label="Results"
      id="palette-results"
      data-palette-results
    ></ul>

    <div class="palette__foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> NAVIGATE</span>
      <span><kbd>↵</kbd> SELECT</span>
      <span><kbd>ESC</kbd> CLOSE</span>
      <span class="palette__foot-cmd">TYPE <strong>help</strong> FOR CONSOLE</span>
    </div>
  </div>
</div>

<script type="application/json" data-palette-data set:html={JSON.stringify(paletteData)} />

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: start center;
    padding-top: 12vh;
  }
  .palette[hidden] {
    display: none;
  }
  /* flat scrim, hard offset shadow — a document laid on the page, not a
     floating glass modal */
  .palette__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--paper) 26%, #000 60%);
    animation: fade 0.16s var(--ease) both;
  }
  :root[data-theme="dark"] .palette__scrim {
    background: color-mix(in oklab, #000 74%, transparent);
  }
  .palette__panel {
    position: relative;
    width: min(620px, 92vw);
    max-height: calc(100vh - 12vh - 2rem);
    max-height: calc(100svh - 12vh - 2rem);
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: var(--hair-strong) solid var(--ink);
    border-radius: 3px;
    box-shadow: 7px 7px 0 0 color-mix(in oklab, var(--ink) 22%, transparent);
    overflow: hidden;
    animation: pop 0.18s var(--ease-out) both;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
  }
  .palette__inputrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border-bottom: var(--hair) solid var(--line);
  }
  .palette__inputrow,
  .palette__foot {
    flex: none;
  }
  .palette__console {
    flex: none;
  }
  .palette__prompt {
    color: var(--accent-text);
    font-size: 1rem;
  }
  .palette__input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--ink);
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }
  .palette__input::placeholder {
    color: var(--label-aa);
  }
  .palette__esc {
    font-size: 0.6rem;
  }
  .palette__console {
    max-height: 240px;
    overflow-y: auto;
    padding: 0.8rem 1rem;
    border-bottom: var(--hair) solid var(--line);
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--ink-2);
    white-space: pre-wrap;
    background: var(--field);
  }
  .palette__console[hidden] {
    display: none;
  }
  .palette__console .c-accent {
    color: var(--accent-text);
  }
  .palette__console .c-ink {
    color: var(--ink);
    font-weight: 600;
  }
  .palette__console .c-cmd {
    color: var(--ink);
  }
  .palette__results {
    flex: 1 1 auto;
    min-height: 0;
    max-height: 46vh;
    overflow-y: auto;
    padding: 0.4rem;
  }
  .palette__results:empty {
    padding: 0;
  }
  .palette__group {
    padding: 0.6rem 0.7rem 0.3rem;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .palette__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.7rem;
    border-radius: 2px;
    cursor: pointer;
    scroll-margin: 0.5rem;
  }
  .palette__item[aria-selected="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .palette__item[aria-selected="true"] .palette__item-hint {
    color: var(--paper);
    opacity: 0.7;
  }
  .palette__item-label {
    font-size: 0.84rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .palette__item-label::before {
    content: "▸";
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  .palette__item[aria-selected="true"] .palette__item-label::before {
    color: var(--paper);
  }
  .palette__item-hint {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--label-aa);
    flex: none;
  }
  .palette__empty {
    padding: 1.4rem 0.7rem;
    text-align: center;
    color: var(--label-aa);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
  .palette__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    padding: 0.7rem 1rem;
    border-top: var(--hair) solid var(--line);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .palette__foot kbd {
    font-size: 0.92em;
    padding: 0.1em 0.3em;
    margin-right: 0.15em;
  }
  .palette__foot-cmd {
    margin-left: auto;
  }
  .palette__foot-cmd strong {
    color: var(--accent-text);
  }
</style>

<script>
  type Item = {
    label: string;
    hint: string;
    group: string;
    action: string;
    keywords?: string;
  };

  function initPalette() {
    const root = document.querySelector<HTMLElement>("[data-palette]");
    const panel = document.querySelector<HTMLElement>("[data-palette-panel]");
    const input = document.querySelector<HTMLInputElement>("[data-palette-input]");
    const results = document.querySelector<HTMLElement>("[data-palette-results]");
    const consoleEl = document.querySelector<HTMLElement>("[data-palette-console]");
    const scrim = document.querySelector<HTMLElement>("[data-palette-scrim]");
    const dataEl = document.querySelector<HTMLElement>("[data-palette-data]");
    if (!root || !panel || !input || !results || !consoleEl || !dataEl) return;

    const data = JSON.parse(dataEl.textContent || "{}");
    const items: Item[] = data.items || [];
    const con = data.console || {};

    let selected = 0;
    let filtered: Item[] = [];
    let lastFocus: HTMLElement | null = null;

    const KNOWN_CMDS = [
      "help", "open", "vol", "ship", "doctrine", "theme", "whoami", "box", "clear",
    ];

    const isCommand = (q: string) =>
      KNOWN_CMDS.includes(q.trim().toLowerCase().split(/\s+/)[0]);

    // the console is an innerHTML sink — user input must never reach it raw
    const esc = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    function open() {
      lastFocus = document.activeElement as HTMLElement;
      root.hidden = false;
      input.value = "";
      consoleEl.hidden = true;
      render("");
      requestAnimationFrame(() => input.focus());
      document.documentElement.style.overflow = "hidden";
    }
    function close() {
      root.hidden = true;
      document.documentElement.style.overflow = "";
      lastFocus?.focus?.();
    }
    const isOpen = () => !root.hidden;

    function render(q: string) {
      const query = q.trim().toLowerCase();
      filtered = !query
        ? items
        : items.filter((it) =>
            (it.label + " " + it.hint + " " + (it.keywords || ""))
              .toLowerCase()
              .includes(query),
          );
      selected = 0;
      const footCmd = document.querySelector<HTMLElement>(".palette__foot-cmd");
      if (footCmd)
        footCmd.innerHTML = isCommand(q)
          ? "↵ <strong>RUN COMMAND</strong>"
          : "TYPE <strong>help</strong> FOR CONSOLE";

      if (!filtered.length) {
        results.innerHTML = `<li class="palette__empty">NO MATCH · try a command like <strong>help</strong></li>`;
        return;
      }
      let html = "";
      let lastGroup = "";
      filtered.forEach((it, i) => {
        if (it.group !== lastGroup) {
          html += `<li class="palette__group" role="presentation">${it.group}</li>`;
          lastGroup = it.group;
        }
        html += `<li class="palette__item" role="option" id="palette-opt-${i}" data-i="${i}" aria-selected="${i === 0}">
          <span class="palette__item-label">${it.label}</span>
          <span class="palette__item-hint">${it.hint}</span>
        </li>`;
      });
      results.innerHTML = html;
      input.setAttribute("aria-activedescendant", filtered.length ? "palette-opt-0" : "");
      bindRows();
    }

    function bindRows() {
      results.querySelectorAll<HTMLElement>(".palette__item").forEach((row) => {
        row.addEventListener("mousemove", () => {
          selected = Number(row.dataset.i);
          paint();
        });
        row.addEventListener("click", () => {
          selected = Number(row.dataset.i);
          run(filtered[selected]);
        });
      });
    }

    function paint() {
      results.querySelectorAll<HTMLElement>(".palette__item").forEach((row) => {
        const on = Number(row.dataset.i) === selected;
        row.setAttribute("aria-selected", String(on));
        if (on) {
          row.scrollIntoView({ block: "nearest" });
          input.setAttribute("aria-activedescendant", row.id);
        }
      });
    }

    function run(it: Item | undefined) {
      if (!it) return;
      const [kind, ...rest] = it.action.split(":");
      const target = rest.join(":");
      if (kind === "scroll") {
        close();
        document.querySelector(target)?.scrollIntoView({ behavior: "smooth", block: "start" });
      } else if (kind === "href") {
        window.open(target, target.startsWith("mailto:") ? "_self" : "_blank", "noopener");
        close();
      } else if (kind === "route") {
        window.location.href = target;
      }
    }

    /* ---- easter-egg console ---- */
    function print(html: string) {
      consoleEl.hidden = false;
      consoleEl.innerHTML += html + "\n";
      consoleEl.scrollTop = consoleEl.scrollHeight;
    }
    function runCommand(raw: string) {
      const parts = raw.trim().split(/\s+/);
      const cmd = parts[0].toLowerCase();
      const arg = parts.slice(1).join(" ").toLowerCase();
      print(`<span class="c-accent">›</span> <span class="c-cmd">${esc(raw)}</span>`);
      switch (cmd) {
        case "help":
          print(
            `<span class="c-ink">COMMANDS</span>\n` +
              `  help            this list\n` +
              `  open &lt;vol|sect&gt;  open a tool or jump to a section\n` +
              `  vol [n]         show volume n (or all)\n` +
              `  ship            what's shipped + the ledger\n` +
              `  doctrine        the operating principles\n` +
              `  theme [l|d]     flip the lights\n` +
              `  whoami          who makes this\n` +
              `  box             open the box\n` +
              `  clear           wipe the console`,
          );
          break;
        case "whoami":
          print(`<span class="c-ink">${con.maker}</span> — solo. ${con.name}. ${con.tagline}`);
          break;
        case "ship": {
          const live = (con.vols || []).filter((v: any) => v.site);
          print(
            `<span class="c-ink">SHIPPED ${con.toolsShipped}</span> · last ${con.lastShipped}\n` +
              live
                .map((v: any) => `  <span class="c-accent">${v.vol}</span> ${v.codename} — ${v.status}`)
                .join("\n") +
              `\n  0 servers · 0 bytes uploaded · the ledger is the receipt`,
          );
          break;
        }
        case "doctrine":
          print(
            `01 local-first · 02 no accounts · 03 keyboard-first\n` +
              `04 open about everything · 05 ship in public`,
          );
          break;
        case "vol": {
          const vols = con.vols || [];
          if (!arg) {
            print(vols.map((v: any) => `  <span class="c-accent">${v.vol}</span> ${v.codename} — ${v.status}`).join("\n"));
          } else {
            const n = arg.replace(/[^0-9]/g, "").padStart(2, "0");
            const v = vols.find((x: any) => x.vol.endsWith(n));
            if (v)
              print(`<span class="c-ink">${v.vol} ${v.codename}</span> [${v.status}]\n  ${v.title}\n  ${v.line}${v.site ? `\n  ↪ ${v.site}` : ""}`);
            else print(`no such volume: ${esc(arg)}`);
          }
          break;
        }
        case "open": {
          const vols = con.vols || [];
          const sectionMap: Record<string, string> = {
            index: "#index", ledger: "#ledger", doctrine: "#doctrine",
            lab: "#lab", dispatches: "#dispatches", colophon: "#colophon", top: "#top",
          };
          if (sectionMap[arg]) {
            close();
            document.querySelector(sectionMap[arg])?.scrollIntoView({ behavior: "smooth" });
            return;
          }
          const n = arg.replace(/[^0-9]/g, "");
          const v = vols.find((x: any) => x.vol.endsWith(n.padStart(2, "0")) || x.codename.toLowerCase() === arg);
          if (v && v.site) {
            print(`opening <span class="c-accent">${v.vol} ${v.codename}</span> ↪ ${v.site}`);
            window.open(v.site, "_blank", "noopener");
          } else {
            print(`can't open "${esc(arg)}" — try: open index · open vol01 · vol`);
          }
          break;
        }
        case "theme": {
          const root = document.documentElement;
          const cur = root.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = arg.startsWith("l") ? "light" : arg.startsWith("d") ? "dark" : cur === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch {}
          print(`theme → <span class="c-accent">${next}</span>`);
          break;
        }
        case "box":
          print(
            `<span class="c-accent">` +
              `      ____________\n` +
              `     /\\           \\\n` +
              `    /  \\___________\\\n` +
              `    \\  /   OPEN    /\n` +
              `     \\/__________ /   nothing hidden.` +
              `</span>`,
          );
          break;
        case "clear":
          consoleEl.innerHTML = "";
          consoleEl.hidden = true;
          break;
        default:
          print(`unknown command: ${cmd} — type <span class="c-accent">help</span>`);
      }
      input.value = "";
      render("");
    }

    /* ---- key handling ---- */
    input.addEventListener("input", () => render(input.value));
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selected = Math.min(selected + 1, filtered.length - 1);
        paint();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selected = Math.max(selected - 1, 0);
        paint();
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (isCommand(input.value)) runCommand(input.value);
        else run(filtered[selected]);
      } else if (e.key === "Escape") {
        e.preventDefault();
        close();
      }
    });

    scrim?.addEventListener("click", close);

    // focus trap: keep Tab inside the panel
    panel.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;
      const focusables = panel.querySelectorAll<HTMLElement>(
        'input, [href], button, [tabindex]:not([tabindex="-1"])',
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // global open shortcut + triggers. Escape and Tab are handled here too so
    // the dialog contract holds even when focus has drifted to the body
    // (e.g. after clicking the console output).
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen() ? close() : open();
      } else if (e.key === "/" && !isOpen() && !/^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement)?.tagName)) {
        e.preventDefault();
        open();
      } else if (e.key === "Escape" && isOpen()) {
        e.preventDefault();
        close();
      } else if (e.key === "Tab" && isOpen() && !panel.contains(document.activeElement)) {
        e.preventDefault();
        input.focus();
      }
    });
    document.querySelectorAll("[data-palette-open]").forEach((b) =>
      b.addEventListener("click", open),
    );
  }

  if (document.readyState !== "loading") initPalette();
  else document.addEventListener("DOMContentLoaded", initPalette);
</script>
