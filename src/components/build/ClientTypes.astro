    <div class="dist" data-district style={toneVars}>
      <div class="dist__bar mono">
        <span>THE OPEN BOX — DISTRICT 01</span>
        <span class="dist__code" data-status>{span} SPACES · TAP ONE TO ENTER</span>
      </div>

      <div class="dist__stage" data-stage>
      {/* THE BUILDING — static isometric SVG, drawn at build time.
          NOT aria-hidden: it contains real focusable links, and hiding a
          container while leaving its links focusable is a keyboard trap
          (axe: aria-hidden-focus). Each block is named by its <title>, and
          the directory below is the same six spaces reached another way.
          Each block is a real <a> so it is focusable and keyboard-operable;
          the prototype used <g onClick> and was mouse-only. Without
          JavaScript the anchor still jumps to that space's row below. */}
      <div class="iso" data-city>
        <svg
          class="iso__svg"
          viewBox="-196 -118 510 360"
          role="group"
          aria-label="District map. The same six spaces are listed below."
        >
          {/* plinth */}
          <polygon points={sideFace(CAM, COL * 2 + UNIT.w + 0.5, -0.5, 0, ROW[1] + UNIT.d + 1, PLINTH)} class="iso-plinth-s" />
          <polygon points={frontFace(CAM, -0.5, ROW[1] + UNIT.d + 0.5, 0, COL * 2 + UNIT.w + 1, PLINTH)} class="iso-plinth-f" />
          <polygon points={topFace(CAM, -0.5, -0.5, PLINTH, COL * 2 + UNIT.w + 1, ROW[1] + UNIT.d + 1)} class="iso-plinth-t" />

          {
            drawOrder.map((b) => (
              <a href={`#space-${b.type.key}`} class="iso__block" data-iso={b.type.key}>
                <title>{b.type.name}</title>
                <polygon points={sideFace(CAM, b.x + UNIT.w, b.y, PLINTH, UNIT.d, b.h)} class="iso-side" />
                <polygon points={frontFace(CAM, b.x, b.y + UNIT.d, PLINTH, UNIT.w, b.h)} class="iso-front" />
                <polygon points={topFace(CAM, b.x, b.y, PLINTH + b.h, UNIT.w, UNIT.d)} class="iso-top" />

                {/* lit windows — brighter than the wall they sit in */}
                {[0.75, 1.75, 2.75].map((wz) =>
                  wz + 0.5 < b.h
                    ? [0.35, 1.3, 2.2].map((wx) => (
                        <polygon
                          points={frontFace(CAM, b.x + wx, b.y + UNIT.d, PLINTH + wz, 0.45, 0.4)}
                          class="iso-win"
                        />
                      ))
                    : null,
                )}

                {/* roof outline picks the block out of the skyline */}
                <polygon points={topFace(CAM, b.x, b.y, PLINTH + b.h, UNIT.w, UNIT.d)} class="iso-cap" />

                <text
                  x={iso(CAM, b.x + UNIT.w / 2 - UNIT.d / 4, b.y + UNIT.d / 4, PLINTH + b.h + 0.42)[0]}
                  y={iso(CAM, b.x + UNIT.w / 2 - UNIT.d / 4, b.y + UNIT.d / 4, PLINTH + b.h + 0.42)[1]}
                  class="iso-code"
                >
                  {b.type.key}
                </text>
              </a>
            ))
          }
        </svg>
      </div>

      <div class="dist__grid" data-grid>
        {
          clientTypes.map((c, i) => (
            <details class="dist__space" data-space id={`space-${c.key}`} style={`--i:${i}`}>
              <summary class="dist__block">
                <span class="dist__icon" aria-hidden="true" set:html={ICONS[c.key]} />
                <span class="dist__n mono">{c.key}</span>
                <span class="dist__name">{c.name}</span>
                <span class="visually-hidden">{c.line}</span>
              </summary>

              <div class="dist__panel">
                {/* THE INTERIOR — the same room the prototype drew, in tone
                    instead of neon. Decorative: role="img" names it, and the
                    zone list beneath is the actual information. */}
                <figure class="dist__roomwrap">
                  <svg
                    class="dist__room"
                    viewBox="-177 -164 388 358"
                    role="img"
                    aria-label={`Cutaway of a typical ${c.name.toLowerCase()} space.`}
                    set:html={ROOM_SVG[c.key] ?? ""}
                  />
                </figure>

                {/* the slip that sits under the room — name, what it is,
                    what the site contains, and the way back */}
                <div class="dist__info">
                  <div class="dist__infomain">
                    <p class="dist__infoname">{c.name}</p>
                    <p class="dist__line">{c.line}</p>
                  </div>
                  <ul class="dist__zonelist mono">
                    {c.sections.map((sec) => (
                      <li>{sec.label}</li>
                    ))}
                  </ul>
                  <button class="dist__back mono" type="button" data-back>
                    ◂ BACK
                  </button>
                </div>
              </div>
            </details>
          ))
        }
      </div>
      </div>
    </div>

    <p class="wt__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  /* ---- the plate: permanently inverted, like the inside of the hero box ---- */
  .dist {
    background: var(--interior);
    color: var(--interior-ink);
    border: var(--hair-strong) solid var(--interior-ink);
    border-radius: 3px;
    overflow: hidden;
  }
  .dist__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: var(--hair) solid var(--interior-line);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .dist__code {
    transition: opacity 0.15s var(--ease);
  }

  /* ---- the isometric building ----
     Faces are all currentColor at different opacities, so the whole scene
     inverts with the plate: no second palette, no per-block hue. */
  .iso {
    padding: clamp(0.5rem, 2vw, 1.2rem) clamp(0.5rem, 2vw, 1rem) 0;
  }
  .iso__svg {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    margin-inline: auto;
    color: var(--interior-ink);
    overflow: visible;
  }
  /* Faces must be OPAQUE. The prototype relied on the painter's algorithm —
     near blocks physically covering far ones — and semi-transparent fills
     defeat it: every roof shows through every other block and the skyline
     reads as sheets of glass. color-mix keeps them opaque while still
     resolving against the plate, so the scene inverts without a palette. */
  .iso-plinth-t { fill: color-mix(in oklab, var(--interior-ink) 9%, var(--interior)); }
  .iso-plinth-f { fill: color-mix(in oklab, var(--interior-ink) 14%, var(--interior)); }
  .iso-plinth-s { fill: color-mix(in oklab, var(--interior-ink) 6%, var(--interior)); }

  .iso__block { cursor: pointer; }
  /* Every face also carries a hairline edge. Tonal separation alone is not
     enough on a near-black ground — without the edges the roof reads as a
     bright plane floating clear of an invisible facade. */
  .iso-top,
  .iso-front,
  .iso-side {
    stroke: color-mix(in oklab, var(--interior-ink) 30%, var(--interior));
    stroke-width: 0.7;
    transition: fill 0.18s var(--ease), stroke 0.18s var(--ease);
  }
  .iso-top   { fill: color-mix(in oklab, var(--interior-ink) 34%, var(--interior)); }
  .iso-front { fill: color-mix(in oklab, var(--interior-ink) 20%, var(--interior)); }
  .iso-side  { fill: color-mix(in oklab, var(--interior-ink) 11%, var(--interior)); }
  .iso-win   { fill: color-mix(in oklab, var(--interior-ink) 50%, var(--interior)); transition: fill 0.18s var(--ease); }
  .iso-cap {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.42;
    stroke-width: 0.9;
    transition: stroke-opacity 0.18s var(--ease);
  }
  .iso-code {
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-anchor: middle;
    fill: currentColor;
    fill-opacity: 0.45;
    transition: fill-opacity 0.18s var(--ease);
  }

  .iso__block:hover .iso-top,
  .iso__block:hover .iso-front,
  .iso__block:hover .iso-side,
  .iso__block:focus-visible .iso-top,
  .iso__block:focus-visible .iso-front,
  .iso__block:focus-visible .iso-side,
  .iso__block.is-active .iso-top,
  .iso__block.is-active .iso-front,
  .iso__block.is-active .iso-side { stroke: var(--interior-ink); }
  .iso__block:hover .iso-top,
  .iso__block:focus-visible .iso-top,
  .iso__block.is-active .iso-top { fill: color-mix(in oklab, var(--interior-ink) 52%, var(--interior)); }
  .iso__block:hover .iso-front,
  .iso__block:focus-visible .iso-front,
  .iso__block.is-active .iso-front { fill: color-mix(in oklab, var(--interior-ink) 33%, var(--interior)); }
  .iso__block:hover .iso-side,
  .iso__block:focus-visible .iso-side,
  .iso__block.is-active .iso-side { fill: color-mix(in oklab, var(--interior-ink) 19%, var(--interior)); }
  .iso__block:hover .iso-win,
  .iso__block:focus-visible .iso-win,
  .iso__block.is-active .iso-win { fill: color-mix(in oklab, var(--interior-ink) 72%, var(--interior)); }
  .iso__block:hover .iso-cap,
  .iso__block:focus-visible .iso-cap { stroke-opacity: 1; }
  .iso__block:hover .iso-code,
  .iso__block:focus-visible .iso-code { fill-opacity: 1; }
  .iso__block:focus-visible { outline: none; }

  /* the block whose space is open stays lit — the building is a live map */
  .iso__block.is-active .iso-cap { stroke-opacity: 1; }
  .iso__block.is-active .iso-code { fill-opacity: 1; }

  /* ---- THE STAGE ----
     City and interior occupy the SAME box and cross-fade, so opening a space
     never changes the page height. All of this is scoped to html.js: without
     JavaScript the stage is not a stage, it is an ordinary disclosure list
     that flows down the page as normal. */
  .dist__grid {
    display: flex;
    flex-direction: column;
    border-top: var(--hair) solid var(--interior-line);
  }

  :global(html.js) .dist__stage {
    position: relative;
    height: clamp(25rem, 46vw, 34rem);
  }
  :global(html.js) .iso {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(0.5rem, 2vw, 1rem);
    transition:
      opacity 0.34s var(--ease),
      transform 0.34s var(--ease);
  }
  :global(html.js) .dist__grid {
    position: absolute;
    inset: 0;
    border-top: 0;
    /* This layer covers the city, so it must be click-through: only the open
       space takes pointer events back. Without this the whole building is
       unclickable — the container swallows every click. */
    pointer-events: none;
  }
  :global(html.js) .dist__space {
    position: absolute;
    inset: 0;
    border-bottom: 0;
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
    transition:
      opacity 0.34s var(--ease),
      transform 0.34s var(--ease);
  }
  :global(html.js) .dist__space[open] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* the building steps back as the room comes forward */
  :global(html.js) .dist__stage[data-open] .iso {
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
  }
  /* with JS the building blocks are the control, so the row is not needed —
     removed from layout AND from the tab order, not just hidden */
  :global(html.js) summary.dist__block {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .iso,
    :global(html.js) .dist__space {
      transition-duration: 0.01ms;
      transform: none;
    }
  }

  /* ---- the interior: room fills the stage, slip pinned beneath ---- */
  .dist__panel {
    display: flex;
    flex-direction: column;
    padding: clamp(0.6rem, 2vw, 1rem);
  }
  /* height:100% does NOT work here: <details> does not establish a definite
     containing block for its content, so the percentage silently resolves to
     auto and the panel grows to its natural height, pushing the slip out of
     the stage. Pinning it to the space gives it a real box. */
  :global(html.js) .dist__panel {
    position: absolute;
    inset: 0;
  }
  .dist__roomwrap {
    flex: 1;
    min-height: 0;
    margin: 0;
    display: grid;
    place-items: center;
  }
  .dist__room {
    display: block;
    /* A definite box, not auto: an SVG with height:auto resolves to its full
       intrinsic height and overruns the stage, taking the slip off-screen
       with it. Given a real box, preserveAspectRatio letterboxes it to fit. */
    width: 100%;
    height: 100%;
    color: var(--interior-ink);
  }

  .dist__info {
    flex: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: var(--hair) dashed var(--interior-line);
  }
  .dist__infoname {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.2rem;
  }
  .dist__line {
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.78;
    max-width: 52ch;
    margin: 0;
  }
  .dist__zonelist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dist__zonelist li {
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.32em 0.55em;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }
  .dist__back {
    justify-self: start;
    background: none;
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.45em 0.8em;
    cursor: pointer;
    color: inherit;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    transition: background 0.15s var(--ease);
  }
  .dist__back:hover,
  .dist__back:focus-visible {
    background: var(--interior-line);
  }

  @media (min-width: 720px) {
    .dist__info {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 1.2rem;
    }
  }

  /* Stacked, the room is height-bound and letterboxes into the middle third
     of the plate — 470px of drawing inside 1040px of stage, which is most of
     why a furnished room still read as empty. Wide enough, the slip moves
     into that dead margin and the room takes the full height of the stage. */
  @media (min-width: 1000px) {
    :global(html.js) .dist__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(15rem, 24vw, 20rem);
      /* stretch, not center: flex:1 on the wrap does nothing here, so the
         column has to carry the height or the SVG sizes to its intrinsic
         one and runs straight out of the stage. */
      align-items: stretch;
      gap: clamp(1rem, 2.4vw, 2rem);
    }
    :global(html.js) .dist__roomwrap {
      height: 100%;
      min-height: 0;
    }
    :global(html.js) .dist__info {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 0.9rem;
      padding-top: 0;
      border-top: 0;
      border-left: var(--hair) dashed var(--interior-line);
      padding-left: clamp(1rem, 2.4vw, 2rem);
      height: 100%;
    }
    :global(html.js) .dist__line {
      font-size: 0.86rem;
    }
  }

  .wt__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .wt__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .wt__note a:hover {
    color: var(--accent-text);
  }
</style>

<script>
  /* Enforce "one space open at a time" and drive the status line — the pure
     progressive-enhancement layer. The <details> elements work correctly
     with none of this: multiple can open at once, no dimming, no status
     text update. Nothing here is required for the content to be reachable. */
  function initDistrict() {
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const status = document.querySelector<HTMLElement>("[data-status]");
    if (!grid) return;
    const spaces = Array.from(grid.querySelectorAll<HTMLDetailsElement>(".dist__space"));
    const defaultStatus = status?.textContent ?? "";

    const isoBlocks = Array.from(document.querySelectorAll<SVGAElement>("[data-iso]"));

    const stage = document.querySelector<HTMLElement>("[data-stage]");

    const sync = () => {
      const open = spaces.find((d) => d.open);
      // the stage carries the state: it is what cross-fades the city out
      stage?.toggleAttribute("data-open", Boolean(open));
      grid.toggleAttribute("data-open", Boolean(open));
      // the building doubles as a live map: light the block that is open
      isoBlocks.forEach((a) =>
        a.classList.toggle("is-active", Boolean(open) && `space-${a.dataset.iso}` === open!.id),
      );
      if (status) {
        const name = open?.querySelector<HTMLElement>(".dist__name")?.textContent;
        status.textContent = name ? `INSIDE — ${name.toUpperCase()}` : defaultStatus;
      }
    };

    spaces.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) spaces.forEach((other) => other !== d && (other.open = false));
        sync();
      });
    });

    // Clicking a block opens its space instead of jumping the page. With no
    // JavaScript the anchor's default still lands on that row, which is
    // visible and readable whether or not it is expanded.
    isoBlocks.forEach((a) => {
      a.addEventListener("click", (e) => {
        const target = document.getElementById(`space-${a.dataset.iso}`) as HTMLDetailsElement | null;
        if (!target) return;
        e.preventDefault();
        target.open = true;
        // the summary is display:none under JS, so send focus to the way out
        target.querySelector<HTMLElement>("[data-back]")?.focus({ preventScroll: true });
      });
    });

    grid.addEventListener("click", (e) => {
      const back = (e.target as HTMLElement).closest("[data-back]");
      if (!back) return;
      e.preventDefault();
      const d = back.closest("details") as HTMLDetailsElement | null;
      if (d) {
        d.open = false;
        document.querySelector<SVGAElement>(`[data-iso="${d.id.replace("space-", "")}"]`)?.focus();
      }
    });
  }
  if (document.readyState !== "loading") initDistrict();
  else document.addEventListener("DOMContentLoaded", initDistrict);
</script>
