const ROOMS: Record<string, () => string> = {
  "01": clinicRoom,
  "02": cafeRoom,
  "03": salonRoom,
  "04": pharmacyRoom,
  "05": shopRoom,
  "06": startupRoom,
};

/* Built here, not in the template: TONES is only complete once every room has
   been drawn, and the plate needs the finished set. */
const ROOM_SVG: Record<string, string> = Object.fromEntries(
  clientTypes.map((c) => [c.key, ROOMS[c.key]?.() ?? ""]),
);
const toneVars = [...TONES]
  .sort((a, b) => a - b)
  .map((n) => `--t${n}:color-mix(in oklab,var(--interior-ink) ${n}%,var(--interior))`)
  .join(";");

const span = String(clientTypes.length).padStart(2, "0");
---

<section class="section" id="who" aria-labelledby="who-h" style={toneVars}>
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="Who it's for"
      sublabel="ORDER TYPES"
      kicker={`TYPES / 01–${span} · DRIVE THE STREET, OR PICK ONE BELOW`}
      id="who-h"
    />

    {/* The track is only tall when the street can actually run — the height
        is added inside the same query that turns the camera on, so the page
        never reserves scroll for a mechanism that will not start. */}
    <div class="st__track" data-track>
      <div class="st__frame" data-frame>
        <div class="st__bar mono">
          <span>THE OPEN BOX — DISTRICT 01</span>
          <span class="st__code" data-status>{span} SPACES · PICK ONE TO STEP INSIDE</span>
        </div>

        {/* Ends the drive; never skips the section. An exit that removes the
            answer is worse than the scroll it saves, so this lands on the
            last pair with the directory still in frame. */}
        <button class="st__skip mono" type="button" data-skip>
          END THE DRIVE <span aria-hidden="true">▸</span>
        </button>

        {/* THE STREET. Not aria-hidden: it holds real focusable links, and
            hiding a container while leaving its links focusable is a keyboard
            trap. The directory below is the same six spaces reached another
            way, and is what a screen reader is meant to use. */}
        <svg
          class="st__svg"
          data-svg
          viewBox={`${(-BAKE_VBW / 2).toFixed(0)} ${VB_TOP} ${BAKE_VBW} ${VBH}`}
          preserveAspectRatio="xMidYMid meet"
          role="group"
          aria-label="District street. The same six spaces are listed below."
        >
          {/* the ground: invariant under a pure-Z dolly, so it is drawn once
              and never enters the damage rect on an animated frame */}
          <g class="st-ground">
            <polygon points={`${(-BAKE_VBW / 2).toFixed(0)},${GROUND_Y.toFixed(0)} ${(BAKE_VBW / 2).toFixed(0)},${GROUND_Y.toFixed(0)} 0,0`} class="st-road" />
            <line x1={0} y1={0} x2={(-BAKE_VBW / 2).toFixed(0)} y2={GROUND_Y.toFixed(0)} class="st-kerb" />
            <line x1={0} y1={0} x2={(BAKE_VBW / 2).toFixed(0)} y2={GROUND_Y.toFixed(0)} class="st-kerb" />
            <line x1={(-BAKE_VBW / 2).toFixed(0)} y1={0} x2={(BAKE_VBW / 2).toFixed(0)} y2={0} class="st-horizon" />
            <circle cx={0} cy={0} r={2.5} class="st-vp" />
          </g>

          {/* recycled cross-rungs — receding rungs read as a technical
              drawing where a dashed centre line would read as a highway */}
          <g class="st-rungs" data-rungs>
            {bakedRungs.map((r) => (
              <g data-rung={r.i} style={`transform:${r.t}`}>
                <line x1={-ROAD_HALF} y1={0} x2={ROAD_HALF} y2={0} />
              </g>
            ))}
          </g>

          {/* far to near — the order is a build-time constant because
              same-side Z extents are disjoint and panX is 0 while driving */}
          {
            DRAW_ORDER.map((b) => {
              const named = "key" in b ? (b as any).key as string : null;
              const rec = named
                ? bakedNamed.find((n) => n.slot.key === named)!
                : bakedFill.find((n) => n.slot === b)!;
              const type = named ? clientTypes.find((c) => c.key === named) : null;
              const inner = (
                <>
                  {rec.flank && <polygon points={rec.flank} class="st-flank" />}
                  {rec.base && <polygon points={rec.base} class="st-base" />}
                  {rec.card && (
                    <g class="st-card" data-card style={`transform:${rec.card}`}
                       set:html={named ? facade(named, b.side, b.h) : fillerFacade(b.h, b.side)} />
                  )}
                </>
              );
              return named ? (
                <a
                  href={`#space-${named}`}
                  class="st-b"
                  data-b={named}
                  data-zf={b.zf}
                  data-side={b.side}
                  data-h={b.h}
                  style={`opacity:${rec.haze}`}
                >
                  <title>{type?.name}</title>
                  {inner}
                </a>
              ) : (
                <g class="st-b st-b--filler" data-fill data-zf={b.zf} data-side={b.side} data-h={b.h}
                   style={`opacity:${rec.haze}`} aria-hidden="true">
                  {inner}
                </g>
              );
            })
          }
        </svg>

        {/* THE STATIC PRESENTATION — no JavaScript, reduced motion, or a
            browser that cannot run the camera. Same <symbol>-free facade
            artwork, drawn flat, so nothing here is duplicated content and
            there is no perspective viewBox to mis-fit at any width. */}
        <ul class="st__strip">
          {
            SLOTS.map((sl) => {
              const type = clientTypes.find((c) => c.key === sl.key)!;
              return (
                <li>
                  <a href={`#space-${sl.key}`} class="st__elev">
                    <svg
                      viewBox={`${Math.min(0, NAMED_W * sl.side) - 0.4} -0.4 ${NAMED_W + 0.8} ${sl.h + 0.8}`}
                      role="img"
                      aria-label={`Shopfront elevation for ${type.name.toLowerCase()}.`}
                      set:html={facade(sl.key, sl.side, sl.h)}
                    />
                    <span class="st__elevname">{type.name}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        {/* The directory. These summaries are visible in EVERY mode — that is
            what makes a scroll-gated street defensible, because all six
            categories are reachable at scroll position zero. */}
        <div class="st__index" data-index>
          <div class="st__chips">
        {
          clientTypes.map((c, i) => (
            <details class="st__space" data-space id={`space-${c.key}`} style={`--i:${i}`}>
              <summary class="st__chip">
                <span class="dist__icon" aria-hidden="true" set:html={ICONS[c.key]} />
                <span class="dist__n mono">{c.key}</span>
                <span class="dist__name">{c.name}</span>
                <span class="visually-hidden">{c.line}</span>
              </summary>

              <div class="dist__panel">
                {/* THE INTERIOR — the same room the prototype drew, in tone
                    instead of neon. Decorative: role="img" names it, and the
                    zone list beneath is the actual information. */}
                <figure class="dist__roomwrap">
                  <svg
                    class="dist__room"
                    viewBox="-177 -164 388 358"
                    role="img"
                    aria-label={`Cutaway of a typical ${c.name.toLowerCase()} space.`}
                    set:html={ROOM_SVG[c.key] ?? ""}
                  />
                </figure>

                {/* the slip that sits under the room — name, what it is,
                    what the site contains, and the way back */}
                <div class="dist__info">
                  <div class="dist__infomain">
                    <p class="dist__infoname">{c.name}</p>
                    <p class="dist__line">{c.line}</p>
                  </div>
                  <ul class="dist__zonelist mono">
                    {c.sections.map((sec) => (
                      <li>{sec.label}</li>
                    ))}
                  </ul>
                  <button class="dist__back mono" type="button" data-back>
                    ◂ BACK
                  </button>
                </div>
              </div>
            </details>
          ))
        }
          </div>
        </div>
      </div>
    </div>

    <p class="wt__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  /* The band is self-framed by its own border, so it does not need a text
     section's breathing room above and below. Trimming it here buys back
     about 110px of the scroll the drive costs, without touching any other
     section's rhythm. */
  #who.section {
    padding-block: clamp(2rem, 4vw, 3.5rem);
    /* The district's palette is decided HERE and nowhere else. It must sit on
       the same element that carries the baked --tNN tone scale (the inline
       style attribute on this section), because those values are written in
       terms of --interior / --interior-ink and resolve where they are
       declared. Put this pair on a descendant instead and the tones quietly
       fall back to the global inverted pair — the rooms come back black. */
    --interior: var(--paper);
    --interior-ink: var(--ink);
    --interior-line: var(--line-2);
  }

  /* ---- the plate ----------------------------------------------------------
     Everything inside the district is written against --interior /
     --interior-ink, so which way round it runs is decided in ONE place. The
     pair is re-pointed at the page's own palette on the section, not on a
     wrapper: the frame needs to be sticky, and an overflow:hidden ANCESTOR
     captures a sticky descendant's scrollport and silently kills the pin.
     (Overflow on the sticky element itself is fine — only ancestors clip.) */
  /* The masthead is fixed, so every anchor target in this section needs to
     clear it or the jump lands under the bar. */
  #who,
  .st__space { scroll-margin-top: 70px; }

  .st__track {
    --band: clamp(25rem, 54svh, 34rem);
    /* svh, never vh or dvh: a collapsing mobile URL bar must not resize the
       pinned frame halfway through the drive. */
    --run: clamp(520px, 86svh, 860px);
    position: relative;
  }
  @media (max-width: 760px), (pointer: coarse) {
    .st__track { --run: 50svh; }
  }

  .st__frame {
    position: relative;
    background: var(--interior);
    color: var(--interior-ink);
    border: var(--hair-strong) solid var(--interior-ink);
    border-radius: 3px;
    overflow: clip;
    min-height: var(--band);
    display: flex;
    flex-direction: column;
  }
  .st__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: var(--hair) solid var(--interior-line);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
    flex: none;
  }
  .st__code { transition: opacity 0.15s var(--ease); }

  /* ---- the street ---------------------------------------------------------
     Hidden by default. It is switched ON below, inside the same query that
     gives the track its height, so a browser that cannot run the camera never
     reserves scroll for it. */
  .st__svg { display: none; }
  .st__skip { display: none; }

  .st-road { fill: color-mix(in oklab, var(--interior-ink) 4%, var(--interior)); }
  .st-kerb { stroke: color-mix(in oklab, var(--interior-ink) 34%, var(--interior)); stroke-width: 1.1; }
  .st-horizon { stroke: color-mix(in oklab, var(--interior-ink) 18%, var(--interior)); stroke-width: 0.7; }
  .st-vp { fill: color-mix(in oklab, var(--interior-ink) 30%, var(--interior)); }
  .st-rungs line { stroke: color-mix(in oklab, var(--interior-ink) 22%, var(--interior)); stroke-width: 0.07; }
  .st-rungs g { will-change: transform; }

  /* Faces carry tone; the card carries the line art. Strokes are NOT
     non-scaling: letting them thin with distance is the depth cue, and it is
     the one thing a CSS-3D plane could not have done. */
  .st-flank { fill: color-mix(in oklab, var(--interior-ink) 17%, var(--interior)); }
  .st-base  { fill: color-mix(in oklab, var(--interior-ink) 30%, var(--interior)); }
  .st-flank, .st-base {
    stroke: color-mix(in oklab, var(--interior-ink) 46%, var(--interior));
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .st-card {
    fill: none;
    stroke: color-mix(in oklab, var(--interior-ink) 62%, var(--interior));
    will-change: transform;
  }
  .st-card text { fill: var(--interior-ink); stroke: none; }
  /* the opaque front of the building — and the click target */
  .st-card :global(.st-face) {
    fill: color-mix(in oklab, var(--interior-ink) 3%, var(--interior));
  }

  .st-b { cursor: pointer; }
  .st-b--filler { pointer-events: none; }
  .st-b:hover .st-card,
  .st-b:focus-visible .st-card { stroke: var(--interior-ink); }
  .st-b:hover .st-flank,
  .st-b:focus-visible .st-flank { fill: color-mix(in oklab, var(--interior-ink) 26%, var(--interior)); }
  .st-b.is-active .st-card { stroke: var(--interior-ink); }

  .st__skip {
    position: absolute;
    right: 0.7rem;
    top: 2.4rem;
    z-index: 4;
    background: var(--interior);
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    color: inherit;
    cursor: pointer;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    padding: 0.42em 0.7em;
    transition: background 0.15s var(--ease);
  }
  .st__skip:hover,
  .st__skip:focus-visible { background: var(--interior-line); }

  /* ---- the static presentation -------------------------------------------
     What ships with no JavaScript, under reduced motion, and anywhere the
     camera cannot run. The same facade artwork, drawn flat — so it is not
     duplicated content, and there is no perspective viewBox to mis-fit at
     any width. */
  .st__strip {
    list-style: none;
    margin: 0;
    padding: clamp(0.7rem, 2vw, 1.1rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.6rem, 1.6vw, 1rem);
  }
  @media (min-width: 560px) { .st__strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .st__strip { grid-template-columns: repeat(3, 1fr); } }
  .st__elev {
    display: grid;
    gap: 0.4rem;
    padding: 0.6rem;
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    color: inherit;
    text-decoration: none;
  }
  .st__elev:hover { background: color-mix(in oklab, var(--interior-ink) 5%, var(--interior)); }
  .st__elev svg {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: color-mix(in oklab, var(--interior-ink) 60%, var(--interior));
  }
  .st__elev svg text { fill: var(--interior-ink); stroke: none; }
  .st__elevname { font-size: 0.86rem; font-weight: 600; letter-spacing: -0.01em; }

  /* ---- the directory ------------------------------------------------------
     These summaries are visible in EVERY mode. They used to be display:none
     whenever JavaScript ran, which dropped six real sentences out of the
     accessibility tree; never re-add that rule. The strip is also what makes
     a scroll-gated street defensible, because every category is reachable at
     scroll position zero. */
  .st__index { margin-top: auto; }
  .st__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    width: 100%;
    padding: clamp(0.6rem, 2vw, 0.9rem);
    border-top: var(--hair) solid var(--interior-line);
  }
  .st__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    list-style: none;
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.4em 0.62em;
    font-size: 0.76rem;
    line-height: 1.1;
    transition: background 0.15s var(--ease);
  }
  /* On a phone the six chips wrapped to five rows and took nearly half the
     frame. The names stay — they are the whole accessibility argument — but
     the mark goes and the type tightens, which fits them in two. */
  @media (max-width: 620px) {
    .st__chips { gap: 0.3rem; padding: 0.5rem 0.55rem; }
    .st__chip {
      gap: 0.3rem;
      padding: 0.34em 0.46em;
      font-size: 0.66rem;
    }
    .st__chip .dist__icon { display: none; }
  }
  .st__chip::-webkit-details-marker { display: none; }
  .st__chip:hover { background: color-mix(in oklab, var(--interior-ink) 7%, var(--interior)); }
  .st__space[open] > .st__chip { background: var(--interior-ink); color: var(--interior); }
  .dist__icon { display: block; width: 1.05em; height: 1.05em; flex: none; }
  .dist__icon :global(svg) { display: block; width: 100%; height: 100%; }
  .dist__n { font-size: 0.62em; letter-spacing: 0.12em; opacity: 0.7; }
  .dist__name { font-weight: 600; letter-spacing: -0.01em; }

  /* ---- the drive ----------------------------------------------------------
     Positive gating: the tall track, the pin and the camera all appear here
     together, so they can never disagree about whether the street is running.
     Anything that reserves layout for motion belongs inside this query. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .st__track { height: calc(var(--band) + var(--run)); }
    :global(html.js) .st__frame {
      position: sticky;
      /* the masthead is 54px; one grid unit clears it. The camera reads the
         same offset from JS, so pin and drive stay in phase. */
      top: 62px;
      height: var(--band);
      min-height: 0;
    }
    :global(html.js) .st__svg { display: block; flex: 1; min-height: 0; width: 100%; }
    :global(html.js) .st__skip { display: inline-flex; }
    :global(html.js) .st__strip { display: none; }

    /* The directory floats over the street rather than stacking under it, so
       the frame height stays exactly today's stage envelope.

       This layer is inset:0 and the visual bar is the child, NOT the other way
       round. An absolutely-positioned bottom bar becomes the containing block
       for everything inside it, and the open interior then resolves inset:0
       against a 50px chip strip instead of the frame — it renders, it is just
       squashed into the bar and unclickable. */
    :global(html.js) .st__index {
      position: absolute;
      inset: 0;
      margin: 0;
      display: flex;
      align-items: flex-end;
      pointer-events: none;
    }
    /* No backdrop-filter, and no position either. Both make an element a
       containing block for absolutely-positioned DESCENDANTS, which puts the
       open interior back inside the chip bar — the same squashed-panel bug as
       anchoring this layer with bottom:0, arriving by a different route. A
       near-opaque plate does the legibility job without that side effect. */
    :global(html.js) .st__chips {
      pointer-events: auto;
      background: color-mix(in oklab, var(--interior) 94%, transparent);
    }
    :global(html.js) .st__space { position: static; }
    /* Panels resolve against .st__index, which IS the frame. */
    :global(html.js) .st__space > .dist__panel {
      position: absolute;
      inset: 0;
      z-index: 3;
      background: var(--interior);
      opacity: 0;
      transform: scale(1.02);
      pointer-events: none;
      transition: opacity 0.34s var(--ease), transform 0.34s var(--ease);
    }
    :global(html.js) .st__space[open] > .dist__panel {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    :global(html.js) .st__frame[data-open] .st__svg,
    :global(html.js) .st__frame[data-open] .st__skip { opacity: 0; }
    :global(html.js) .st__svg { transition: opacity 0.34s var(--ease); }
  }

  /* ---- the interior: room fills the stage, slip pinned beneath ---- */
  .dist__panel {
    display: flex;
    flex-direction: column;
    padding: clamp(0.6rem, 2vw, 1rem);
  }
  /* height:100% does NOT work here: <details> does not establish a definite
     containing block for its content, so the percentage silently resolves to
     auto and the panel grows to its natural height, pushing the slip out of
     the stage. Pinning it to the space gives it a real box. */
  :global(html.js) .dist__panel {
    position: absolute;
    inset: 0;
  }
  .dist__roomwrap {
    flex: 1;
    min-height: 0;
    margin: 0;
    display: grid;
    place-items: center;
  }
  .dist__room {
    display: block;
    /* A definite box, not auto: an SVG with height:auto resolves to its full
       intrinsic height and overruns the stage, taking the slip off-screen
       with it. Given a real box, preserveAspectRatio letterboxes it to fit. */
    width: 100%;
    height: 100%;
    color: var(--interior-ink);
  }

  .dist__info {
    flex: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: var(--hair) dashed var(--interior-line);
  }
  .dist__infoname {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.2rem;
  }
  .dist__line {
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.78;
    max-width: 52ch;
    margin: 0;
  }
  .dist__zonelist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dist__zonelist li {
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.32em 0.55em;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }
  .dist__back {
    justify-self: start;
    background: none;
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.45em 0.8em;
    cursor: pointer;
    color: inherit;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    transition: background 0.15s var(--ease);
  }
  .dist__back:hover,
  .dist__back:focus-visible {
    background: var(--interior-line);
  }

  @media (min-width: 720px) {
    .dist__info {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 1.2rem;
    }
  }

  /* Stacked, the room is height-bound and letterboxes into the middle third
     of the plate — 470px of drawing inside 1040px of stage, which is most of
     why a furnished room still read as empty. Wide enough, the slip moves
     into that dead margin and the room takes the full height of the stage. */
  @media (min-width: 1000px) {
    :global(html.js) .dist__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(15rem, 24vw, 20rem);
      /* stretch, not center: flex:1 on the wrap does nothing here, so the
         column has to carry the height or the SVG sizes to its intrinsic
         one and runs straight out of the stage. */
      align-items: stretch;
      gap: clamp(1rem, 2.4vw, 2rem);
    }
    :global(html.js) .dist__roomwrap {
      height: 100%;
      min-height: 0;
    }
    :global(html.js) .dist__info {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 0.9rem;
      padding-top: 0;
      border-top: 0;
      border-left: var(--hair) dashed var(--interior-line);
      padding-left: clamp(1rem, 2.4vw, 2rem);
      height: 100%;
    }
    :global(html.js) .dist__line {
      font-size: 0.86rem;
    }
  }

  .wt__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .wt__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .wt__note a:hover {
    color: var(--accent-text);
  }
</style>

<script>
  import {
    NEAR, VBH, VB_TOP, KERB, NAMED_W, FILLER_W, ribsOf, ribPoints,
    cardTransform, czOf, hazeOf, solveF, vbwOf, sAt, sy, widthOf, MIN_TAP, ease,
  } from "../../lib/street.ts";

  /* The <details> layer works with none of this: every category is a visible
     chip, opens natively, and reaches its interior. The camera is added on
     top and is bound only when it can actually run. */
  function initDistrict() {
    const section = document.getElementById("who");
    if (!section) return;
    /* Scoped to the section on purpose: four other components use the
       [data-status] hook, and a document-wide query resolves correctly today
       only by accident of document order. */
    const status = section.querySelector<HTMLElement>("[data-status]");
    const spaces = Array.from(section.querySelectorAll<HTMLDetailsElement>(".st__space"));
    const frame = section.querySelector<HTMLElement>("[data-frame]");
    const defaultStatus = status?.textContent ?? "";
    if (!spaces.length || !frame) return;

    const nameOf = (d: HTMLDetailsElement) =>
      d.querySelector<HTMLElement>(".dist__name")?.textContent ?? "";

    const sync = () => {
      const open = spaces.find((d) => d.open);
      frame.toggleAttribute("data-open", Boolean(open));
      if (status) {
        status.textContent = open ? `INSIDE — ${nameOf(open).toUpperCase()}` : defaultStatus;
      }
      return open;
    };

    spaces.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) spaces.forEach((o) => o !== d && (o.open = false));
        sync();
      });
    });

    /* ---- the camera ------------------------------------------------------
       Everything below is enhancement. Reduced motion gets the static street
       and the same six chips, and binds no listener at all. */
    const svg = section.querySelector<SVGSVGElement>("[data-svg]");
    const track = section.querySelector<HTMLElement>("[data-track]");
    const skip = section.querySelector<HTMLButtonElement>("[data-skip]");
    if (!svg || !track) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const PIN_TOP = 62;
    const RUNG_SP = 26 / 16;

    type Solid = {
      el: SVGGraphicsElement;
      key: string | null;
      side: -1 | 1;
      zf: number;
      zb: number;
      h: number;
      ribs: ReturnType<typeof ribsOf>;
      poly: Record<string, SVGPolygonElement | null>;
      card: SVGGElement | null;
      shown: boolean;
      live: boolean;
    };

    const read = (el: Element): Solid => {
      const side = Number((el as HTMLElement).dataset.side) as -1 | 1;
      const zf = Number((el as HTMLElement).dataset.zf);
      const h = Number((el as HTMLElement).dataset.h);
      const key = (el as HTMLElement).dataset.b ?? null;
      const w = key ? NAMED_W : FILLER_W;
      const zb = zf + (key ? 14 : 8);
      return {
        el: el as SVGGraphicsElement,
        key, side, zf, zb, h,
        ribs: ribsOf({ side, zf, zb, h }, w),
        poly: {
          flank: el.querySelector(".st-flank"),
          base: el.querySelector(".st-base"),
        },
        card: el.querySelector(".st-card"),
        shown: true,
        live: true,
      };
    };

    const solids = Array.from(svg.querySelectorAll("[data-b],[data-fill]")).map(read);
    const named = solids.filter((s) => s.key);
    const rungs = Array.from(svg.querySelectorAll<SVGGElement>("[data-rung]"));

    /* Facade anchors are focusable by default so the no-JS path can use them.
       Under JS the chips are the keyboard control, and two tab stops per
       category is noise — but the href stays, always. */
    named.forEach((s) => s.el.setAttribute("tabindex", "-1"));

    let F = 442;
    let vbw = 1717;
    let frameW = 0;
    const measure = () => {
      const fr = frame.getBoundingClientRect();
      const sr = svg.getBoundingClientRect();
      frameW = fr.width || 1;
      vbw = vbwOf(frameW, sr.height || fr.height || 1);
      F = solveF(vbw);
      svg.setAttribute("viewBox", `${(-vbw / 2).toFixed(0)} ${VB_TOP} ${vbw} ${VBH}`);
    };

    const cam = { cz: czOf(0), panX: 0, zoom: 0, target: null as Solid | null };
    let quality = 0; // 0 full, 1 fewer solids, 2 half rate

    const setPts = (el: SVGPolygonElement | null, pts: string | null) => {
      if (!el) return;
      if (pts === null) { el.style.visibility = "hidden"; return; }
      el.style.visibility = "";
      el.setAttribute("points", pts);
    };

    const draw = () => {
      const { cz, panX, zoom, target } = cam;
      for (const s of solids) {
        const d = s.zf - cz;
        let o = hazeOf(d);
        if (zoom > 0) {
          /* Everything that is not the target dissolves into the paper first.
             Once it is gone the static draw order stops mattering, which is
             what lets panX leave the road without near geometry cutting
             across the building being entered. */
          o = s === target ? 1 : o * Math.max(0, 1 - zoom / 0.18);
        }
        if (!s.key && quality >= 1) o = 0;
        if (o <= 0.02 || d < NEAR) {
          if (s.shown) {
            /* visibility, never opacity:0 — a focusable but invisible link is
               the worst failure available here. */
            s.el.style.visibility = "hidden";
            s.shown = false;
          }
          continue;
        }
        if (!s.shown) { s.el.style.visibility = "visible"; s.shown = true; }
        s.el.style.opacity = o.toFixed(3);

        const R = s.ribs;
        const rib = (k: "flank" | "base") => {
          const a = R[k];
          setPts(s.poly[k], ribPoints(a[0], a[1], a[2], a[3], a[4], a[5], cz, panX, F));
        };
        rib("flank"); rib("base");

        /* going through the door: the shell of the target falls away so the
           opening is what fills the frame */
        if (zoom > 0 && s === target) {
          const shell = Math.max(0, 1 - zoom / 0.5).toFixed(3);
          for (const k of ["flank", "base"]) {
            if (s.poly[k]) (s.poly[k] as SVGPolygonElement).style.opacity = shell;
          }
        } else if (zoom === 0) {
          for (const k of ["flank", "base"]) {
            if (s.poly[k]) (s.poly[k] as SVGPolygonElement).style.opacity = "";
          }
        }

        const t = cardTransform(KERB * s.side, s.h, s.zf, cz, panX, F);
        if (t && s.card) s.card.style.transform = t;

        if (s.key) {
          /* A target under 44px is not a tap target and must not swallow
             taps meant for the road. The href is never removed. */
          const live = zoom === 0 && widthOf(d, F, frameW, vbw) >= MIN_TAP;
          if (live !== s.live) {
            s.el.style.pointerEvents = live ? "auto" : "none";
            s.live = live;
          }
        }
      }

      const n = quality >= 1 ? 8 : rungs.length;
      const z0 = Math.floor((cz + 2) / RUNG_SP) * RUNG_SP;
      for (let i = 0; i < rungs.length; i++) {
        if (i >= n) { rungs[i].style.visibility = "hidden"; continue; }
        rungs[i].style.visibility = "";
        const z = z0 + (i + 1) * RUNG_SP * (quality >= 1 ? 2 : 1);
        const s = sAt(z, cz, F);
        rungs[i].style.transform = `translate(0px,${sy(s, 0).toFixed(1)}px) scale(${s.toFixed(4)})`;
        rungs[i].style.opacity = hazeOf(z - cz).toFixed(3);
      }
      frame.dataset.cz = cam.cz.toFixed(2);
    };

    const pOf = () => {
      const span = track.offsetHeight - frame.offsetHeight;
      if (span <= 0) return 0;
      const top = track.getBoundingClientRect().top + window.scrollY;
      const v = (window.scrollY - (top - PIN_TOP)) / span;
      return v < 0 ? 0 : v > 1 ? 1 : v;
    };

    /* ---- frame pump ------------------------------------------------------ */
    let raf = 0;
    let lastP = -1;
    let parity = 0;
    const times: number[] = [];
    let mark = 0;

    const budget = (now: number) => {
      if (mark) {
        times.push(now - mark);
        if (times.length > 45) {
          times.sort((a, b) => a - b);
          const med = times[22];
          times.length = 0;
          if (med > 20 && quality < 2) quality += 1;
          else if (med < 12 && quality > 0) quality -= 1;
        }
      }
      mark = now;
    };

    const pump = (now: number) => {
      raf = 0;
      budget(now);
      if (quality >= 2 && (parity ^= 1)) { schedule(); return; }
      if (cam.zoom === 0) {
        const p = pOf();
        if (p !== lastP) { lastP = p; cam.cz = czOf(p); draw(); }
      }
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(pump); };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", () => { measure(); lastP = -1; schedule(); }, { passive: true });

    /* ---- the door -------------------------------------------------------- */
    let anim = 0;
    const tween = (ms: number, step: (t: number) => void, done?: () => void) => {
      cancelAnimationFrame(anim);
      const t0 = performance.now();
      const run = (n: number) => {
        const t = Math.min(1, (n - t0) / ms);
        step(ease(t));
        if (t < 1) anim = requestAnimationFrame(run);
        else done?.();
      };
      anim = requestAnimationFrame(run);
    };

    const enter = (s: Solid) => {
      if (!s.key) return;
      const d = spaces.find((x) => x.id === `space-${s.key}`);
      if (!d) return;
      const cz0 = cam.cz, F0 = F, px0 = cam.panX;
      const czE = s.zf - 3.2;
      const pxE = Math.max(-6, Math.min(6, 5.4 * s.side));
      cam.target = s;
      let opened = false;
      tween(620, (t) => {
        cam.zoom = t;
        cam.cz = cz0 + (czE - cz0) * t;
        cam.panX = px0 + (pxE - px0) * t;
        F = F0 + (1240 - F0) * t;
        draw();
        if (!opened && t >= 0.55) {
          opened = true;
          d.open = true;
          d.querySelector<HTMLElement>("[data-back]")?.focus({ preventScroll: true });
        }
      }, () => {
        svg.style.visibility = "hidden";
      });
    };

    const leave = (d: HTMLDetailsElement) => {
      svg.style.visibility = "";
      const cz0 = cam.cz, F0 = F, px0 = cam.panX, z0 = cam.zoom;
      let closed = false;
      tween(520, (t) => {
        const k = 1 - t;
        cam.zoom = z0 * k;
        /* the live scroll position is the target, so if the page moved while
           the room was open the camera lands where the scroll now says */
        const czNow = czOf(pOf());
        cam.cz = czNow + (cz0 - czNow) * k;
        cam.panX = px0 * k;
        F = solveF(vbw) + (F0 - solveF(vbw)) * k;
        if (!closed && k < 0.5) { closed = true; d.open = false; }
        draw();
      }, () => {
        cam.zoom = 0;
        cam.target = null;
        F = solveF(vbw);
        lastP = -1;
        schedule();
      });
    };

    svg.addEventListener("click", (e) => {
      const a = (e.target as Element).closest<SVGGraphicsElement>("[data-b]");
      if (!a) return;
      e.preventDefault();
      const s = named.find((x) => x.el === a);
      if (s) enter(s);
    });

    section.addEventListener("click", (e) => {
      const back = (e.target as HTMLElement).closest("[data-back]");
      if (!back) return;
      e.preventDefault();
      const d = back.closest("details") as HTMLDetailsElement | null;
      if (!d) return;
      leave(d);
      /* back to that category's own chip — never a facade, which may be
         hidden or already passed */
      d.querySelector<HTMLElement>("summary")?.focus({ preventScroll: true });
    });

    skip?.addEventListener("click", () => {
      const top = track.getBoundingClientRect().top + window.scrollY;
      const span = track.offsetHeight - frame.offsetHeight;
      scrollTo({ top: top - PIN_TOP + span, behavior: "smooth" });
    });

    measure();
    lastP = -1;
    schedule();
  }
  if (document.readyState !== "loading") initDistrict();
  else document.addEventListener("DOMContentLoaded", initDistrict);
</script>
