---
/* =============================================================================
   01 / WHO IT'S FOR

   Six business types — but the card is not the point. Each one carries a
   hairline page-skeleton: the sections a site for that business actually
   needs. An owner sees the shape of their own site before they ever write in,
   and it says "I already know what your site has to do" without a paragraph
   claiming it.

   The skeleton assembles on hover/focus (and on first scroll into view for
   touch, where there is no hover). Static and fully readable without motion.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { clientTypes } from "../../data/services.ts";
---

<section class="section" id="who" aria-labelledby="who-h">
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="Who it's for"
      sublabel="ORDER TYPES"
      kicker={`TYPES / 01–0${clientTypes.length} · WHAT YOUR SITE WOULD CONTAIN`}
      id="who-h"
    />

    <ul class="ct">
      {
        clientTypes.map((c, i) => (
          <li class="ct__card" data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`} tabindex="0">
            <div class="ct__head">
              <span class="ct__n mono">{c.key}</span>
              <h3 class="ct__name">{c.name}</h3>
            </div>

            <p class="ct__line">{c.line}</p>

            {/* the page skeleton — what a site for this business contains */}
            <div class="ct__skel" aria-hidden="true">
              <span class="ct__skel-label mono">TYPICAL BUILD</span>
              <ul class="ct__bars">
                {c.sections.map((s, j) => (
                  <li class="ct__bar" style={`--w:${s.w}%; --j:${j}`}>
                    <span class="ct__barfill"></span>
                    <span class="ct__barlabel mono">{s.label}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* the same information, linearised, for assistive tech */}
            <p class="visually-hidden">
              A typical build for this includes: {c.sections.map((s) => s.label.toLowerCase()).join(", ")}.
            </p>
          </li>
        ))
      }
    </ul>

    <p class="ct__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  .ct {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border: var(--hair) solid var(--line);
  }
  .ct__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.1rem, 2.4vw, 1.5rem);
    background: var(--paper);
    transition: background 0.2s var(--ease);
    outline-offset: -2px;
  }
  .ct__card:hover,
  .ct__card:focus-visible {
    background: var(--field);
  }
  .ct__head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .ct__n {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent-text);
    flex: none;
  }
  .ct__name {
    font-size: clamp(1.02rem, 0.9rem + 0.5vw, 1.24rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .ct__line {
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.5;
    flex: 1;
  }

  /* ---- the page skeleton ---- */
  .ct__skel {
    border-top: var(--hair) dashed var(--line-2);
    padding-top: 0.75rem;
  }
  .ct__skel-label {
    display: block;
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    color: var(--label-aa);
    margin-bottom: 0.5rem;
  }
  .ct__bars {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }
  .ct__bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 15px;
  }
  .ct__barfill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border: var(--hair) solid var(--line-2);
    background: var(--shade);
    border-radius: 1px;
    transform-origin: 0 50%;
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.3s var(--ease),
      background 0.3s var(--ease);
  }
  .ct__barlabel {
    position: relative;
    z-index: 1;
    font-size: 0.46rem;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    padding-left: 0.45rem;
    white-space: nowrap;
    transition: color 0.3s var(--ease);
  }
  /* assemble: bars draw out from the left, in order */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ct__barfill {
      transform: scaleX(0.14);
    }
    :global(html.js) .ct__card.is-in .ct__barfill,
    :global(html.js) .ct__card:hover .ct__barfill,
    :global(html.js) .ct__card:focus-visible .ct__barfill {
      transform: scaleX(1);
      transition-delay: calc(var(--j) * 0.055s);
    }
  }
  .ct__card:hover .ct__barfill,
  .ct__card:focus-visible .ct__barfill {
    border-color: var(--accent-text);
    background: color-mix(in oklab, var(--accent) 8%, var(--field));
  }
  .ct__card:hover .ct__barlabel,
  .ct__card:focus-visible .ct__barlabel {
    color: var(--ink);
  }

  .ct__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .ct__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .ct__note a:hover {
    color: var(--accent-text);
  }

  @media (min-width: 640px) {
    .ct {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .ct {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  // On touch there is no hover, so the skeletons assemble as each card
  // arrives instead. One observer, unobserved after firing.
  function initClientTypes() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cards = document.querySelectorAll<HTMLElement>(".ct__card");
    if (!cards.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.35 },
    );
    cards.forEach((c) => io.observe(c));
  }
  if (document.readyState !== "loading") initClientTypes();
  else document.addEventListener("DOMContentLoaded", initClientTypes);
</script>
