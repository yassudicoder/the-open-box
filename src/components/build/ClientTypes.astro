        blk(4.9, 2.5, 0, 0.85, 0.1, 0.05, 24, 16, 11),
        blk(4.92, 2.32, 0, 0.08, 0.08, 1.55, 32, 24, 17, false),
        blk(5.65, 2.32, 0, 0.08, 0.08, 1.55, 32, 24, 17, false),
        ...[0, 1, 2, 3].map((k) => blk(5.04 + k * 0.16, 2.28, 0.62, 0.12, 0.16, 0.9, 28 + k * 5, 20, 13)),
        blk(4.9, 2.3, 1.55, 0.9, 0.12, 0.07, 42, 30, 19),
      ])),

    /* the near band: counter, bench, basket stack */
    on(blk(0.4, 3.95, 0, 2.0, 0.8, 0.85),
       blk(0.65, 4.1, 0.85, 0.6, 0.45, 0.38, 46, 34, 24).s,
       pg(frontFace(RM, 0.4, 4.75, 0.55, 2.0, 0.05), T(28))),
    on(blk(3.0, 4.3, 0, 1.4, 0.6, 0.42, 30, 20, 13),
       pg(frontFace(RM, 3.0, 4.9, 0.42, 1.4, 0.5), T(24))),
    I({ x: 4.9, y: 3.9, z: 0, w: 0.6, d: 0.55, h: 0.78 },
      [0, 1, 2].map((k) => blk(4.9 + k * 0.02, 3.9 + k * 0.02, k * 0.26, 0.6, 0.55, 0.26, 24 + k * 8, 18, 12).s).join("")),

    down(2.0, 1.5),
    down(4.6, 1.9),
    down(2.6, 4.0),
  ], "shop");

const startupRoom = () =>
  shell() +
  paint([
    on(wallY(1.1, 1.4, 3.6, 1.9, T(5), ` stroke="${T(34)}" stroke-width="1"`),
       [0, 1, 2, 3].map((i) => panY(1.4, 2.85 - i * 0.34, 2.7 - i * 0.28, 0.07, T(26))).join("")),
    clockY(5.4, 2.7),
    on(wallX(0.6, 1.95, 1.4, 1.15, T(16), ` stroke="${T(36)}" stroke-width="0.8"`),
       [0, 1, 2, 3].map((k) =>
         panX(0.72 + (k % 2) * 0.62, 2.13 + Math.floor(k / 2) * 0.5, 0.46, 0.36, T(26 + k * 5))).join("")),

    /* three desks along the y = 0 wall, chairs pulled out toward the viewer */
    ...([0.5, 2.4, 4.3] as number[]).flatMap((sx) => [
      on(table(sx, 0.35, 1.35, 0.85, 0.7),
         blk(sx + 0.25, 0.45, 0.7, 0.5, 0.3, 0.04, 26, 18, 12).s,
         blk(sx + 0.95, 0.45, 0.7, 0.26, 0.26, 0.2, 36, 25, 17).s,
         pg(frontFace(RM, sx + 0.35, 1.2, 0.7, 0.62, 0.46), T(8)),
         pg(frontFace(RM, sx + 0.4, 1.2, 0.74, 0.52, 0.37), T(32)),
         blk(sx + 0.42, 1.14, 0.7, 0.5, 0.06, 0.03, 34, 24, 16).s),
      seat(sx + 0.35, 1.55, 0.64, 0.6, 0.7),
      pend(sx + 0.67, 0.8, 1.1),
    ]),

    /* lounge corner on the mat */
    mat(0.2, 2.5, 2.7, 2.1),
    I({ x: 0.3, y: 3.5, z: 0, w: 2.1, d: 0.9, h: 1.05 },
      paint([
        blk(0.3, 3.5, 0, 2.1, 0.16, 1.05, 22, 15, 10),
        blk(0.3, 3.66, 0, 0.28, 0.74, 0.62, 26, 17, 11),
        blk(2.12, 3.66, 0, 0.28, 0.74, 0.62, 26, 17, 11),
        blk(0.58, 3.66, 0, 1.54, 0.74, 0.44, 32, 22, 14),
        blk(0.6, 3.7, 0.44, 0.48, 0.66, 0.06, 38, 26, 18),
        blk(1.1, 3.7, 0.44, 0.48, 0.66, 0.06, 38, 26, 18),
        blk(1.6, 3.7, 0.44, 0.48, 0.66, 0.06, 38, 26, 18),
      ])),
    on(table(0.85, 2.7, 1.0, 0.65, 0.42),
       blk(1.0, 2.8, 0.42, 0.28, 0.28, 0.12, 44, 32, 22).s,
       blk(1.42, 2.84, 0.42, 0.3, 0.24, 0.05, 38, 26, 18).s),

    /* deep right and the near band */
    on(blk(0.1, 1.3, 0, 0.7, 1.25, 1.75),
       [0.55, 1.15].map((z) => pg(frontFace(RM, 0.1, 2.55, z, 0.7, 0.06), T(34))).join(""),
       [0.63, 1.23].map((z) =>
         [0, 1, 2].map((k) => pg(frontFace(RM, 0.18 + k * 0.19, 2.55, z, 0.14, 0.26), T(38 + k * 8))).join("")).join("")),
    on(blk(5.15, 3.0, 0, 0.75, 1.5, 0.8, 28, 19, 12),
       pg(frontFace(RM, 5.15, 4.5, 0.4, 0.75, 0.05), T(34)),
       blk(5.25, 3.15, 0.8, 0.5, 0.42, 0.1, 40, 28, 19).s,
       blk(5.28, 3.7, 0.8, 0.3, 0.3, 0.34, 34, 23, 15).s),
    on(blk(2.6, 4.2, 0, 0.45, 0.45, 1.2, 24, 16, 11),
       pg(frontFace(RM, 2.63, 4.65, 0.55, 0.39, 0.5), T(13), ` stroke="${T(36)}" stroke-width="0.7"`)),
    plant(3.25, 4.15, 0.68),
    I({ x: 4.2, y: 4.3, z: 0, w: 0.55, d: 0.55, h: 0.86 },
      [[0, 0.55, 0.3, 20], [0.08, 0.4, 0.28, 26], [0.13, 0.3, 0.28, 32]]
        .map(([o, s2, hh, t], k) => blk(4.2 + o, 4.3 + o, k === 0 ? 0 : k === 1 ? 0.3 : 0.58, s2, s2, hh, t, 17, 11).s).join("")),
