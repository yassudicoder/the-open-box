---
/* =============================================================================
   01 / WHO IT'S FOR

   Was a 3-up grid of cards, each with a small hover-triggered graphic — the
   default shape almost every AI page-builder reaches for, so it read as
   generic no matter what the copy said. This is a manifest list instead:
   six real <details> rows inside the same "inspection window" frame the
   product demos and the pipeline use (.fig — see global.css), so the section
   reads as one more plate from the same manual rather than a bolted-on
   marketing grid.

   The name and the one-line description are ALWAYS visible, no interaction
   required — that's the content carrying the SEO nouns and the "is this
   me?" self-identification, and it shouldn't cost a click. Expanding a row
   only reveals the page-skeleton preview, which is illustration, not
   information. Native <details>/<summary>: keyboard-operable and readable
   by assistive tech with no ARIA patching, and every row's content — open
   or closed — stays in the DOM for search engines to read regardless of
   whether JavaScript ever runs.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { clientTypes } from "../../data/services.ts";
---

<section class="section" id="who" aria-labelledby="who-h">
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="Who it's for"
      sublabel="ORDER TYPES"
      kicker={`TYPES / 01–0${clientTypes.length} · OPEN ONE TO SEE WHAT YOUR SITE WOULD CONTAIN`}
      id="who-h"
    />

    <div class="fig">
      <span class="fig__corner fig__corner--tl" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--tr" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--bl" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--br" aria-hidden="true"></span>

      <div class="fig__bar">
        <span class="fig__bar-label">FIG. 01 — CONSIGNMENT TYPES</span>
        <span>{String(clientTypes.length).padStart(2, "0")} ON FILE</span>
      </div>

      <div class="wt">
        {
          clientTypes.map((c, i) => (
            <details class="wt__row" data-reveal style={`--reveal-delay:${i * 0.05}s`} open={i === 0}>
              <summary class="wt__summary">
                <span class="wt__n mono">{c.key}</span>
                <span class="wt__text">
                  <span class="wt__name">{c.name}</span>
                  <span class="wt__line">{c.line}</span>
                </span>
                <span class="wt__chev" aria-hidden="true" />
              </summary>

              <div class="wt__detail">
                <span class="wt__detail-label mono">TYPICAL BUILD</span>
                <ul class="wt__bars">
                  {c.sections.map((s) => (
                    <li class="wt__bar" style={`--w:${s.w}%`}>
                      <span class="wt__barfill" />
                      <span class="wt__barlabel mono">{s.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>

      <div class="fig__foot">
        <span class="fig__status">TAP A LINE TO OPEN IT</span>
        <span>NO SCRIPT NEEDED</span>
      </div>
    </div>

    <p class="wt__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  .wt {
    display: flex;
    flex-direction: column;
  }

  .wt__row {
    border-bottom: var(--hair) solid var(--line);
    transition: background 0.15s var(--ease);
  }
  .wt__row:last-child {
    border-bottom: 0;
  }
  .wt__row:hover,
  .wt__row:focus-within {
    background: var(--shade);
  }

  .wt__summary {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: clamp(0.85rem, 2vw, 1.1rem) clamp(0.9rem, 2.4vw, 1.3rem);
    cursor: pointer;
    list-style: none;
  }
  .wt__summary::-webkit-details-marker {
    display: none;
  }
  .wt__summary::marker {
    content: "";
  }
  .wt__summary:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: -2px;
  }

  .wt__n {
    flex: none;
    padding-top: 0.2em;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }
  .wt__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }
  .wt__name {
    font-size: clamp(0.98rem, 0.9rem + 0.4vw, 1.12rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .wt__line {
    color: var(--ink-2);
    font-size: 0.86rem;
    line-height: 1.48;
  }

  /* the plus glyph — rotates 45deg into a cross when the row is open */
  .wt__chev {
    position: relative;
    width: 11px;
    height: 11px;
    flex: none;
    margin-top: 0.45em;
    transition: transform 0.2s var(--ease);
  }
  .wt__chev::before,
  .wt__chev::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--label-aa);
    transition: background 0.15s var(--ease);
  }
  .wt__chev::before {
    width: 11px;
    height: 1.5px;
  }
  .wt__chev::after {
    width: 1.5px;
    height: 11px;
  }
  .wt__row[open] .wt__chev {
    transform: rotate(45deg);
  }
  .wt__row[open] .wt__chev::before,
  .wt__row[open] .wt__chev::after {
    background: var(--accent-text);
  }

  /* ---- the page skeleton, revealed on open ---- */
  .wt__detail {
    padding: 0 clamp(0.9rem, 2.4vw, 1.3rem) clamp(1rem, 2.4vw, 1.3rem);
    padding-left: calc(0.62rem + 0.9rem + clamp(0.9rem, 2.4vw, 1.3rem));
  }
  .wt__detail-label {
    display: block;
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    color: var(--label-aa);
    margin-bottom: 0.55rem;
  }
  .wt__bars {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    max-width: 26rem;
  }
  .wt__bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 15px;
  }
  .wt__barfill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border: var(--hair) solid var(--accent-text);
    background: color-mix(in oklab, var(--accent) 8%, var(--field));
    border-radius: 1px;
  }
  .wt__barlabel {
    position: relative;
    z-index: 1;
    font-size: 0.46rem;
    letter-spacing: 0.14em;
    color: var(--ink);
    padding-left: 0.45rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .wt__detail {
      padding-left: clamp(0.9rem, 2.4vw, 1.3rem);
    }
  }

  .wt__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .wt__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .wt__note a:hover {
    color: var(--accent-text);
  }
</style>
