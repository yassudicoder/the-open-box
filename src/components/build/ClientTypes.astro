---
/* =============================================================================
   01 / WHO IT'S FOR — THE DISTRICT

   A blueprint of a small business district: six numbered spaces, one icon
   each. Click a space and it takes over the frame — the others step back —
   showing what a site for that business actually has to contain.

   The plate sits on the page's own paper and ink, not inverted. It is still
   written against the --interior / --interior-ink pair, but .dist re-points
   that pair at --paper / --ink, so the whole district — tone scale, block
   faces, rules — follows the page and the theme from one place.

   Mechanism is still native <details>/<summary> — same foundation as the
   manifest list this replaces, so it stays keyboard-operable, readable by
   assistive tech with no ARIA patching, and every space's full name and
   description stay in the DOM for search engines whether or not JavaScript
   ever runs. What's new is on top: a script enforces "one space open at a
   time" and drives the zoom-in/step-back choreography. Without JavaScript,
   the mechanism still opens and closes (multiple at once, no animation) —
   informationally complete either way, since the full description ships
   as accessible text on every closed block, not just the open one.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { clientTypes } from "../../data/services.ts";
import {
  EYE, VBH, VB_TOP, KERB, ROAD_HALF, NAMED_W, FILLER_W,
  SLOTS, FILLERS, DRAW_ORDER, ribsOf, ribPoints, quadPoints, cardTransform,
  czOf, hazeOf, solveF, vbwOf, sAt, sx, sy,
} from "../../lib/street.ts";

function icon(path: string) {
  return `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
}

/* one line-art mark per space — the district's only illustration budget.
   The raw paths are kept separately because the street reuses them at a
   different stroke weight, as the literal sign over each shopfront. */
const ICON_PATHS: Record<string, string> = {
  "01": '<path d="M16 8v16M8 16h16"/>', // clinic — a plain cross
  "02": '<path d="M9 13h13v3a6.5 6.5 0 0 1-6.5 6.5H15A6.5 6.5 0 0 1 9 16v-3Z"/><path d="M22 14h2.5a3 3 0 0 1 0 6H22"/><path d="M13 8c0-1.2.8-1.4.8-2.6M17 8c0-1.2.8-1.4.8-2.6"/>', // cafe — cup + handle + steam
  "03": '<circle cx="10" cy="9" r="2.6"/><circle cx="10" cy="23" r="2.6"/><path d="M12 10.8 24 22M24 10l-9 8.3M12 21.2l3-2.8"/>', // salon — scissors
  "04": '<rect x="9" y="12" width="8" height="14" rx="4"/><path d="M13 12V9a4 4 0 0 1 8 0v3"/><path d="M13 19h4"/>', // pharmacy — capsule
  "05": '<path d="M9 12h14l-1.3 13.2a2 2 0 0 1-2 1.8H12.3a2 2 0 0 1-2-1.8L9 12Z"/><path d="M12.5 12V9.5a3.5 3.5 0 0 1 7 0V12"/>', // shop — bag
  "06": '<rect x="6" y="8" width="20" height="13" rx="1.5"/><path d="M12 25h8M16 21v4"/>', // startup — screen
};
const ICONS: Record<string, string> = Object.fromEntries(
  Object.entries(ICON_PATHS).map(([k, v]) => [k, icon(v)]),
);

/* ---------------------------------------------------------------------------
   ISOMETRIC PROJECTION — ported from the InteractiveMallSimulation prototype
   (yassudicoder/InteractiveMallSimulation, src/App.tsx). That was React; this
   is plain Astro, so only the maths came across — it renders at BUILD TIME to
   static SVG and ships no JavaScript for the drawing itself.

   One projection plus three face builders is the whole engine: every solid in
   the scene is a top, a front and a side polygon at different depths. The
   prototype faked light by darkening a per-shop neon hex; here the faces are
   all currentColor at different opacities instead, so the whole building
   inverts with the plate and needs no palette of its own — greys on black in
   light mode, greys on white in dark, one drawing either way.
   ------------------------------------------------------------------------ */
type Cam = { hw: number; hh: number; uh: number };
const CAM: Cam = { hw: 25, hh: 12.5, uh: 33 };

const iso = (c: Cam, x: number, y: number, z: number): [number, number] => [
  (x - y) * c.hw,
  (x + y) * c.hh - z * c.uh,
];
const poly = (pts: [number, number][]) =>
  pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
/* Which walls are visible: screen_y = (x + y)·hh - z·uh, so depth grows with
   x + y and the NEAREST corner of a block is (x+w, y+d). The two walls the
   viewer can see are therefore the one at x + w and the one at y + d — not
   the one at y, which is the hidden back wall. */
const topFace = (c: Cam, x: number, y: number, z: number, w: number, d: number) =>
  poly([iso(c, x, y, z), iso(c, x + w, y, z), iso(c, x + w, y + d, z), iso(c, x, y + d, z)]);
const frontFace = (c: Cam, x: number, y: number, z: number, w: number, h: number) =>
  poly([iso(c, x, y, z), iso(c, x + w, y, z), iso(c, x + w, y, z + h), iso(c, x, y, z + h)]);
const sideFace = (c: Cam, x: number, y: number, z: number, d: number, h: number) =>
  poly([iso(c, x, y, z), iso(c, x, y + d, z), iso(c, x, y + d, z + h), iso(c, x, y, z + h)]);

/* ---------------------------------------------------------------------------
   THE STREET — one-point perspective, replacing the isometric city.

   The maths lives in src/lib/street.ts because the client script needs the
   identical functions: this file bakes the first frame at build time, the
   script drives every frame after it, and if the two ever disagree the
   handover shows as a jump at exactly one aspect ratio.

   Two element forms and no others. Anything sharing one Z is a CARD — it
   collapses to a uniform scale about the vanishing point, so it is authored
   once here in local coordinates and moved with a single transform write.
   Anything spanning depth is a RIB — a trapezoid converging on the vanishing
   point, which is not affine and must have its points rewritten each frame.
   Ribs are restricted to exactly two distinct Z values, which is what makes
   the near-plane clip a simple interpolation.
   ------------------------------------------------------------------------ */


/* The baked frame is drawn for a reference 16:9-ish desktop band. It exists
   so the JS path has no blank flash before the first update() and so a
   crawler sees a composed street; the runtime immediately re-solves it for
   the real frame. */
const BAKE_W = 928;
const BAKE_H = VBH;
const BAKE_VBW = vbwOf(BAKE_W, 486);
const BAKE_F = solveF(BAKE_VBW);
const BAKE_CZ = czOf(0);

/* ---- one facade elevation, authored flat --------------------------------
   Local coordinates: u runs from the road-side edge outward and is SIGNED by
   which kerb the building stands on, so the same builder produces both hands
   without a mirroring transform — a scale(-1,1) would flip the sign text too.
   v runs downward from the roof line. Both are world units; the card's own
   transform supplies the scale.

   Authored as a flat orthographic elevation on purpose. The interiors are
   2:1 dimetric and the street is perspective; mixing the two projections in
   one drawing is a visual bug, so the only place they meet is the moment at
   the door, where the cross-fade covers the seam. */
const facade = (key: string, side: -1 | 1, h: number) => {
  const u = (n: number) => n * side;
  const x0 = Math.min(0, u(NAMED_W));
  const w = NAMED_W;
  const ln = (a: number, b: number, c: number, d: number, sw = 0.07) =>
    `<line x1="${u(a).toFixed(2)}" y1="${b.toFixed(2)}" x2="${u(c).toFixed(2)}" y2="${d.toFixed(2)}" stroke-width="${sw}"/>`;
  const bx = (a: number, b: number, ww: number, hh: number, sw = 0.06) =>
    `<rect x="${Math.min(u(a), u(a + ww)).toFixed(2)}" y="${b.toFixed(2)}" width="${ww.toFixed(2)}" height="${hh.toFixed(2)}" stroke-width="${sw}" fill="none"/>`;

  /* An OPAQUE front. Without it the card is strokes only, the building is
     see-through, and the whole street behind it draws through the shopfront —
     the painter's order is correct but there is nothing to paint over. It
     doubles as the hit area, so the click target costs one transform write
     per frame rather than a rib rewrite, and is solid rather than hairlines. */
  let o = `<rect class="st-face" x="${x0.toFixed(2)}" y="0" width="${w.toFixed(2)}" height="${h.toFixed(2)}" stroke-width="0.1"/>`;
  /* shopfront band, then the floors above it */
  o += ln(0, h - 3.2, NAMED_W, h - 3.2, 0.08);
  o += ln(0, h - 3.9, NAMED_W, h - 3.9, 0.05);
  const floors = Math.max(1, Math.floor((h - 3.9) / 2.1));
  for (let i = 1; i <= floors; i++) {
    const v = h - 3.9 - i * ((h - 3.9) / (floors + 1));
    for (let k = 0; k < 5; k++) o += bx(1.0 + k * 2.1, v - 0.62, 1.35, 1.24);
  }
  /* the shopfront itself: door on the road side, then glazing bays */
  o += bx(0.6, h - 2.9, 1.3, 2.9, 0.08);
  o += ln(1.05, h - 1.75, 1.35, h - 1.6, 0.06);
  for (let k = 0; k < 3; k++) o += bx(2.4 + k * 2.3, h - 2.7, 1.9, 2.3);
  /* kerb step */
  o += ln(0, h - 0.14, NAMED_W, h - 0.14, 0.05);
  /* The sign: the mark and the key become the literal shop sign.
     It must fit inside the identity band — X in [3.9, 7.2], so u <= 3.3.
     solveF only guarantees THAT strip is on-frame at every aspect; anything
     wider clips off the side of a portrait phone. */
  o += bx(0.35, h - 3.82, 2.9, 0.62, 0.05);
  o += `<svg x="${Math.min(u(0.55), u(1.15)).toFixed(2)}" y="${(h - 3.74).toFixed(2)}" width="0.46" height="0.46" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[key]}</svg>`;
  o += `<text x="${u(2.15).toFixed(2)}" y="${(h - 3.3).toFixed(2)}" text-anchor="middle" font-family="var(--font-mono)" font-size="0.52" letter-spacing="0.06" stroke="none" fill="currentColor">${key}</text>`;
  return o;
};

/* An anonymous infill block: no name, no key, no copy, no data. It exists so
   six buildings on a road read as a district rather than as a gate. */
const fillerFacade = (h: number, side: -1 | 1) => {
  const u = (n: number) => n * side;
  const x0 = Math.min(0, u(FILLER_W));
  let o = `<rect class="st-face" x="${x0.toFixed(2)}" y="0" width="${FILLER_W.toFixed(2)}" height="${h.toFixed(2)}" stroke-width="0.09"/>`;
  const floors = Math.max(1, Math.floor(h / 2.0));
  for (let i = 1; i <= floors; i++) {
    const v = (h * i) / (floors + 1);
    for (let k = 0; k < 3; k++) {
      const a = 1.1 + k * 2.1;
      o += `<rect x="${Math.min(u(a), u(a + 1.3)).toFixed(2)}" y="${(v - 0.5).toFixed(2)}" width="1.30" height="1.00" stroke-width="0.05" fill="none"/>`;
    }
  }
  o += `<line x1="${u(0).toFixed(2)}" y1="${(h - 0.12).toFixed(2)}" x2="${u(FILLER_W).toFixed(2)}" y2="${(h - 0.12).toFixed(2)}" stroke-width="0.05"/>`;
  return o;
};

/* ---- the baked first frame ---------------------------------------------- */
const bakeRibs = (b: { side: -1 | 1; zf: number; zb: number; h: number }, w: number) => {
  const R = ribsOf(b, w);
  const p = (k: "flank" | "base") => {
    const [ax, ay, bx2, by, zA, zB] = R[k];
    return ribPoints(ax, ay, bx2, by, zA, zB, BAKE_CZ, 0, BAKE_F);
  };
  return {
    flank: p("flank"),
    base: p("base"),
    card: cardTransform(KERB * b.side, b.h, b.zf, BAKE_CZ, 0, BAKE_F),
    haze: hazeOf(b.zf - BAKE_CZ),
  };
};

const bakedNamed = SLOTS.map((s) => ({ slot: s, ...bakeRibs(s, NAMED_W) }));
const bakedFill = FILLERS.map((s, i) => ({ i, slot: s, ...bakeRibs(s, FILLER_W) }));

/* The ground is invariant under a pure-Z dolly with panX = 0, so it is drawn
   once and never touched again — which also keeps it out of the damage rect
   on every animated frame. */
const GROUND_Y = (VBH + VB_TOP) * 0.78;
const KERB_L = `${(-BAKE_VBW / 2).toFixed(0)},${GROUND_Y.toFixed(0)} 0,0`;
const KERB_R = `${(BAKE_VBW / 2).toFixed(0)},${GROUND_Y.toFixed(0)} 0,0`;

/* 16 cross-rungs recycled modulo one spacing: receding rungs are a technical
   drawing, a dashed centre line is a highway. */
const RUNG_N = 16;
const RUNG_SPACING = 26 / RUNG_N;
const bakedRungs = Array.from({ length: RUNG_N }, (_, i) => {
  const z = BAKE_CZ + 2 + i * RUNG_SPACING;
  const s = sAt(z, BAKE_CZ, BAKE_F);
  return { i, t: `translate(0px,${sy(s, 0).toFixed(1)}px) scale(${s.toFixed(4)})` };
});

/* ---------------------------------------------------------------------------
   THE INTERIORS — ported from the prototype's six room components.

   Same idea, three differences. (1) Tone, not hue: the prototype shaded with
   dk(neonHex, f); here T(pct) mixes --interior-ink into --interior at the
   same relative percentages, so the tonal structure survives exactly and the
   whole room inverts with the plate. (2) Walls on the FAR side. The
   prototype puts its "back wall" at y = D and "right wall" at x = W, but in
   this projection depth grows with x + y, so those are the NEAR walls and
   they sit between the viewer and the furniture; here they are at x = 0 and
   y = 0 and the room opens toward you. (3) Draw order is computed, not
   authored — see `paint` below; the prototype emits furniture in source
   order and lets near props paint over far ones. (4) Emitted as SVG strings
   at build time — no React, no client JS.
   ------------------------------------------------------------------------ */
const RM: Cam = { hw: 33, hh: 16.5, uh: 40 };
const RW = 6;
const RD = 5;
const RH = 3.8;

/** One opaque step between the plate and its ink. The prototype's factors were
    tuned against saturated neon; the same numbers in pure tone come out far too
    close to the ground, so they are lifted and spread here — the ordering is
    preserved, the range is not.

    Returns a custom property, not the colour: spelled out, the same six rooms
    put 1,800 copies of a 65-character color-mix() into the document. Declared
    once on the plate and inherited, they cost eleven characters each — 90 KB
    less markup for the browser to parse, for the same pixels. */
const TONES = new Set<number>();
const T = (pct: number) => {
  const n = Math.min(94, Math.max(4, Math.round(pct * 1.45 + 5)));
  TONES.add(n);
  return `var(--t${n})`;
};

const pg = (pts: string, fill: string, extra = "") => `<polygon points="${pts}" fill="${fill}"${extra}/>`;
const seg = (a: [number, number], b: [number, number], stroke: string, w = 0.7) =>
  `<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="${stroke}" stroke-width="${w}"/>`;
const dot = (pnt: [number, number], r: number, fill: string, extra = "") =>
  `<circle cx="${pnt[0].toFixed(1)}" cy="${pnt[1].toFixed(1)}" r="${r}" fill="${fill}"${extra}/>`;

/* ---- draw order inside a room -------------------------------------------
   Every prop is an axis-aligned box, and A can only hide B when A sits
   wholly on the near side of B along one axis. That is a partial order, not
   a sort key — a wide counter and a stool standing in front of it share the
   same x + y, and no single number separates them. So each prop declares its
   box, `after` compares two boxes, and a stable topological walk emits them
   far to near. Pairs that can never overlap on screen keep the order they
   were written in.

   The prototype has no such pass: it emits furniture in source order, which
   is why its desks paint over the units behind them. Free here — it all runs
   once, at build time.

   `paint` also shouts if two props share a volume, because the sort assumes
   solids that touch but never interpenetrate. That check has caught every
   layout slip in this file; leave it in. */
type Box = { x: number; y: number; z: number; w: number; d: number; h: number };
type Item = { b: Box; s: string };

const after = (a: Box, b: Box) =>
  a.x >= b.x + b.w || a.y >= b.y + b.d || a.z >= b.z + b.h;

const hits = (a: Box, b: Box) => {
  const e = 1e-6;
  return (
    a.x + e < b.x + b.w && b.x + e < a.x + a.w &&
    a.y + e < b.y + b.d && b.y + e < a.y + a.d &&
    a.z + e < b.z + b.h && b.z + e < a.z + a.h
  );
};

const paint = (items: Item[], room = "") => {
  const n = items.length;
  const succ: number[][] = items.map(() => []);
  const indeg: number[] = new Array(n).fill(0);
  for (let i = 0; i < n; i++) {
    for (let j = i + 1; j < n; j++) {
      if (room && hits(items[i].b, items[j].b)) {
        console.warn(`[district] ${room}: props ${i} and ${j} share a volume`, items[i].b, items[j].b);
      }
      const ij = after(items[i].b, items[j].b);
      const ji = after(items[j].b, items[i].b);
      if (ij === ji) continue; // both or neither — nothing to enforce
      const first = ij ? j : i;
      const next = ij ? i : j;
      succ[first].push(next);
      indeg[next]++;
    }
  }
  const out: string[] = [];
  const drawn: boolean[] = new Array(n).fill(false);
  for (let k = 0; k < n; k++) {
    let pick = -1;
    for (let i = 0; i < n && pick < 0; i++) if (!drawn[i] && indeg[i] === 0) pick = i;
    /* Cycle guard: a pathological ring of boxes can leave every survivor
       waiting on another. Take the earliest rather than spin. */
    for (let i = 0; i < n && pick < 0; i++) if (!drawn[i]) pick = i;
    drawn[pick] = true;
    out.push(items[pick].s);
    for (const nx of succ[pick]) indeg[nx]--;
  }
  return out.join("");
};

const I = (b: Box, s: string): Item => ({ b, s });
/** marks that belong to a prop — same box, drawn straight after it */
const on = (it: Item, ...more: string[]): Item => ({ b: it.b, s: it.s + more.join("") });

/** A solid: its two visible walls plus the top.

    The three numbers are ink strengths, given strongest first. Which FACE
    gets which depends on where the light is, and on paper it falls from
    above: the top of a thing is its lightest face and the side turned away
    is its darkest, so the strongest step goes on the side and the weakest on
    the top. (Against the old inverted plate it ran the other way — more ink
    meant brighter there.) These three lines are where the light comes from.

    The hairline on every face is what stops one grey box dissolving into the
    grey box behind it — without it a room full of props reads as one lump. */
const blk = (x: number, y: number, z: number, w: number, d: number, h: number,
             strong = 30, mid = 19, weak = 11, edge = true): Item => {
  const e = edge ? ` stroke="${T(strong + 13)}" stroke-width="0.45" stroke-linejoin="round"` : "";
  return {
    b: { x, y, z, w, d, h },
    s:
      pg(sideFace(RM, x + w, y, z, d, h), T(strong), e) +
      pg(frontFace(RM, x, y + d, z, w, h), T(mid), e) +
      pg(topFace(RM, x, y, z + h, w, d), T(weak), e),
  };
};

/** flat panel on the far wall at y = 0 */
const panY = (x: number, z: number, w: number, h: number, fill: string, extra = "") =>
  pg(poly([iso(RM, x, 0, z), iso(RM, x + w, 0, z), iso(RM, x + w, 0, z + h), iso(RM, x, 0, z + h)]), fill, extra);
/** flat panel on the far wall at x = 0 */
const panX = (y: number, z: number, d: number, h: number, fill: string, extra = "") =>
  pg(poly([iso(RM, 0, y, z), iso(RM, 0, y + d, z), iso(RM, 0, y + d, z + h), iso(RM, 0, y, z + h)]), fill, extra);

const wallY = (x: number, z: number, w: number, h: number, fill: string, extra = ""): Item =>
  I({ x, y: 0, z, w, d: 0, h }, panY(x, z, w, h, fill, extra));
const wallX = (y: number, z: number, d: number, h: number, fill: string, extra = ""): Item =>
  I({ x: 0, y, z, w: 0, d, h }, panX(y, z, d, h, fill, extra));

/* ---- repeated props -----------------------------------------------------
   Legs matter more than they sound: a tabletop floating on four posts reads
   as furniture, where the same volume drawn solid reads as a crate. */

const legs = (x: number, y: number, w: number, d: number, h: number, t = 0.08) =>
  ([[x + 0.05, y + 0.05], [x + w - t - 0.05, y + 0.05],
    [x + 0.05, y + d - t - 0.05], [x + w - t - 0.05, y + d - t - 0.05]] as [number, number][])
    .map(([lx, ly]) => blk(lx, ly, 0, t, t, h, 30, 22, 16, false));

const table = (x: number, y: number, w: number, d: number, h: number,
               strong = 32, mid = 22, weak = 14): Item => ({
  b: { x, y, z: 0, w, d, h },
  s: paint([...legs(x, y, w, d, h - 0.09), blk(x, y, h - 0.09, w, d, 0.09, strong, mid, weak)]),
});

/** seat pad on legs with a back on the near side, so it faces the viewer */
const seat = (x: number, y: number, w = 0.6, d = 0.58, bh = 0.58): Item => ({
  b: { x, y, z: 0, w, d, h: 0.44 + bh },
  s: paint([
    ...legs(x, y, w, d, 0.36, 0.07),
    blk(x, y, 0.36, w, d, 0.08, 32, 22, 14),
    blk(x, y + d - 0.08, 0.44, w, 0.08, bh, 38, 26, 17),
  ]),
});

const stool = (x: number, y: number, s = 0.42, h = 0.62): Item => ({
  b: { x, y, z: 0, w: s, d: s, h },
  s: paint([
    blk(x + s / 2 - 0.05, y + s / 2 - 0.05, 0, 0.1, 0.1, h - 0.08, 30, 22, 16, false),
    blk(x, y, h - 0.08, s, s, 0.08, 36, 25, 16),
  ]),
});

/** pot plus a loose crown of leaves — the only organic thing in the room */
const plant = (x: number, y: number, s = 0.62): Item => {
  const c = iso(RM, x + s / 2, y + s / 2, s * 0.62);
  const leaf = (dx: number, dy: number, r: number, t: number) =>
    dot([c[0] + dx, c[1] + dy], r, T(t), ` stroke="${T(t + 14)}" stroke-width="0.45"`);
  return {
    b: { x, y, z: 0, w: s, d: s, h: s * 2.6 },
    s:
      blk(x + s * 0.16, y + s * 0.16, 0, s * 0.68, s * 0.68, s * 0.62, 26, 17, 11).s +
      seg([c[0], c[1]], [c[0], c[1] - 24], T(24), 1) +
      leaf(0, -18, 10, 18) + leaf(-10, -8, 8, 26) + leaf(10, -11, 7, 22) + leaf(1, -29, 6, 30),
  };
};

/** pendant on a cord */
const pend = (x: number, y: number, drop = 1.3): Item => ({
  b: { x: x - 0.12, y: y - 0.12, z: RH - drop, w: 0.24, d: 0.24, h: drop },
  s:
    seg(iso(RM, x, y, RH), iso(RM, x, y, RH - drop), T(22), 0.8) +
    dot(iso(RM, x, y, RH - drop - 0.15), 7, T(38)) +
    dot(iso(RM, x, y, RH - drop - 0.18), 3.2, T(5)),
});

/** recessed ceiling light */
const down = (x: number, y: number, r = 4): Item =>
  I({ x: x - 0.1, y: y - 0.1, z: RH - 0.05, w: 0.2, d: 0.2, h: 0.05 },
    dot(iso(RM, x, y, RH), r, T(5), ` stroke="${T(34)}" stroke-width="0.8"`));

/** A mat — zero height, so anything standing on it draws after. One tonal
    step off the floor and no more; any further and it stops reading as a rug
    and starts reading as a hole cut in the floor. */
const mat = (x: number, y: number, w: number, d: number): Item =>
  I({ x, y, z: 0, w, d, h: 0 },
    pg(topFace(RM, x, y, 0.01, w, d), T(11), ` stroke="${T(24)}" stroke-width="0.6"`) +
    pg(topFace(RM, x + 0.14, y + 0.14, 0.02, w - 0.28, d - 0.28), "none", ` stroke="${T(19)}" stroke-width="0.4"`));

/** a bench or low seat: a slab on four legs, no back */
const bench = (x: number, y: number, w: number, d: number, h = 0.5): Item => ({
  b: { x, y, z: 0, w, d, h },
  s: paint([...legs(x, y, w, d, h - 0.09, 0.07), blk(x, y, h - 0.09, w, d, 0.09, 30, 20, 13)]),
});

/** glass on a wall: lighter than the wall, framed, with one band of sheen */
const glassY = (x: number, z: number, w: number, h: number, fill = 13): Item =>
  on(wallY(x, z, w, h, T(fill), ` stroke="${T(46)}" stroke-width="1.1"`),
     panY(x + w * 0.14, z, w * 0.13, h, T(fill + 11)),
     panY(x + w * 0.42, z, w * 0.06, h, T(fill + 7)));

const glassX = (y: number, z: number, d: number, h: number, fill = 13): Item =>
  on(wallX(y, z, d, h, T(fill), ` stroke="${T(46)}" stroke-width="1.1"`),
     panX(y + d * 0.14, z, d * 0.13, h, T(fill + 11)),
     panX(y + d * 0.42, z, d * 0.06, h, T(fill + 7)));

const clockY = (x: number, z: number): Item => {
  const c = iso(RM, x, 0, z);
  return I({ x: x - 0.25, y: 0, z: z - 0.25, w: 0.5, d: 0, h: 0.5 },
    dot(c, 8, T(8), ` stroke="${T(36)}" stroke-width="1"`) +
    seg(c, [c[0], c[1] - 5], T(44), 1) +
    seg(c, [c[0] + 4.5, c[1] + 1.5], T(36), 1));
};

const crossY = (x: number, z: number): Item => {
  const c = iso(RM, x, 0, z);
  return I({ x: x - 0.3, y: 0, z: z - 0.3, w: 0.6, d: 0, h: 0.6 },
    `<rect x="${(c[0] - 3.4).toFixed(1)}" y="${(c[1] - 12).toFixed(1)}" width="6.8" height="24" rx="1" fill="${T(34)}"/>` +
    `<rect x="${(c[0] - 12).toFixed(1)}" y="${(c[1] - 3.4).toFixed(1)}" width="24" height="6.8" rx="1" fill="${T(34)}"/>`);
};

const shell = () => {
  let o = pg(topFace(RM, 0, 0, 0, RW, RD), T(6));
  for (let i = 1; i < RW; i++) o += seg(iso(RM, i, 0, 0), iso(RM, i, RD, 0), T(12), 0.5);
  for (let i = 1; i < RD; i++) o += seg(iso(RM, 0, i, 0), iso(RM, RW, i, 0), T(12), 0.5);
  o += panY(0, 0, RW, RH, T(10));
  o += panX(0, 0, RD, RH, T(8));
  o += panY(0, 0, RW, 0.1, T(22));
  o += panX(0, 0, RD, 0.1, T(18));
  o += seg(iso(RM, 0, 0, RH), iso(RM, RW, 0, RH), T(28), 0.8);
  o += seg(iso(RM, 0, 0, RH), iso(RM, 0, RD, RH), T(24), 0.8);
  o += seg(iso(RM, 0, 0, 0), iso(RM, 0, 0, RH), T(20), 0.6);
  return o;
};

/* ---- the six rooms ------------------------------------------------------
   Order here is only a tie-break; `paint` works out what hides what.

   Layouts are spread on the SCREEN, not on the floor plan, and those are not
   the same thing: screen x is (x − y)·hw, so the right-hand third of the
   frame is the strip of floor with high x and low y. Fill a room by walking
   the plan diagonally — a room laid out tidily along one wall leaves half
   the picture as bare floor. */

