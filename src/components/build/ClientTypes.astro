---
/* =============================================================================
   01 / WHO IT'S FOR — THE DISTRICT

   A blueprint of a small business district: six numbered spaces, one icon
   each. Click a space and it takes over the frame — the others step back —
   showing what a site for that business actually has to contain.

   Built on the same idea as the "inside the box" moment in the hero: this
   frame is permanently inverted (--interior / --interior-ink), the same
   pair DemoContinue.astro uses for its own always-dark capsule, regardless
   of which theme the rest of the page is in. Stepping into the district
   uses the one inversion trick this site already has, rather than
   inventing a second one.

   Mechanism is still native <details>/<summary> — same foundation as the
   manifest list this replaces, so it stays keyboard-operable, readable by
   assistive tech with no ARIA patching, and every space's full name and
   description stay in the DOM for search engines whether or not JavaScript
   ever runs. What's new is on top: a script enforces "one space open at a
   time" and drives the zoom-in/step-back choreography. Without JavaScript,
   the mechanism still opens and closes (multiple at once, no animation) —
   informationally complete either way, since the full description ships
   as accessible text on every closed block, not just the open one.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { clientTypes } from "../../data/services.ts";

function icon(path: string) {
  return `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
}

/* one line-art mark per space — the district's only illustration budget */
const ICONS: Record<string, string> = {
  "01": icon('<path d="M16 8v16M8 16h16"/>'), // clinic — a plain cross
  "02": icon('<path d="M9 13h13v3a6.5 6.5 0 0 1-6.5 6.5H15A6.5 6.5 0 0 1 9 16v-3Z"/><path d="M22 14h2.5a3 3 0 0 1 0 6H22"/><path d="M13 8c0-1.2.8-1.4.8-2.6M17 8c0-1.2.8-1.4.8-2.6"/>'), // cafe — cup + handle + steam
  "03": icon('<circle cx="10" cy="9" r="2.6"/><circle cx="10" cy="23" r="2.6"/><path d="M12 10.8 24 22M24 10l-9 8.3M12 21.2l3-2.8"/>'), // salon — scissors
  "04": icon('<rect x="9" y="12" width="8" height="14" rx="4"/><path d="M13 12V9a4 4 0 0 1 8 0v3"/><path d="M13 19h4"/>'), // pharmacy — capsule
  "05": icon('<path d="M9 12h14l-1.3 13.2a2 2 0 0 1-2 1.8H12.3a2 2 0 0 1-2-1.8L9 12Z"/><path d="M12.5 12V9.5a3.5 3.5 0 0 1 7 0V12"/>'), // shop — bag
  "06": icon('<rect x="6" y="8" width="20" height="13" rx="1.5"/><path d="M12 25h8M16 21v4"/>'), // startup — screen
};

/* ---------------------------------------------------------------------------
   ISOMETRIC PROJECTION — ported from the InteractiveMallSimulation prototype
   (yassudicoder/InteractiveMallSimulation, src/App.tsx). That was React; this
   is plain Astro, so only the maths came across — it renders at BUILD TIME to
   static SVG and ships no JavaScript for the drawing itself.

   One projection plus three face builders is the whole engine: every solid in
   the scene is a top, a front and a side polygon at different depths. The
   prototype faked light by darkening a per-shop neon hex; here the faces are
   all currentColor at different opacities instead, so the whole building
   inverts with the plate and needs no palette of its own — greys on black in
   light mode, greys on white in dark, one drawing either way.
   ------------------------------------------------------------------------ */
type Cam = { hw: number; hh: number; uh: number };
const CAM: Cam = { hw: 25, hh: 12.5, uh: 33 };

const iso = (c: Cam, x: number, y: number, z: number): [number, number] => [
  (x - y) * c.hw,
  (x + y) * c.hh - z * c.uh,
];
const poly = (pts: [number, number][]) =>
  pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
/* Which walls are visible: screen_y = (x + y)·hh - z·uh, so depth grows with
   x + y and the NEAREST corner of a block is (x+w, y+d). The two walls the
   viewer can see are therefore the one at x + w and the one at y + d — not
   the one at y, which is the hidden back wall. */
const topFace = (c: Cam, x: number, y: number, z: number, w: number, d: number) =>
  poly([iso(c, x, y, z), iso(c, x + w, y, z), iso(c, x + w, y + d, z), iso(c, x, y + d, z)]);
const frontFace = (c: Cam, x: number, y: number, z: number, w: number, h: number) =>
  poly([iso(c, x, y, z), iso(c, x + w, y, z), iso(c, x + w, y, z + h), iso(c, x, y, z + h)]);
const sideFace = (c: Cam, x: number, y: number, z: number, d: number, h: number) =>
  poly([iso(c, x, y, z), iso(c, x, y + d, z), iso(c, x, y + d, z + h), iso(c, x, y, z + h)]);

/* Footprint: three across, two deep. Heights are compositional only — a
   skyline needs variation to read as one — and claim nothing about the
   businesses. Everything factual comes from clientTypes. */
/* A roof projects (w + d) wide but only (w) of that sits over the facade, so
   blocks need clear air between them or near roofs bury far facades. The
   prototype's 3.6 spacing was tight enough that they collided; these are
   spaced wider and kept lower. */
const UNIT = { w: 3, d: 2.2 };
const COL = 4.1;
const ROW = [0.5, 4.3];
/* Kept low on purpose: a tall near block's roof rises over the far row and
   eats its click target. These heights keep every block's own roof clear. */
const HEIGHTS = [2.5, 2.1, 2.8, 2.3, 2.6, 3.0];
const PLINTH = 0.45;

const blocks = clientTypes.map((c, i) => ({
  type: c,
  i,
  x: (i % 3) * COL,
  y: i < 3 ? ROW[0] : ROW[1],
  h: HEIGHTS[i % HEIGHTS.length],
}));

/* Painter's algorithm: in this projection depth grows with x + y, so drawing
   in that order puts far blocks behind near ones. */
const drawOrder = [...blocks].sort((a, b) => a.x + a.y - (b.x + b.y));

/* ---------------------------------------------------------------------------
   THE INTERIORS — ported from the prototype's six room components.

   Same idea, three differences. (1) Tone, not hue: the prototype shaded with
   dk(neonHex, f); here T(pct) mixes --interior-ink into --interior at the
   same relative percentages, so the tonal structure survives exactly and the
   whole room inverts with the plate. (2) Walls on the FAR side. The
   prototype puts its "back wall" at y = D and "right wall" at x = W, but in
   this projection depth grows with x + y, so those are the NEAR walls and
   they sit between the viewer and the furniture; here they are at x = 0 and
   y = 0 and the room opens toward you. (3) Emitted as SVG strings at build
   time — no React, no client JS.
   ------------------------------------------------------------------------ */
const RM: Cam = { hw: 33, hh: 16.5, uh: 40 };
const RW = 6;
const RD = 5;
const RH = 3.8;

/** One opaque step between the plate and its ink. The prototype's factors were
    tuned against saturated neon; the same numbers in pure tone come out far too
    close to the ground, so they are lifted and spread here — the ordering is
    preserved, the range is not. */
const T = (pct: number) =>
  `color-mix(in oklab, var(--interior-ink) ${Math.min(94, Math.round(pct * 1.45 + 5))}%, var(--interior))`;

const pg = (pts: string, fill: string, extra = "") => `<polygon points="${pts}" fill="${fill}"${extra}/>`;
const seg = (a: [number, number], b: [number, number], stroke: string, w = 0.7) =>
  `<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="${stroke}" stroke-width="${w}"/>`;
const dot = (pnt: [number, number], r: number, fill: string, extra = "") =>
  `<circle cx="${pnt[0].toFixed(1)}" cy="${pnt[1].toFixed(1)}" r="${r}" fill="${fill}"${extra}/>`;

/** a solid: its two visible walls plus the top */
const solid = (x: number, y: number, z: number, w: number, d: number, h: number,
               top = 30, front = 19, side = 11) =>
  pg(sideFace(RM, x + w, y, z, d, h), T(side)) +
  pg(frontFace(RM, x, y + d, z, w, h), T(front)) +
  pg(topFace(RM, x, y, z + h, w, d), T(top));

/** flat panel hung on the far wall at y = 0 */
const wallY = (x: number, z: number, w: number, h: number, fill: string, extra = "") =>
  pg(poly([iso(RM, x, 0, z), iso(RM, x + w, 0, z), iso(RM, x + w, 0, z + h), iso(RM, x, 0, z + h)]), fill, extra);
/** flat panel hung on the far wall at x = 0 */
const wallX = (y: number, z: number, d: number, h: number, fill: string, extra = "") =>
  pg(poly([iso(RM, 0, y, z), iso(RM, 0, y + d, z), iso(RM, 0, y + d, z + h), iso(RM, 0, y, z + h)]), fill, extra);

const shell = () => {
  let o = pg(topFace(RM, 0, 0, 0, RW, RD), T(6));
  for (let i = 1; i < RW; i++) o += seg(iso(RM, i, 0, 0), iso(RM, i, RD, 0), T(12), 0.5);
  for (let i = 1; i < RD; i++) o += seg(iso(RM, 0, i, 0), iso(RM, RW, i, 0), T(12), 0.5);
  o += wallY(0, 0, RW, RH, T(10));
  o += wallX(0, 0, RD, RH, T(8));
  o += wallY(0, 0, RW, 0.1, T(22));
  o += wallX(0, 0, RD, 0.1, T(18));
  o += seg(iso(RM, 0, 0, RH), iso(RM, RW, 0, RH), T(28), 0.8);
  o += seg(iso(RM, 0, 0, RH), iso(RM, 0, RD, RH), T(24), 0.8);
  o += seg(iso(RM, 0, 0, 0), iso(RM, 0, 0, RH), T(20), 0.6);
  return o;
};

const clinicRoom = () => {
  let o = shell();
  o += solid(2.9, 1.7, 0, 2.4, 1.15, 0.78);
  o += solid(4.5, 1.85, 0.78, 0.6, 0.5, 0.14, 52, 40, 30);
  o += solid(0.45, 0.3, 0, 2.2, 0.85, 0.72);
  o += pg(frontFace(RM, 0.75, 1.15, 0.72, 0.95, 0.5), T(9));
  o += pg(frontFace(RM, 0.82, 1.15, 0.77, 0.81, 0.4), T(30));
  o += solid(0.2, 2.7, 0, 0.75, 1.8, 2.1);
  for (const z of [0.62, 1.3]) o += pg(frontFace(RM, 0.2, 4.5, z, 0.75, 0.06), T(34));
  for (const z of [0.72, 1.4]) {
    for (let k = 0; k < 4; k++) o += pg(frontFace(RM, 0.28 + k * 0.16, 4.5, z, 0.11, 0.2 + (k % 3) * 0.05), T(40 + k * 5));
  }
  const [cx, cy] = iso(RM, 3.5, 0, 2.4);
  o += `<rect x="${(cx - 3.4).toFixed(1)}" y="${(cy - 12).toFixed(1)}" width="6.8" height="24" rx="1" fill="${T(34)}"/>`;
  o += `<rect x="${(cx - 12).toFixed(1)}" y="${(cy - 3.4).toFixed(1)}" width="24" height="6.8" rx="1" fill="${T(34)}"/>`;
  return o;
};

const cafeRoom = () => {
  let o = shell();
  o += solid(0.35, 0.3, 0, 5.2, 0.85, 1.0);
  o += solid(1.5, 0.4, 1.0, 1.0, 0.65, 0.72, 44, 30, 20);
  o += pg(frontFace(RM, 1.65, 1.05, 1.24, 0.7, 0.26), T(46));
  for (const cx2 of [3.1, 3.45, 3.8]) o += solid(cx2, 0.42, 1.0, 0.2, 0.2, 0.24, 46, 34, 24);
  for (const [tx, ty] of [[1.6, 2.5], [3.9, 3.2]] as [number, number][]) {
    o += solid(tx, ty, 0, 1.25, 1.15, 0.68);
    o += solid(tx - 0.05, ty - 0.85, 0.4, 0.7, 0.55, 0.1, 26, 17, 10);
    o += solid(tx + 0.3, ty + 1.2, 0.4, 0.7, 0.55, 0.1, 26, 17, 10);
  }
  o += wallX(1.2, 0.5, 2.2, 2.3, T(6), ` stroke="${T(28)}" stroke-width="0.9"`);
  for (let i = 0; i < 4; i++) o += wallX(1.45, 2.35 - i * 0.42, 1.5 - i * 0.16, 0.07, T(30));
  for (const [lx, ly] of [[2.2, 2.2], [4.2, 2.8]] as [number, number][]) {
    o += seg(iso(RM, lx, ly, RH), iso(RM, lx, ly, 2.5), T(22), 0.8);
    o += dot(iso(RM, lx, ly, 2.35), 7, T(30));
    o += dot(iso(RM, lx, ly, 2.32), 3.2, T(62));
  }
  return o;
};

const salonRoom = () => {
  let o = shell();
  for (const sx of [0.4, 2.3, 4.2] as number[]) {
    o += solid(sx, 0.3, 0, 1.4, 0.8, 0.8);
    o += wallY(sx + 0.15, 0.95, 1.1, 1.9, T(4), ` stroke="${T(44)}" stroke-width="1.2"`);
    o += wallY(sx + 0.08, 0.88, 1.24, 2.04, "none", ` stroke="${T(26)}" stroke-width="0.6"`);
    o += solid(sx + 0.15, 1.5, 0, 1.05, 0.7, 0.5, 40, 28, 17);
    o += pg(frontFace(RM, sx + 0.17, 2.2, 0.5, 1.01, 0.72), T(24));
    for (let j = 0; j < 3; j++) o += solid(sx + 0.1 + j * 0.35, 0.4, 0.8, 0.18, 0.18, 0.3 + j * 0.05, 46 + j * 6, 34, 22);
    o += dot(iso(RM, sx + 0.7, 1.0, RH), 4.2, T(34));
  }
  o += solid(0.15, 3.2, 0, 0.7, 1.6, 1.9);
  for (const z of [0.5, 1.0, 1.5]) o += pg(frontFace(RM, 0.15, 4.8, z, 0.7, 0.06), T(36));
  return o;
};

const pharmacyRoom = () => {
  let o = shell();
  for (const bx of [0.35, 2.3, 4.25] as number[]) {
    o += solid(bx, 0.25, 0, 1.6, 0.75, 2.4);
    for (const z of [0.7, 1.4, 2.05]) o += pg(frontFace(RM, bx, 1.0, z, 1.6, 0.06), T(34));
    for (const z of [0.78, 1.48]) {
      for (let k = 0; k < 5; k++) o += pg(frontFace(RM, bx + 0.1 + k * 0.29, 1.0, z, 0.19, 0.28 + (k % 3) * 0.06), T(38 + (k % 4) * 8));
    }
  }
  o += solid(0.4, 3.3, 0, 4.6, 0.95, 0.95);
  o += pg(frontFace(RM, 0.7, 4.25, 0.95, 1.35, 0.55), T(9));
  o += pg(frontFace(RM, 0.78, 4.25, 1.02, 1.19, 0.42), T(30));
  const [rx, ry] = iso(RM, 3.5, 0, 2.55);
  o += `<text x="${rx.toFixed(1)}" y="${ry.toFixed(1)}" text-anchor="middle" fill="${T(38)}" font-size="17" font-family="var(--font-mono)" font-weight="700">Rx</text>`;
  return o;
};

const shopRoom = () => {
  let o = shell();
  o += solid(1.7, 1.9, 0, 2.9, 1.9, 0.72);
  for (const [tx, ty, i] of [[2.0, 2.2, 0], [2.8, 2.6, 1], [3.5, 2.1, 2], [3.9, 2.9, 3]] as [number, number, number][]) {
    o += solid(tx, ty, 0.72, 0.36, 0.36, 0.3, 42 + i * 7, 30, 20);
  }
  for (const bx of [0.5, 3.1] as number[]) {
    o += wallY(bx, 0.4, 2.1, 2.5, T(5), ` stroke="${T(24)}" stroke-width="0.7"`);
    for (const z of [0.9, 1.55, 2.2]) o += wallY(bx, z, 2.1, 0.06, T(30));
    for (const z of [0.98, 1.63]) {
      for (let k = 0; k < 5; k++) o += wallY(bx + 0.12 + k * 0.38, z, 0.24, 0.28, T(36 + (k % 3) * 9));
    }
  }
  o += seg(iso(RM, 0, 1.0, 2.5), iso(RM, 0, 3.4, 2.5), T(34), 1.6);
  for (const hy of [1.2, 1.6, 2.0, 2.45, 2.9] as number[]) {
    o += seg(iso(RM, 0, hy, 2.5), iso(RM, 0, hy, 1.7), T(24), 0.7);
    o += wallX(hy - 0.09, 1.35, 0.2, 0.34, T(30));
  }
  o += solid(0.4, 3.9, 0, 2.2, 0.8, 0.85);
  o += solid(0.65, 4.05, 0.85, 0.6, 0.45, 0.38, 46, 34, 24);
  return o;
};

const startupRoom = () => {
  let o = shell();
  for (const sx of [0.5, 2.4, 4.3] as number[]) {
    o += solid(sx, 0.35, 0, 1.35, 0.85, 0.68);
    o += pg(frontFace(RM, sx + 0.35, 1.2, 0.68, 0.62, 0.46), T(8));
    o += pg(frontFace(RM, sx + 0.4, 1.2, 0.72, 0.52, 0.37), T(32));
    o += solid(sx + 0.42, 1.14, 0.68, 0.5, 0.06, 0.03, 34, 24, 16);
    o += solid(sx + 0.25, 0.45, 0.68, 0.5, 0.3, 0.04, 26, 18, 12);
    o += dot(iso(RM, sx + 0.67, 0.8, RH), 3.6, T(30));
  }
  o += wallY(1.1, 1.4, 3.6, 1.9, T(5), ` stroke="${T(34)}" stroke-width="1"`);
  for (let i = 0; i < 4; i++) o += wallY(1.4, 2.85 - i * 0.34, 2.7 - i * 0.28, 0.07, T(26));
  o += solid(0.2, 3.9, 0, 0.5, 0.5, 0.28, 20, 13, 8);
  o += solid(0.28, 3.98, 0.28, 0.34, 0.34, 0.55, 26, 17, 11);
  return o;
};

const ROOMS: Record<string, () => string> = {
  "01": clinicRoom,
  "02": cafeRoom,
  "03": salonRoom,
  "04": pharmacyRoom,
  "05": shopRoom,
  "06": startupRoom,
};

const span = String(clientTypes.length).padStart(2, "0");
---

<section class="section" id="who" aria-labelledby="who-h">
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="Who it's for"
      sublabel="ORDER TYPES"
      kicker={`TYPES / 01–${span} · CLICK A SPACE TO STEP INSIDE`}
      id="who-h"
    />

    <div class="dist" data-district>
      <div class="dist__bar mono">
        <span>THE OPEN BOX — DISTRICT 01</span>
        <span class="dist__code" data-status>{span} SPACES · TAP ONE TO ENTER</span>
      </div>

      <div class="dist__stage" data-stage>
      {/* THE BUILDING — static isometric SVG, drawn at build time.
          NOT aria-hidden: it contains real focusable links, and hiding a
          container while leaving its links focusable is a keyboard trap
          (axe: aria-hidden-focus). Each block is named by its <title>, and
          the directory below is the same six spaces reached another way.
          Each block is a real <a> so it is focusable and keyboard-operable;
          the prototype used <g onClick> and was mouse-only. Without
          JavaScript the anchor still jumps to that space's row below. */}
      <div class="iso" data-city>
        <svg
          class="iso__svg"
          viewBox="-196 -118 510 360"
          role="group"
          aria-label="District map. The same six spaces are listed below."
        >
          {/* plinth */}
          <polygon points={sideFace(CAM, COL * 2 + UNIT.w + 0.5, -0.5, 0, ROW[1] + UNIT.d + 1, PLINTH)} class="iso-plinth-s" />
          <polygon points={frontFace(CAM, -0.5, ROW[1] + UNIT.d + 0.5, 0, COL * 2 + UNIT.w + 1, PLINTH)} class="iso-plinth-f" />
          <polygon points={topFace(CAM, -0.5, -0.5, PLINTH, COL * 2 + UNIT.w + 1, ROW[1] + UNIT.d + 1)} class="iso-plinth-t" />

          {
            drawOrder.map((b) => (
              <a href={`#space-${b.type.key}`} class="iso__block" data-iso={b.type.key}>
                <title>{b.type.name}</title>
                <polygon points={sideFace(CAM, b.x + UNIT.w, b.y, PLINTH, UNIT.d, b.h)} class="iso-side" />
                <polygon points={frontFace(CAM, b.x, b.y + UNIT.d, PLINTH, UNIT.w, b.h)} class="iso-front" />
                <polygon points={topFace(CAM, b.x, b.y, PLINTH + b.h, UNIT.w, UNIT.d)} class="iso-top" />

                {/* lit windows — brighter than the wall they sit in */}
                {[0.75, 1.75, 2.75].map((wz) =>
                  wz + 0.5 < b.h
                    ? [0.35, 1.3, 2.2].map((wx) => (
                        <polygon
                          points={frontFace(CAM, b.x + wx, b.y + UNIT.d, PLINTH + wz, 0.45, 0.4)}
                          class="iso-win"
                        />
                      ))
                    : null,
                )}

                {/* roof outline picks the block out of the skyline */}
                <polygon points={topFace(CAM, b.x, b.y, PLINTH + b.h, UNIT.w, UNIT.d)} class="iso-cap" />

                <text
                  x={iso(CAM, b.x + UNIT.w / 2 - UNIT.d / 4, b.y + UNIT.d / 4, PLINTH + b.h + 0.42)[0]}
                  y={iso(CAM, b.x + UNIT.w / 2 - UNIT.d / 4, b.y + UNIT.d / 4, PLINTH + b.h + 0.42)[1]}
                  class="iso-code"
                >
                  {b.type.key}
                </text>
              </a>
            ))
          }
        </svg>
      </div>

      <div class="dist__grid" data-grid>
        {
          clientTypes.map((c, i) => (
            <details class="dist__space" data-space id={`space-${c.key}`} style={`--i:${i}`}>
              <summary class="dist__block">
                <span class="dist__icon" aria-hidden="true" set:html={ICONS[c.key]} />
                <span class="dist__n mono">{c.key}</span>
                <span class="dist__name">{c.name}</span>
                <span class="visually-hidden">{c.line}</span>
              </summary>

              <div class="dist__panel">
                {/* THE INTERIOR — the same room the prototype drew, in tone
                    instead of neon. Decorative: role="img" names it, and the
                    zone list beneath is the actual information. */}
                <figure class="dist__roomwrap">
                  <svg
                    class="dist__room"
                    viewBox="-177 -164 388 358"
                    role="img"
                    aria-label={`Cutaway of a typical ${c.name.toLowerCase()} space.`}
                    set:html={ROOMS[c.key]?.() ?? ""}
                  />
                </figure>

                {/* the slip that sits under the room — name, what it is,
                    what the site contains, and the way back */}
                <div class="dist__info">
                  <div class="dist__infomain">
                    <p class="dist__infoname">{c.name}</p>
                    <p class="dist__line">{c.line}</p>
                  </div>
                  <ul class="dist__zonelist mono">
                    {c.sections.map((sec) => (
                      <li>{sec.label}</li>
                    ))}
                  </ul>
                  <button class="dist__back mono" type="button" data-back>
                    ◂ BACK
                  </button>
                </div>
              </div>
            </details>
          ))
        }
      </div>
      </div>
    </div>

    <p class="wt__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  /* ---- the plate: permanently inverted, like the inside of the hero box ---- */
  .dist {
    background: var(--interior);
    color: var(--interior-ink);
    border: var(--hair-strong) solid var(--interior-ink);
    border-radius: 3px;
    overflow: hidden;
  }
  .dist__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: var(--hair) solid var(--interior-line);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .dist__code {
    transition: opacity 0.15s var(--ease);
  }

  /* ---- the isometric building ----
     Faces are all currentColor at different opacities, so the whole scene
     inverts with the plate: no second palette, no per-block hue. */
  .iso {
    padding: clamp(0.5rem, 2vw, 1.2rem) clamp(0.5rem, 2vw, 1rem) 0;
  }
  .iso__svg {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    margin-inline: auto;
    color: var(--interior-ink);
    overflow: visible;
  }
  /* Faces must be OPAQUE. The prototype relied on the painter's algorithm —
     near blocks physically covering far ones — and semi-transparent fills
     defeat it: every roof shows through every other block and the skyline
     reads as sheets of glass. color-mix keeps them opaque while still
     resolving against the plate, so the scene inverts without a palette. */
  .iso-plinth-t { fill: color-mix(in oklab, var(--interior-ink) 9%, var(--interior)); }
  .iso-plinth-f { fill: color-mix(in oklab, var(--interior-ink) 14%, var(--interior)); }
  .iso-plinth-s { fill: color-mix(in oklab, var(--interior-ink) 6%, var(--interior)); }

  .iso__block { cursor: pointer; }
  /* Every face also carries a hairline edge. Tonal separation alone is not
     enough on a near-black ground — without the edges the roof reads as a
     bright plane floating clear of an invisible facade. */
  .iso-top,
  .iso-front,
  .iso-side {
    stroke: color-mix(in oklab, var(--interior-ink) 30%, var(--interior));
    stroke-width: 0.7;
    transition: fill 0.18s var(--ease), stroke 0.18s var(--ease);
  }
  .iso-top   { fill: color-mix(in oklab, var(--interior-ink) 34%, var(--interior)); }
  .iso-front { fill: color-mix(in oklab, var(--interior-ink) 20%, var(--interior)); }
  .iso-side  { fill: color-mix(in oklab, var(--interior-ink) 11%, var(--interior)); }
  .iso-win   { fill: color-mix(in oklab, var(--interior-ink) 50%, var(--interior)); transition: fill 0.18s var(--ease); }
  .iso-cap {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.42;
    stroke-width: 0.9;
    transition: stroke-opacity 0.18s var(--ease);
  }
  .iso-code {
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-anchor: middle;
    fill: currentColor;
    fill-opacity: 0.45;
    transition: fill-opacity 0.18s var(--ease);
  }

  .iso__block:hover .iso-top,
  .iso__block:hover .iso-front,
  .iso__block:hover .iso-side,
  .iso__block:focus-visible .iso-top,
  .iso__block:focus-visible .iso-front,
  .iso__block:focus-visible .iso-side,
  .iso__block.is-active .iso-top,
  .iso__block.is-active .iso-front,
  .iso__block.is-active .iso-side { stroke: var(--interior-ink); }
  .iso__block:hover .iso-top,
  .iso__block:focus-visible .iso-top,
  .iso__block.is-active .iso-top { fill: color-mix(in oklab, var(--interior-ink) 52%, var(--interior)); }
  .iso__block:hover .iso-front,
  .iso__block:focus-visible .iso-front,
  .iso__block.is-active .iso-front { fill: color-mix(in oklab, var(--interior-ink) 33%, var(--interior)); }
  .iso__block:hover .iso-side,
  .iso__block:focus-visible .iso-side,
  .iso__block.is-active .iso-side { fill: color-mix(in oklab, var(--interior-ink) 19%, var(--interior)); }
  .iso__block:hover .iso-win,
  .iso__block:focus-visible .iso-win,
  .iso__block.is-active .iso-win { fill: color-mix(in oklab, var(--interior-ink) 72%, var(--interior)); }
  .iso__block:hover .iso-cap,
  .iso__block:focus-visible .iso-cap { stroke-opacity: 1; }
  .iso__block:hover .iso-code,
  .iso__block:focus-visible .iso-code { fill-opacity: 1; }
  .iso__block:focus-visible { outline: none; }

  /* the block whose space is open stays lit — the building is a live map */
  .iso__block.is-active .iso-cap { stroke-opacity: 1; }
  .iso__block.is-active .iso-code { fill-opacity: 1; }

  /* ---- THE STAGE ----
     City and interior occupy the SAME box and cross-fade, so opening a space
     never changes the page height. All of this is scoped to html.js: without
     JavaScript the stage is not a stage, it is an ordinary disclosure list
     that flows down the page as normal. */
  .dist__grid {
    display: flex;
    flex-direction: column;
    border-top: var(--hair) solid var(--interior-line);
  }

  :global(html.js) .dist__stage {
    position: relative;
    height: clamp(25rem, 46vw, 34rem);
  }
  :global(html.js) .iso {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(0.5rem, 2vw, 1rem);
    transition:
      opacity 0.34s var(--ease),
      transform 0.34s var(--ease);
  }
  :global(html.js) .dist__grid {
    position: absolute;
    inset: 0;
    border-top: 0;
    /* This layer covers the city, so it must be click-through: only the open
       space takes pointer events back. Without this the whole building is
       unclickable — the container swallows every click. */
    pointer-events: none;
  }
  :global(html.js) .dist__space {
    position: absolute;
    inset: 0;
    border-bottom: 0;
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
    transition:
      opacity 0.34s var(--ease),
      transform 0.34s var(--ease);
  }
  :global(html.js) .dist__space[open] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* the building steps back as the room comes forward */
  :global(html.js) .dist__stage[data-open] .iso {
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
  }
  /* with JS the building blocks are the control, so the row is not needed —
     removed from layout AND from the tab order, not just hidden */
  :global(html.js) summary.dist__block {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .iso,
    :global(html.js) .dist__space {
      transition-duration: 0.01ms;
      transform: none;
    }
  }

  /* ---- the interior: room fills the stage, slip pinned beneath ---- */
  .dist__panel {
    display: flex;
    flex-direction: column;
    padding: clamp(0.6rem, 2vw, 1rem);
  }
  /* height:100% does NOT work here: <details> does not establish a definite
     containing block for its content, so the percentage silently resolves to
     auto and the panel grows to its natural height, pushing the slip out of
     the stage. Pinning it to the space gives it a real box. */
  :global(html.js) .dist__panel {
    position: absolute;
    inset: 0;
  }
  .dist__roomwrap {
    flex: 1;
    min-height: 0;
    margin: 0;
    display: grid;
    place-items: center;
  }
  .dist__room {
    display: block;
    /* A definite box, not auto: an SVG with height:auto resolves to its full
       intrinsic height and overruns the stage, taking the slip off-screen
       with it. Given a real box, preserveAspectRatio letterboxes it to fit. */
    width: 100%;
    height: 100%;
    color: var(--interior-ink);
  }

  .dist__info {
    flex: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: var(--hair) dashed var(--interior-line);
  }
  .dist__infoname {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.2rem;
  }
  .dist__line {
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.78;
    max-width: 52ch;
    margin: 0;
  }
  .dist__zonelist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dist__zonelist li {
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.32em 0.55em;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }
  .dist__back {
    justify-self: start;
    background: none;
    border: var(--hair) solid var(--interior-line);
    border-radius: 2px;
    padding: 0.45em 0.8em;
    cursor: pointer;
    color: inherit;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    transition: background 0.15s var(--ease);
  }
  .dist__back:hover,
  .dist__back:focus-visible {
    background: var(--interior-line);
  }

  @media (min-width: 720px) {
    .dist__info {
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 1.2rem;
    }
  }

  .wt__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .wt__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .wt__note a:hover {
    color: var(--accent-text);
  }
</style>

<script>
  /* Enforce "one space open at a time" and drive the status line — the pure
     progressive-enhancement layer. The <details> elements work correctly
     with none of this: multiple can open at once, no dimming, no status
     text update. Nothing here is required for the content to be reachable. */
  function initDistrict() {
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const status = document.querySelector<HTMLElement>("[data-status]");
    if (!grid) return;
    const spaces = Array.from(grid.querySelectorAll<HTMLDetailsElement>(".dist__space"));
    const defaultStatus = status?.textContent ?? "";

    const isoBlocks = Array.from(document.querySelectorAll<SVGAElement>("[data-iso]"));

    const stage = document.querySelector<HTMLElement>("[data-stage]");

    const sync = () => {
      const open = spaces.find((d) => d.open);
      // the stage carries the state: it is what cross-fades the city out
      stage?.toggleAttribute("data-open", Boolean(open));
      grid.toggleAttribute("data-open", Boolean(open));
      // the building doubles as a live map: light the block that is open
      isoBlocks.forEach((a) =>
        a.classList.toggle("is-active", Boolean(open) && `space-${a.dataset.iso}` === open!.id),
      );
      if (status) {
        const name = open?.querySelector<HTMLElement>(".dist__name")?.textContent;
        status.textContent = name ? `INSIDE — ${name.toUpperCase()}` : defaultStatus;
      }
    };

    spaces.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) spaces.forEach((other) => other !== d && (other.open = false));
        sync();
      });
    });

    // Clicking a block opens its space instead of jumping the page. With no
    // JavaScript the anchor's default still lands on that row, which is
    // visible and readable whether or not it is expanded.
    isoBlocks.forEach((a) => {
      a.addEventListener("click", (e) => {
        const target = document.getElementById(`space-${a.dataset.iso}`) as HTMLDetailsElement | null;
        if (!target) return;
        e.preventDefault();
        target.open = true;
        // the summary is display:none under JS, so send focus to the way out
        target.querySelector<HTMLElement>("[data-back]")?.focus({ preventScroll: true });
      });
    });

    grid.addEventListener("click", (e) => {
      const back = (e.target as HTMLElement).closest("[data-back]");
      if (!back) return;
      e.preventDefault();
      const d = back.closest("details") as HTMLDetailsElement | null;
      if (d) {
        d.open = false;
        document.querySelector<SVGAElement>(`[data-iso="${d.id.replace("space-", "")}"]`)?.focus();
      }
    });
  }
  if (document.readyState !== "loading") initDistrict();
  else document.addEventListener("DOMContentLoaded", initDistrict);
</script>
