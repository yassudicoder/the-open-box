---
/* =============================================================================
   01 / WHO IT'S FOR — THE DISTRICT

   A blueprint of a small business district: six numbered spaces, one icon
   each. Click a space and it takes over the frame — the others step back —
   showing what a site for that business actually has to contain.

   Built on the same idea as the "inside the box" moment in the hero: this
   frame is permanently inverted (--interior / --interior-ink), the same
   pair DemoContinue.astro uses for its own always-dark capsule, regardless
   of which theme the rest of the page is in. Stepping into the district
   uses the one inversion trick this site already has, rather than
   inventing a second one.

   Mechanism is still native <details>/<summary> — same foundation as the
   manifest list this replaces, so it stays keyboard-operable, readable by
   assistive tech with no ARIA patching, and every space's full name and
   description stay in the DOM for search engines whether or not JavaScript
   ever runs. What's new is on top: a script enforces "one space open at a
   time" and drives the zoom-in/step-back choreography. Without JavaScript,
   the mechanism still opens and closes (multiple at once, no animation) —
   informationally complete either way, since the full description ships
   as accessible text on every closed block, not just the open one.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { clientTypes } from "../../data/services.ts";

function icon(path: string) {
  return `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
}

/* one line-art mark per space — the district's only illustration budget */
const ICONS: Record<string, string> = {
  "01": icon('<path d="M16 8v16M8 16h16"/>'), // clinic — a plain cross
  "02": icon('<path d="M9 13h13v3a6.5 6.5 0 0 1-6.5 6.5H15A6.5 6.5 0 0 1 9 16v-3Z"/><path d="M22 14h2.5a3 3 0 0 1 0 6H22"/><path d="M13 8c0-1.2.8-1.4.8-2.6M17 8c0-1.2.8-1.4.8-2.6"/>'), // cafe — cup + handle + steam
  "03": icon('<circle cx="10" cy="9" r="2.6"/><circle cx="10" cy="23" r="2.6"/><path d="M12 10.8 24 22M24 10l-9 8.3M12 21.2l3-2.8"/>'), // salon — scissors
  "04": icon('<rect x="9" y="12" width="8" height="14" rx="4"/><path d="M13 12V9a4 4 0 0 1 8 0v3"/><path d="M13 19h4"/>'), // pharmacy — capsule
  "05": icon('<path d="M9 12h14l-1.3 13.2a2 2 0 0 1-2 1.8H12.3a2 2 0 0 1-2-1.8L9 12Z"/><path d="M12.5 12V9.5a3.5 3.5 0 0 1 7 0V12"/>'), // shop — bag
  "06": icon('<rect x="6" y="8" width="20" height="13" rx="1.5"/><path d="M12 25h8M16 21v4"/>'), // startup — screen
};

/* ---------------------------------------------------------------------------
   THE FLOOR PLAN, GENERATED FROM DATA.

   Each business type already carries its page sections with a width weight.
   That IS a room schedule, so the plan is computed from it rather than drawn
   by hand: the first section (always w:100 — "THE PLACE", "WHO YOU ARE") is
   the primary room down the left, the rest stack to the right with heights
   proportional to their weights. A seventh business type gets a plan for
   free; nobody has to draw one.
   ------------------------------------------------------------------------ */
interface Room {
  label: string;
  n: string;
  x: number;
  y: number;
  w: number;
  h: number;
}
/* The viewBox is taller than the building: the strip under the shell is the
   drawing's title block (ENTRY / FIG. no.), so captions never sit on a wall. */
const VB = { w: 230, h: 148 };
const PAD = 9; // room area inset from the viewBox
const INNER_H = 115; // room area height — the building, not the title block
const WALL = 2.4; // interior partition thickness
const SHELL = { x: PAD - 3, y: PAD - 3, w: VB.w - (PAD - 3) * 2, h: INNER_H + 6 };
const SHELL_B = SHELL.y + SHELL.h; // outer bottom wall — the door sits here
const CAP_Y = SHELL_B + 12; // title-block baseline, clear of the wall

function floorPlan(sections: { label: string; w: number }[]): Room[] {
  const innerW = VB.w - PAD * 2;
  const innerH = INNER_H;
  const [primary, ...rest] = sections;
  const num = (i: number) => String(i + 1).padStart(2, "0");

  if (!primary) return [];
  if (!rest.length) {
    return [{ label: primary.label, n: num(0), x: PAD, y: PAD, w: innerW, h: innerH }];
  }

  const leftW = Math.round(innerW * 0.53);
  const rightW = innerW - leftW - WALL;
  const rooms: Room[] = [
    { label: primary.label, n: num(0), x: PAD, y: PAD, w: leftW, h: innerH },
  ];

  const total = rest.reduce((sum, r) => sum + r.w, 0) || 1;
  const avail = innerH - WALL * (rest.length - 1);
  let y = PAD;
  rest.forEach((r, i) => {
    const last = i === rest.length - 1;
    // the last room absorbs rounding so the right column always closes flush
    const h = last ? PAD + innerH - y : Math.round((avail * r.w) / total);
    rooms.push({ label: r.label, n: num(i + 1), x: PAD + leftW + WALL, y, w: rightW, h });
    y += h + WALL;
  });
  return rooms;
}

const span = String(clientTypes.length).padStart(2, "0");
---

<section class="section" id="who" aria-labelledby="who-h">
  <div class="wrap">
    <SectionHeader
      index="01"
      glyph="⌀"
      title="Who it's for"
      sublabel="ORDER TYPES"
      kicker={`TYPES / 01–${span} · CLICK A SPACE TO STEP INSIDE`}
      id="who-h"
    />

    <div class="dist" data-district>
      <div class="dist__bar mono">
        <span>THE OPEN BOX — DISTRICT 01</span>
        <span class="dist__code" data-status>{span} SPACES · TAP ONE TO ENTER</span>
      </div>

      <div class="dist__grid" data-grid>
        {
          clientTypes.map((c, i) => (
            <details class="dist__space" data-space style={`--i:${i}`}>
              <summary class="dist__block">
                <span class="dist__icon" aria-hidden="true" set:html={ICONS[c.key]} />
                <span class="dist__n mono">{c.key}</span>
                <span class="dist__name">{c.name}</span>
                <span class="visually-hidden">{c.line}</span>
              </summary>

              <div class="dist__panel">
                <p class="dist__line">{c.line}</p>

                {/* The plan is decorative-but-labelled: its own <text> is
                    readable, and the linearised list below guarantees the
                    same information for assistive tech and crawlers. */}
                <figure class="dist__planwrap">
                  <svg
                    class="dist__plan"
                    viewBox={`0 0 ${VB.w} ${VB.h}`}
                    role="img"
                    aria-label={`Typical floor plan for ${c.name}: ${c.sections.map((s) => s.label.toLowerCase()).join(", ")}.`}
                  >
                    {/* outer shell */}
                    <rect x={SHELL.x} y={SHELL.y} width={SHELL.w} height={SHELL.h} class="pl-shell" />
                    {floorPlan(c.sections).map((r) => (
                      <g>
                        <rect x={r.x} y={r.y} width={r.w} height={r.h} class="pl-room" />
                        <text x={r.x + 4.5} y={r.y + 8.5} class="pl-n">{r.n}</text>
                        <text x={r.x + 4.5} y={r.y + 15.5} class="pl-label">{r.label}</text>
                      </g>
                    ))}
                    {/* entry: a gap punched in the bottom wall + a swinging leaf */}
                    <g class="pl-door">
                      <line x1="26" y1={SHELL_B} x2="40" y2={SHELL_B} class="pl-gap" />
                      <line x1="26" y1={SHELL_B} x2="26" y2={SHELL_B - 14} />
                      <path d={`M26 ${SHELL_B - 14} A 14 14 0 0 1 40 ${SHELL_B}`} />
                    </g>
                    {/* title block */}
                    <text x={SHELL.x} y={CAP_Y} class="pl-note">ENTRY ↑</text>
                    <text x={SHELL.x + SHELL.w} y={CAP_Y} class="pl-note pl-note--end">
                      FIG. 01.{c.key} — TYPICAL PLAN
                    </text>
                  </svg>
                </figure>

                <p class="visually-hidden">
                  Typical build: {c.sections.map((s) => s.label.toLowerCase()).join(", ")}.
                </p>

                <button class="dist__back mono" type="button" data-back>
                  ◂ BACK TO THE DISTRICT
                </button>
              </div>
            </details>
          ))
        }
      </div>
    </div>

    <p class="wt__note mono">
      <span class="glyph accent" aria-hidden="true">⌀</span>
      NOT ON THE LIST? THE SHAPE CHANGES, THE PROCESS DOESN'T —
      <a href="#brief">TELL ME WHAT YOU RUN <span aria-hidden="true">▸</span></a>
    </p>
  </div>
</section>

<style>
  /* ---- the plate: permanently inverted, like the inside of the hero box ---- */
  .dist {
    background: var(--interior);
    color: var(--interior-ink);
    border: var(--hair-strong) solid var(--interior-ink);
    border-radius: 3px;
    overflow: hidden;
  }
  .dist__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: var(--hair) solid var(--interior-line);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .dist__code {
    transition: opacity 0.15s var(--ease);
  }

  .dist__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .dist__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---- closed: a district block ----
     Each cell borders itself, rather than the grid showing a background
     through a gap — an uneven last row (5 closed cells in a 3-col grid,
     once one has popped out to full width) would otherwise leave one
     truly empty grid cell, and an empty cell paints the CONTAINER's
     background with nothing drawn over it: a stray solid block where a
     7th space should be but isn't. Self-bordered cells can't do that;
     an empty track next to them just stays the page's own background. */
  .dist__space {
    background: var(--interior);
    border: var(--hair) solid var(--interior-line);
    margin: 0 calc(-1 * var(--hair)) calc(-1 * var(--hair)) 0;
    order: var(--i);
  }
  summary.dist__block {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: clamp(1.3rem, 4vw, 1.9rem) 0.8rem;
    text-align: center;
    transition: background 0.15s var(--ease), opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  summary.dist__block::-webkit-details-marker {
    display: none;
  }
  summary.dist__block::marker {
    content: "";
  }
  summary.dist__block:hover,
  summary.dist__block:focus-visible {
    background: var(--interior-line);
  }
  summary.dist__block:focus-visible {
    outline: 2px solid var(--interior-ink);
    outline-offset: -2px;
  }
  .dist__icon {
    width: 30px;
    height: 30px;
    opacity: 0.92;
  }
  .dist__icon svg {
    width: 100%;
    height: 100%;
  }
  .dist__n {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    opacity: 0.6;
  }
  .dist__name {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.25;
    max-width: 14ch;
  }

  /* when any space is open, the rest step back — dimmed, inert, not gone */
  .dist__grid[data-open] .dist__space:not([open]) summary.dist__block {
    opacity: 0.32;
    transform: scale(0.94);
  }
  .dist__grid[data-open] .dist__space:not([open]) summary.dist__block:hover {
    opacity: 0.6;
    transform: none;
  }

  /* ---- open: the space takes the whole frame, moves to the front ---- */
  .dist__space[open] {
    grid-column: 1 / -1;
    order: -1;
  }
  .dist__space[open] summary.dist__block {
    flex-direction: row;
    text-align: left;
    justify-content: flex-start;
    gap: 0.9rem;
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    border-bottom: var(--hair) dashed var(--interior-line);
  }
  .dist__space[open] .dist__icon {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .dist__space[open] .dist__name {
    font-size: 1rem;
    max-width: none;
  }

  .dist__panel {
    padding: clamp(1.1rem, 3vw, 1.6rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dist__space[open] .dist__panel {
      animation: dist-in 0.28s var(--ease-out);
    }
  }
  @keyframes dist-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .dist__line {
    font-size: 0.94rem;
    line-height: 1.55;
    max-width: 52ch;
    margin: 0 0 1.2rem;
  }
  /* ---- the generated floor plan ---- */
  .dist__planwrap {
    margin: 0 0 1.3rem;
  }
  .dist__plan {
    display: block;
    width: 100%;
    max-width: 38rem;
    height: auto;
    overflow: visible;
    color: var(--interior-ink);
  }
  /* Everything is currentColor, so the plan inverts with the plate and needs
     no second palette — white-on-black in light mode, black-on-white in dark. */
  .dist__plan .pl-shell {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .dist__plan .pl-room {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.7;
    opacity: 0.55;
  }
  .dist__plan .pl-n {
    font-family: var(--font-mono);
    font-size: 4.4px;
    letter-spacing: 0.1em;
    fill: currentColor;
    opacity: 0.5;
  }
  .dist__plan .pl-label {
    font-family: var(--font-mono);
    font-size: 5.2px;
    font-weight: 600;
    letter-spacing: 0.06em;
    fill: currentColor;
  }
  .dist__plan .pl-door {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.75;
  }
  /* the doorway itself: erase the shell wall behind the swing */
  .dist__plan .pl-gap {
    stroke: var(--interior);
    stroke-width: 2.2;
    opacity: 1;
  }
  .dist__plan .pl-note {
    font-family: var(--font-mono);
    font-size: 4.2px;
    letter-spacing: 0.16em;
    fill: currentColor;
    opacity: 0.5;
  }
  .dist__plan .pl-note--end {
    text-anchor: end;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dist__space[open] .dist__plan .pl-room {
      animation: pl-draw 0.4s var(--ease-out) backwards;
    }
    .dist__space[open] .dist__plan g:nth-of-type(2) .pl-room { animation-delay: 0.05s; }
    .dist__space[open] .dist__plan g:nth-of-type(3) .pl-room { animation-delay: 0.1s; }
    .dist__space[open] .dist__plan g:nth-of-type(4) .pl-room { animation-delay: 0.15s; }
  }
  @keyframes pl-draw {
    from { opacity: 0; }
  }
  .dist__back {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    opacity: 0.7;
    transition: opacity 0.15s var(--ease);
  }
  .dist__back:hover,
  .dist__back:focus-visible {
    opacity: 1;
  }

  .wt__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--label-aa);
  }
  .wt__note a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: var(--hair-strong) solid var(--accent-text);
    padding-bottom: 0.1em;
    transition: color 0.15s var(--ease);
  }
  .wt__note a:hover {
    color: var(--accent-text);
  }
</style>

<script>
  /* Enforce "one space open at a time" and drive the status line — the pure
     progressive-enhancement layer. The <details> elements work correctly
     with none of this: multiple can open at once, no dimming, no status
     text update. Nothing here is required for the content to be reachable. */
  function initDistrict() {
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const status = document.querySelector<HTMLElement>("[data-status]");
    if (!grid) return;
    const spaces = Array.from(grid.querySelectorAll<HTMLDetailsElement>(".dist__space"));
    const defaultStatus = status?.textContent ?? "";

    const sync = () => {
      const open = spaces.find((d) => d.open);
      grid.toggleAttribute("data-open", Boolean(open));
      if (status) {
        const name = open?.querySelector<HTMLElement>(".dist__name")?.textContent;
        status.textContent = name ? `INSIDE — ${name.toUpperCase()}` : defaultStatus;
      }
    };

    spaces.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) spaces.forEach((other) => other !== d && (other.open = false));
        sync();
      });
    });

    grid.addEventListener("click", (e) => {
      const back = (e.target as HTMLElement).closest("[data-back]");
      if (!back) return;
      e.preventDefault();
      const d = back.closest("details") as HTMLDetailsElement | null;
      if (d) {
        d.open = false;
        d.querySelector("summary")?.focus();
      }
    });
  }
  if (document.readyState !== "loading") initDistrict();
  else document.addEventListener("DOMContentLoaded", initDistrict);
</script>
