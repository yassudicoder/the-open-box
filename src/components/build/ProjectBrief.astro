    font-size: clamp(1.02rem, 0.95rem + 0.5vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink);
    max-width: 54ch;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }

  .pb {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.6rem, 4vw, 3rem);
    align-items: start;
  }

  /* Honeypot. position:absolute + left:-9999px rather than display:none,
     because some bots skip fields that are display:none. */
  .pb__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---- fields ---- */
  .pb__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
