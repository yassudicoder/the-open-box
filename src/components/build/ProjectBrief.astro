    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.95rem;
    border-top: var(--hair) dashed var(--line-2);
  }
  .pb__terms div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .pb__terms dt {
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    color: var(--label-aa);
  }
  .pb__terms dd {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.5;
  }

  @media (min-width: 620px) {
    .pb__grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem clamp(1rem, 3vw, 1.6rem);
    }
    .fld--full {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1000px) {
    .pb {
      grid-template-columns: 1.25fr 0.85fr;
    }
    .pb__side {
      position: sticky;
      top: calc(var(--masthead-h, 56px) + 1rem);
    }
  }
</style>

<script>
  /* ---------------------------------------------------------------------------
     The brief is composed here and POSTed to this site's own /api/brief, which
     emails it to the studio. The visitor stays on the page.

     The one rule this file is built around: NEVER LOSE AN ENQUIRY. If the
     endpoint is absent (404), unconfigured (501), refusing (5xx) or the network
     is down, we fall back to opening the same brief in the visitor's mail app
     rather than showing them a dead end.
     ------------------------------------------------------------------------ */
  const MAIL_SUBJECT = "Project enquiry — via The Open Box";
  const ENDPOINT = "/api/brief";

  const FIELDS = ["name", "business", "type", "need", "timing", "budget", "existing", "reply_to", "message"];

  function field(form: HTMLFormElement, name: string): string {
    const el = form.elements.namedItem(name) as
      | HTMLInputElement
      | HTMLSelectElement
      | HTMLTextAreaElement
      | null;
    return el && "value" in el ? el.value.trim() : "";
  }

  /** The brief, as plain text. Blank fields are simply left out. */
  function compose(form: HTMLFormElement): string {
    const rows: [string, string][] = ([
      ["Name", field(form, "name")],
      ["Business", field(form, "business")],
      ["Type", field(form, "type")],
      ["Needs", field(form, "need")],
      ["Timing", field(form, "timing")],
      ["Budget", field(form, "budget")],
      ["Existing site", field(form, "existing")],
      ["Reach me at", field(form, "reply_to")],
    ] as [string, string][]).filter(([, v]) => v.length > 0);

    const width = rows.reduce((w, [k]) => Math.max(w, k.length), 0);
    const head = rows.map(([k, v]) => `${k.padEnd(width)} : ${v}`).join("\n");
    const msg = field(form, "message");

    const parts = ["PROJECT BRIEF — THE OPEN BOX", ""];
    if (head) parts.push(head, "");
    if (msg) parts.push("WHAT THE SITE HAS TO DO", msg, "");
    parts.push("— Sent from the brief form at /build/");
    return parts.join("\n");
  }

  function mailtoHref(form: HTMLFormElement): string {
    const to = form.dataset.mail || "";
    return (
      `mailto:${to}?subject=${encodeURIComponent(MAIL_SUBJECT)}` +
      `&body=${encodeURIComponent(compose(form))}`
    );
  }

  function say(status: HTMLElement | null, text: string, tone: "info" | "warn" = "info") {
    if (!status) return;
    status.textContent = text;
    if (tone === "warn") status.setAttribute("data-tone", "warn");
    else status.removeAttribute("data-tone");
    if (!text) return;
    window.setTimeout(() => {
      if (status.textContent === text) {
        status.textContent = "";
        status.removeAttribute("data-tone");
      }
    }, 12000);
  }

  /** HTML5 validity, with focus moved to whatever is wrong. */
  function valid(form: HTMLFormElement, status: HTMLElement | null): boolean {
    if (form.checkValidity()) return true;
    form.reportValidity();
    say(status, "FILL THE STARRED FIELDS FIRST.", "warn");
    return false;
  }

  /** Swap the form for the confirmation that is already in the page. */
  function showSent(form: HTMLFormElement) {
    const panel = document.querySelector<HTMLElement>("[data-sent]");
    if (!panel) return;
    form.hidden = true;
    panel.hidden = false;
    // mark the preview as sent rather than leaving it reading DRAFT
    const pill = document.querySelector<HTMLElement>(".pb__prevlive");
    if (pill) pill.textContent = "SENT";
    panel.scrollIntoView({ behavior: "smooth", block: "center" });
    panel.focus();
  }

  function initBrief() {
    const form = document.getElementById("brief-form") as HTMLFormElement | null;
    if (!form) return;

    const preview = form.parentElement?.querySelector<HTMLElement>("[data-preview]") ?? null;
    const previewWrap = form.parentElement?.querySelector<HTMLElement>("[data-preview-wrap]") ?? null;
    const status = form.querySelector<HTMLElement>("[data-status]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const stamp = form.querySelector<HTMLInputElement>("[data-stamp]");

    // when the form became fillable — the endpoint rejects impossibly fast posts
    if (stamp) stamp.value = String(Date.now());

    // Live preview — appears as soon as there is anything to preview.
    const refresh = () => {
      if (!preview || !previewWrap) return;
      const any = FIELDS.some((n) => field(form, n).length > 0);
      previewWrap.hidden = !any;
      if (any) preview.textContent = compose(form);
    };
    form.addEventListener("input", refresh);
    form.addEventListener("change", refresh);
    refresh();

    /** Last resort: hand the same brief to the visitor's mail app. */
    const handOff = (why: string) => {
      say(status, why + " OPENING YOUR MAIL APP WITH THE BRIEF ALREADY WRITTEN.", "warn");
      window.location.href = mailtoHref(form);
    };

    let sending = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (sending) return;
      if (!valid(form, status)) return;

      sending = true;
      form.dataset.state = "sending";
      if (submitLabel) submitLabel.textContent = "SENDING";
      say(status, "SENDING THE BRIEF…");

      const payload: Record<string, string> = {};
      FIELDS.forEach((n) => (payload[n] = field(form, n)));
      payload.company_website = field(form, "company_website");
      payload.t = stamp?.value || "";

      let res: Response | null = null;
      try {
        res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
      } catch {
        res = null; // network failure
      }

      sending = false;
      form.dataset.state = "";
      if (submitLabel) submitLabel.textContent = "SEND THE BRIEF";

      if (res && res.ok) {
        showSent(form);
        return;
      }

      // 429 is the one refusal the visitor should see and act on themselves.
      if (res && res.status === 429) {
        say(status, "TOO MANY BRIEFS FROM THIS CONNECTION JUST NOW. USE COPY THE BRIEF AND EMAIL IT, OR TRY AGAIN IN A FEW MINUTES.", "warn");
        return;
      }
      if (res && res.status === 400) {
        say(status, "SOMETHING IN THE FORM WASN'T ACCEPTED — CHECK THE STARRED FIELDS.", "warn");
        return;
      }

      // 404 not deployed · 501 not configured · 5xx provider down · null network
      handOff("COULDN'T SEND FROM HERE.");
    });

    form.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-send]");
      if (!btn) return;
      const mode = btn.dataset.send;

      if (mode === "whatsapp") {
        if (!valid(form, status)) return;
        const num = (btn.dataset.wa || "").replace(/\D/g, "");
        if (!num) return;
        window.open(`https://wa.me/${num}?text=${encodeURIComponent(compose(form))}`, "_blank", "noopener");
        say(status, "OPENING WHATSAPP WITH THE BRIEF.");
        return;
      }

      if (mode === "copy") {
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        const text = compose(form);
        const done = () => {
          if (label) {
            const was = label.textContent;
            label.textContent = "COPIED";
            window.setTimeout(() => {
              label.textContent = was;
            }, 2200);
          }
          say(status, "BRIEF COPIED — PASTE IT WHEREVER YOU LIKE.");
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(text).then(done, () => {
            say(status, "COULDN'T COPY — SELECT THE PREVIEW AND COPY IT MANUALLY.", "warn");
          });
        } else {
          say(status, "COPYING ISN'T AVAILABLE HERE — SELECT THE PREVIEW INSTEAD.", "warn");
        }
      }
    });
  }

  if (document.readyState !== "loading") initBrief();
  else document.addEventListener("DOMContentLoaded", initBrief);
</script>
