---
/* =============================================================================
   07 / START A PROJECT — the brief.

   The brief SENDS ITSELF. Clicking "send the brief" posts it to this site's own
   endpoint (api/brief.js) which emails it to the studio and answers inline —
   the visitor never leaves the page and never opens a mail client.

   WHY A FIRST-PARTY ENDPOINT, NOT A FORM SERVICE:
   vercel.json sets `connect-src 'self'` and `form-action 'self'`, so a browser
   would refuse to send this form to Formspree or Web3Forms without widening
   that policy. Same-origin needs no CSP change, and the API key stays on the
   server where the browser never sees it.

   NOTHING IS LOST IF SENDING IS UNAVAILABLE. If the endpoint is missing, not
   yet configured, or the network fails, the form falls back to composing the
   same brief in the visitor's own mail app — the behaviour this section had
   before. An enquiry is never dropped on the floor.

   WITHOUT JAVASCRIPT it is still a real form: method="post" action="/api/brief",
   and the endpoint answers with an HTML confirmation page.

   The WhatsApp CTA renders only when site.build.whatsapp holds a real number.
   No contact number is invented here.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site.ts";
import { briefOptions } from "../../data/services.ts";

const wa = site.build.whatsapp.replace(/\D/g, "");
const hasWhatsApp = wa.length > 0;
const mailSubject = "Project enquiry — via The Open Box";
---

<section class="section" id="brief" aria-labelledby="brief-h">
  <div class="wrap">
    <SectionHeader
      index="06"
      glyph="✺"
      title="Have a project in mind?"
      sublabel="START A BRIEF"
      kicker="SENDS STRAIGHT TO THE STUDIO · NO FORM SERVICE · NOTHING STORED"
      id="brief-h"
    />

    <p class="pb__lead">
      Whether you're opening a clinic, running a cafe, growing a local
      business, launching a startup, or redesigning an existing website —
      let's talk about what you actually need.
    </p>

    <div class="pb">
      <!-- ---------------------------------------------------------------
           THE FORM. action is a real mailto: so it functions with JS off.
           --------------------------------------------------------------- -->
      <form
        class="pb__form"
        id="brief-form"
        action="/api/brief"
        method="post"
        data-mail={site.email}
      >
        {/* Bot traps. Neither is ever seen or focused by a person: the honeypot
            is hidden from layout AND from assistive tech, and `t` lets the
            endpoint reject a submission that arrived faster than reading. */}
        <p class="pb__trap" aria-hidden="true">
          <label for="bf-company-website">Leave this field empty</label>
          <input id="bf-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </p>
        <input type="hidden" name="t" value="" data-stamp />

        <div class="pb__grid">
          <p class="fld fld--full">
            <label class="fld__label mono" for="bf-name">
              YOUR NAME <span class="fld__req" aria-hidden="true">*</span>
            </label>
            <input
              class="fld__input"
              id="bf-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              placeholder="Who's writing"
            />
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-business">BUSINESS / PROJECT</label>
            <input
              class="fld__input"
              id="bf-business"
              name="business"
              type="text"
              autocomplete="organization"
              placeholder="Name of the place, if it has one"
            />
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-type">WHAT YOU RUN</label>
            <select class="fld__input" id="bf-type" name="type">
              <option value="">Pick one</option>
              {briefOptions.businessTypes.map((b) => <option value={b}>{b}</option>)}
            </select>
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-need">WHAT YOU NEED</label>
            <select class="fld__input" id="bf-need" name="need">
              <option value="">Pick one</option>
              {briefOptions.needs.map((n) => <option value={n}>{n}</option>)}
            </select>
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-when">WHEN</label>
            <select class="fld__input" id="bf-when" name="timing">
              <option value="">Pick one</option>
              {briefOptions.timelines.map((t) => <option value={t}>{t}</option>)}
            </select>
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-budget">BUDGET</label>
            <select class="fld__input" id="bf-budget" name="budget">
              <option value="">Pick one</option>
              {briefOptions.budgets.map((b) => <option value={b}>{b}</option>)}
            </select>
          </p>

          <p class="fld">
            <label class="fld__label mono" for="bf-site">EXISTING SITE</label>
            <input
              class="fld__input"
              id="bf-site"
              name="existing"
              type="text"
              inputmode="url"
              placeholder="Link, or leave blank"
            />
          </p>

          <p class="fld fld--full">
            <label class="fld__label mono" for="bf-msg">
              WHAT THE SITE HAS TO DO <span class="fld__req" aria-hidden="true">*</span>
            </label>
            <textarea
              class="fld__input fld__area"
              id="bf-msg"
              name="message"
              rows="5"
              required
              placeholder="A few lines is plenty. What the business is, who it's for, and what you want people to be able to do."
            ></textarea>
          </p>

          <p class="fld fld--full">
            <label class="fld__label mono" for="bf-reply">
              HOW TO REACH YOU <span class="fld__req" aria-hidden="true">*</span>
            </label>
            <input
              class="fld__input"
              id="bf-reply"
              name="reply_to"
              type="text"
              autocomplete="email"
              required
              placeholder="Email or phone — whichever you prefer"
            />
            <span class="fld__hint mono">
              GOES IN THE MESSAGE SO A REPLY LANDS SOMEWHERE YOU'LL SEE IT.
            </span>
          </p>
        </div>

        <div class="pb__actions">
          <button class="btn btn--accent" type="submit" data-send="mail">
            <span data-submit-label>SEND THE BRIEF</span>
            <span aria-hidden="true">▸</span>
          </button>

          {
            hasWhatsApp && (
              <button class="btn btn--ghost" type="button" data-send="whatsapp" data-wa={wa}>
                SEND ON WHATSAPP
              </button>
            )
          }

          <button class="btn btn--ghost" type="button" data-send="copy">
            <span data-copy-label>COPY THE BRIEF</span>
          </button>
        </div>

        <p class="pb__status mono" role="status" aria-live="polite" data-status></p>

        <p class="pb__privacy mono">
          <span class="glyph accent" aria-hidden="true">⌀</span>
          THE BRIEF GOES STRAIGHT TO {site.email.toUpperCase()} FROM THIS SITE'S
          OWN ENDPOINT — NO FORM SERVICE, NO ANALYTICS TOOL IN BETWEEN. ONCE
          IT'S SENT, IT'S GONE FROM HERE. NOTHING ABOUT YOU GETS KEPT.
        </p>
      </form>

      {/* The confirmation. In the markup rather than built in JS, because
          Astro scopes component CSS by attribute — an element created with
          createElement carries no scope id and would render unstyled. */}
      <div class="pb__sent" hidden data-sent tabindex="-1" role="status">
        <p class="pb__senth">
          <span class="pb__sentmark" aria-hidden="true">
            <svg width="13" height="10" viewBox="0 0 13 10" fill="none"
              ><path d="M1 5 L4.6 8.6 L12 1" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          BRIEF SENT
        </p>
        <p class="pb__sentbody">
          It went straight to the studio inbox. You'll get a reply within
          {" "}{site.build.replyWithin} — check your spam folder if it seems quiet.
        </p>
        <p class="pb__sentmeta mono">
          NOT STORED HERE · NOT PASSED TO A FORM SERVICE · SENT TO {site.email.toUpperCase()}
        </p>
      </div>

      <!-- ---------------------------------------------------------------
           THE PREVIEW — the exact message that will leave, live.
           --------------------------------------------------------------- -->
      <aside class="pb__side">
        <div class="pb__preview" hidden data-preview-wrap>
          <div class="pb__prevhead mono">
            <span>OUTGOING BRIEF</span>
            <span class="pb__prevlive">DRAFT</span>
          </div>
          <pre class="pb__prevbody mono" data-preview aria-live="off"></pre>
          <p class="pb__prevfoot mono">
            EXACTLY WHAT GETS SENT. NOTHING ELSE IS ATTACHED.
          </p>
        </div>

        <div class="pb__direct">
          <h3 class="pb__directh mono">OR JUST WRITE TO ME</h3>
          <ul class="pb__channels">
            <li>
              <span class="pb__chlabel mono">EMAIL</span>
              <a class="pb__chvalue" href={`mailto:${site.email}?subject=${encodeURIComponent(mailSubject)}`}>
                {site.email}
              </a>
            </li>
            {
              hasWhatsApp && (
                <li>
                  <span class="pb__chlabel mono">WHATSAPP</span>
                  <a
                    class="pb__chvalue"
                    href={`https://wa.me/${wa}`}
                    target="_blank"
                    rel="noopener"
                  >
                    +{wa}
                  </a>
                </li>
              )
            }
            <li>
              <span class="pb__chlabel mono">LINKEDIN</span>
              <a class="pb__chvalue" href={site.linkedin} target="_blank" rel="noopener">
                {site.maker}
              </a>
            </li>
          </ul>

          <dl class="pb__terms mono">
            <div>
              <dt>REPLY WITHIN</dt>
              <dd>{site.build.replyWithin.toUpperCase()}</dd>
            </div>
            <div>
              <dt>WORKING FROM</dt>
              <dd>{site.build.region.toUpperCase()}, REMOTE WORLDWIDE</dd>
            </div>
            <div>
              <dt>FIRST CALL</dt>
              <dd>FREE — SCOPE AND A PRICE, THEN YOU DECIDE</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
