---
/* =============================================================================
   03 / FROM FIGMA TO LIVE — the differentiator, made visual.

   Seven stations. A job travels along them and the artifact changes form at
   each one: a written brief becomes a structure, becomes a design, becomes a
   build, becomes a live site. The spine underneath is split DESIGN | BUILD,
   and the point of the whole section is that the same person covers both —
   so the traveller never stops at a handover.

   Runs on the same cancellable timeline runner as the product demos on the
   home page (src/scripts/demo.ts) — on screen only, pauses on hidden tabs.
   Each station is also a real <button>, so it can be driven by hand and by
   keyboard. Reduced motion / no JS: renders composed at the LIVE stage.
   ========================================================================== */
import SectionHeader from "../SectionHeader.astro";
import { pipeline } from "../../data/services.ts";
---

<section class="section" id="pipeline" aria-labelledby="pipeline-h">
  <div class="wrap">
    <SectionHeader
      index="03"
      glyph="✺"
      title="From Figma to live"
      sublabel="ONE PIPELINE · ONE PERSON"
      kicker="NO HANDOVER IN THE MIDDLE"
      id="pipeline-h"
    />

    <div class="pl fig" data-pipeline data-phase="s7">
      <span class="fig__corner fig__corner--tl" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--tr" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--bl" aria-hidden="true"></span>
      <span class="fig__corner fig__corner--br" aria-hidden="true"></span>

      <div class="fig__bar">
        <span class="fig__bar-label">FIG. 05 — THE PIPELINE</span>
        <button class="fig__replay" data-replay type="button" aria-label="Replay the pipeline">
          REPLAY ▸
        </button>
      </div>

      <div class="pl__stage">
        <!-- the stations -->
        <div class="pl__track" role="tablist" aria-label="Pipeline stages">
          {
            pipeline.map((s, i) => (
              <button
                class="pl__station"
                data-station={i}
                data-track={s.track}
                style={`--i:${i}`}
                type="button"
                role="tab"
                id={`pl-tab-${i}`}
                aria-controls="pl-panel"
                aria-selected={i === pipeline.length - 1 ? "true" : "false"}
              >
                <span class="pl__dot" aria-hidden="true"></span>
                <span class="pl__n mono">{s.n}</span>
                <span class="pl__name">{s.name}</span>
              </button>
            ))
          }
          <span class="pl__spine" aria-hidden="true">
            <span class="pl__spinefill"></span>
          </span>
        </div>

        <!-- what exists at the current station -->
        <div class="pl__panel" id="pl-panel" role="tabpanel" aria-live="polite">
          <div class="pl__paneltop">
            <span class="pl__badge mono" data-badge>BUILD</span>
            <span class="pl__stagename" data-stagename>Live</span>
          </div>
          <p class="pl__what" data-what>
            Handover, and a walkthrough of how to keep it updated.
          </p>
          <div class="pl__output">
            <span class="pl__outlabel mono">YOU END UP WITH</span>
            <span class="pl__outvalue" data-output>The site, and the keys to it</span>
          </div>

          {/* the artifact — changes shape as the job advances */}
          <div class="pl__artifact" aria-hidden="true">
            <span class="pl__frame">
              <span class="pl__browser">
                <i></i><i></i><i></i>
              </span>
              <span class="pl__sheet">
                <span class="pl__block pl__block--a"></span>
                <span class="pl__block pl__block--b"></span>
                <span class="pl__block pl__block--c"></span>
                <span class="pl__block pl__block--d"></span>
              </span>
              <span class="pl__code mono">&lt;/&gt;</span>
              <span class="pl__check" aria-hidden="true">
                <svg width="13" height="10" viewBox="0 0 13 10" fill="none"><path d="M1 5 L4.6 8.6 L12 1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </div>
        </div>
      </div>

      <div class="fig__foot">
        <span class="fig__status" data-status>DESIGN AND BUILD, THE SAME HANDS</span>
        <span>7 STATIONS · 0 HANDOVERS</span>
      </div>
    </div>

    <div class="pl__legend mono">
      <span><i class="pl__key pl__key--design"></i>DESIGN — UX, FIGMA, PROTOTYPE</span>
      <span><i class="pl__key pl__key--build"></i>BUILD — CODE, TESTING, DEPLOY</span>
    </div>
  </div>
</section>

<style>
  .pl {
    position: relative;
  }
  .pl__stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  /* ---- stations ---- */
  .pl__track {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 0.9rem;
    border-bottom: var(--hair) dashed var(--line);
  }
  .pl__station {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 16px 2.1rem 1fr;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.3rem;
    text-align: left;
    border-radius: 2px;
    color: var(--ink-3);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .pl__station:hover {
    background: var(--shade);
    color: var(--ink-2);
  }
  .pl__dot {
    width: 9px;
    height: 9px;
    margin-inline: auto;
    border: var(--hair-strong) solid var(--line-2);
    border-radius: 50%;
    background: var(--paper);
    transition: border-color 0.22s var(--ease), background 0.22s var(--ease),
      transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pl__n {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }
  .pl__name {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  /* the spine behind the dots, split design | build */
  .pl__spine {
    position: absolute;
    left: calc(0.9rem + 0.3rem + 8px);
    top: 1.1rem;
    bottom: 1.1rem;
    width: var(--hair-strong);
    background: var(--line-2);
  }
  .pl__spinefill {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: var(--fill, 100%);
    background: var(--accent);
    transition: height 0.45s var(--ease);
  }

  /* reached / current */
  .pl__station[data-reached] {
    color: var(--ink-2);
  }
  .pl__station[data-reached] .pl__dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  .pl__station[aria-selected="true"] {
    color: var(--ink);
  }
  .pl__station[aria-selected="true"] .pl__dot {
    transform: scale(1.5);
  }
  .pl__station[aria-selected="true"] .pl__name {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: var(--hair-strong);
  }

  /* ---- panel ---- */
  .pl__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 0.9rem 1.1rem;
    min-height: 232px;
  }
  .pl__paneltop {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .pl__badge {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    padding: 0.28em 0.5em;
    border-radius: 2px;
    background: var(--accent);
    color: var(--accent-ink);
    flex: none;
  }
  .pl__stagename {
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .pl__what {
    color: var(--ink-2);
    font-size: 0.94rem;
    line-height: 1.5;
    max-width: 44ch;
    min-height: 2.8em;
  }
  .pl__output {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.6rem 0.7rem;
    border: var(--hair) solid var(--line-2);
    border-left: 2px solid var(--accent);
    border-radius: 2px;
    background: var(--field);
  }
  .pl__outlabel {
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    color: var(--label-aa);
  }
  .pl__outvalue {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---- the artifact ---- */
  .pl__artifact {
    display: grid;
    place-items: center;
    padding-top: 0.3rem;
    margin-top: auto;
  }
  .pl__frame {
    position: relative;
    display: block;
    width: min(230px, 82%);
    aspect-ratio: 16 / 9;
    border: var(--hair-strong) solid var(--line-2);
    border-radius: 2px;
    background: var(--paper);
    overflow: hidden;
    transition: border-color 0.35s var(--ease);
  }
  .pl__browser {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    gap: 3px;
    height: 13px;
    padding-inline: 5px;
    border-bottom: var(--hair) solid var(--line-2);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .pl__browser i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .pl__sheet {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    transition: padding-top 0.35s var(--ease);
  }
  .pl__block {
    border: var(--hair) solid var(--line-2);
    border-radius: 1px;
    background: transparent;
    transform-origin: 0 50%;
    transition:
      transform 0.45s var(--ease-out),
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      opacity 0.3s var(--ease);
  }
  .pl__block--a { height: 26%; }
  .pl__block--b { height: 16%; width: 78%; }
  .pl__block--c { height: 16%; width: 62%; }
  .pl__block--d { height: 16%; width: 44%; }
  .pl__code {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--field);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .pl__check {
    position: absolute;
    right: 6px;
    bottom: 6px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: var(--accent);
    color: var(--accent-ink);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.25s var(--ease), transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* ---------------- artifact states, keyed off the plate's phase ------------ */
  /* s1 idea — a written brief: loose bars, nothing designed */
  [data-phase="s1"] .pl__block { transform: scaleX(0.5); opacity: 0.5; }
  /* s2 structure — the bars find their real widths */
  [data-phase="s2"] .pl__block { transform: scaleX(1); opacity: 0.75; }
  /* s3 figma — filled, designed, framed in accent */
  [data-phase="s3"] .pl__block,
  [data-phase="s4"] .pl__block,
  [data-phase="s5"] .pl__block,
  [data-phase="s6"] .pl__block,
  [data-phase="s7"] .pl__block {
    transform: scaleX(1);
    opacity: 1;
    background: var(--shade);
  }
  [data-phase="s3"] .pl__frame { border-color: var(--accent); }
  [data-phase="s3"] .pl__block--a { background: color-mix(in oklab, var(--accent) 16%, var(--field)); }
  /* s4 development — it becomes code */
  [data-phase="s4"] .pl__code { opacity: 1; }
  /* s5 testing — checked */
  [data-phase="s5"] .pl__check { opacity: 1; transform: scale(1); }
  /* s6 + s7 — a real browser frame; live */
  [data-phase="s6"] .pl__browser,
  [data-phase="s7"] .pl__browser { opacity: 1; }
  [data-phase="s6"] .pl__sheet,
  [data-phase="s7"] .pl__sheet { padding-top: 19px; }
  [data-phase="s7"] .pl__frame { border-color: var(--ink); }
  [data-phase="s7"] .pl__check { opacity: 1; transform: scale(1); }

  .pl__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 1rem;
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    color: var(--label-aa);
  }
  .pl__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .pl__key {
    width: 14px;
    height: var(--hair-strong);
    background: var(--accent);
  }
  .pl__key--design {
    background: var(--accent);
  }
  .pl__key--build {
    background: var(--ink);
  }

  @media (min-width: 800px) {
    .pl__stage {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .pl__track {
      border-bottom: 0;
      border-right: var(--hair) dashed var(--line);
      padding-block: 1.1rem;
    }
    .pl__panel {
      padding: 1.2rem 1.2rem 1.3rem;
    }
  }
</style>

<script>
  import { attachDemo } from "../../scripts/demo";
  import { pipeline } from "../../data/services.ts";

  const root = document.querySelector<HTMLElement>("[data-pipeline]");
  if (root) {
    const stations = Array.from(root.querySelectorAll<HTMLElement>("[data-station]"));
    const spine = root.querySelector<HTMLElement>(".pl__spinefill");
    const badge = root.querySelector<HTMLElement>("[data-badge]");
    const stageName = root.querySelector<HTMLElement>("[data-stagename]");
    const what = root.querySelector<HTMLElement>("[data-what]");
    const output = root.querySelector<HTMLElement>("[data-output]");
    const status = root.querySelector<HTMLElement>("[data-status]");

    const show = (i: number) => {
      const s = pipeline[i];
      if (!s) return;
      root.dataset.phase = `s${i + 1}`;
      stations.forEach((st, j) => {
        st.setAttribute("aria-selected", String(j === i));
        if (j <= i) st.setAttribute("data-reached", "");
        else st.removeAttribute("data-reached");
      });
      if (spine) spine.style.setProperty("--fill", `${(i / (pipeline.length - 1)) * 100}%`);
      if (badge) badge.textContent = s.track === "design" ? "DESIGN" : "BUILD";
      if (stageName) stageName.textContent = s.name;
      if (what) what.textContent = s.what;
      if (output) output.textContent = s.output;
    };

    // Driving it by hand pauses the auto-run: the visitor is in charge.
    let manual = false;
    stations.forEach((st, i) => {
      st.addEventListener("click", () => {
        manual = true;
        show(i);
        if (status) status.textContent = "STEPPED BY HAND — REPLAY TO RUN IT";
      });
      st.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const dir = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : -1;
        const next = Math.min(stations.length - 1, Math.max(0, i + dir));
        stations[next].focus();
        manual = true;
        show(next);
      });
    });

    root.querySelector("[data-replay]")?.addEventListener("click", () => {
      manual = false;
    });

    attachDemo(
      root,
      async (ctx) => {
        if (manual) {
          // visitor took over — idle instead of yanking the panel around
          await ctx.sleep(1200);
          return;
        }
        ctx.set(status, "A JOB, MOVING DOWN THE LINE");
        for (let i = 0; i < pipeline.length; i++) {
          if (manual) return;
          show(i);
          if (i === 2) ctx.set(status, "DESIGN SIGNED OFF — SAME HANDS CONTINUE");
          if (i === 3) ctx.set(status, "NO HANDOVER HERE — THAT'S THE POINT");
          if (i === 6) ctx.set(status, "DESIGN AND BUILD, THE SAME HANDS");
          await ctx.sleep(i === pipeline.length - 1 ? 2600 : 1500);
        }
      },
      { loopDelay: 1200 },
    );
  }
</script>
