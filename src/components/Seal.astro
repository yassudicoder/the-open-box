---
/* =============================================================================
   THE SEAL — the opening of the site and of the box. One sticky scene.

   The whole first viewport is the top face of a sealed carton: the wordmark
   printed on board, a shipping label, and a strip of signal-orange packing
   tape carrying the studio's claims. Scrolling draws a blade across the tape
   (the cut tracks scroll 1:1), the two lid flaps hinge apart, and the dark
   interior is revealed: NOTHING HIDDEN, plus the contents manifest.

   Enhancement model: the scene is scroll-driven ONLY under html.js + motion-ok.
   With reduced motion or no JS the box renders already opened — a static
   full-viewport label face (STATUS / OPEN) followed by the interior as a
   normal block. Nothing is ever trapped behind the animation.
   ========================================================================== */
import { site } from "../data/site.ts";
import { tools } from "../data/tools.ts";

const packedOn = new Date().toISOString().slice(0, 10).replace(/-/g, ".");
const shippedCount = tools.filter((t) => t.shipped).length;
const researchCount = tools.length - shippedCount;

// Tape print: the claims, repeated so the loop never shows a gap.
const tapeLine = site.claims.join("  ·  ");
const tapePrint = `${tapeLine}  ·  ${tapeLine}  ·  ${tapeLine}  ·  `;

const contents = tools.map((t) => ({
  vol: t.vol,
  codename: t.codename,
  status: t.statusLabel,
  dim: t.status === "research",
  href: `#${t.vol.toLowerCase().replace(".", "-")}`,
}));
---

<section class="seal" id="top" data-seal aria-label="The Open Box — sealed carton. Scroll to open.">
  <div class="seal__pin" data-seal-pin>
    <!-- ================= FACE (the sealed carton top) ================= -->
    <div class="seal__face" data-seal-face>
      <!-- top flap: the wordmark, printed on board -->
      <div class="seal__flap seal__flap--top">
        <div class="seal__flapinner seal__flapinner--top">
          <p class="seal__eyebrow mono">
            <span class="accent" aria-hidden="true">⌀</span>
            SOLO STUDIO · BOX / 001 · SERIES {site.volume}
          </p>
          <h1 class="seal__wordmark">The<br />Open<br />Box</h1>
          <p class="seal__edgeprint mono" aria-hidden="true">
            THIS WAY UP ↑ · DO NOT STACK · SN TOB-2026-001
          </p>
          <span class="seal__foldline seal__foldline--top" aria-hidden="true"></span>
        </div>
        <!-- upper half of the tape — printed on this flap, travels with it -->
        <div class="seal__tapehalf seal__tapehalf--top" aria-hidden="true">
          <div class="seal__tapetrack"><span>{tapePrint}</span><span>{tapePrint}</span></div>
        </div>
      </div>

      <!-- bottom flap: the shipping label -->
      <div class="seal__flap seal__flap--bottom">
        <!-- lower half of the tape -->
        <div class="seal__tapehalf seal__tapehalf--bottom" aria-hidden="true">
          <div class="seal__tapetrack"><span>{tapePrint}</span><span>{tapePrint}</span></div>
        </div>
        <div class="seal__flapinner seal__flapinner--bottom">
          <span class="seal__foldline seal__foldline--bottom" aria-hidden="true"></span>
          <div class="seal__labelrow">
            <dl class="seal__label mono" aria-label="Shipping label">
              <div class="seal__labelline">
                <dt>FROM</dt>
                <dd>{site.name.toUpperCase()} — {site.maker.toUpperCase()}, SOLO</dd>
              </div>
              <div class="seal__labelline">
                <dt>SHIP TO</dt>
                <dd>YOU</dd>
              </div>
              <div class="seal__labelline">
                <dt>CONTENTS</dt>
                <dd>{shippedCount} SMALL TOOLS + {researchCount} IN RESEARCH</dd>
              </div>
              <div class="seal__labelline">
                <dt>PACKED</dt>
                <dd>{packedOn}</dd>
              </div>
              <div class="seal__labelline seal__labelline--status">
                <dt>STATUS</dt>
                <dd>
                  <span class="seal__status-sealed" data-status-sealed>SEALED</span>
                  <span class="seal__status-open" data-status-open>
                    OPEN<span class="seal__openedby" data-opened-date></span>
                  </span>
                </dd>
              </div>
            </dl>
            <div class="seal__labelside">
              <p class="seal__tagline">{site.tagline}</p>
              <p class="seal__manifesto">{site.manifesto}</p>
              <div class="seal__barcode" aria-hidden="true">
                {Array.from({ length: 34 }).map((_, i) => (
                  <span style={`--w:${(i * 7) % 4 === 0 ? 3 : 1}px`}></span>
                ))}
                <span class="seal__barcode-n mono">SN TOB-2026-001 · LOCAL-FIRST</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- the tape can be held still — moving print needs an off switch -->
      <button
        class="seal__tapehold mono"
        data-tape-hold
        type="button"
        aria-pressed="false"
        aria-label="Pause the moving tape print"
      >HOLD TAPE</button>

      <!-- the cut overlay at the seam: the slit + the blade riding its tip -->
      <div class="seal__cut" aria-hidden="true">
        <div class="seal__cutline"></div>
        <div class="seal__blade">
          <svg width="22" height="26" viewBox="0 0 22 26" fill="none" aria-hidden="true">
            <path d="M11 1 L11 17" stroke="currentColor" stroke-width="2" />
            <path d="M11 17 L5 25 M11 17 L17 25" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </div>
      </div>

      <!-- corner crops -->
      <span class="seal__crop seal__crop--tl" aria-hidden="true"></span>
      <span class="seal__crop seal__crop--tr" aria-hidden="true"></span>
      <span class="seal__crop seal__crop--bl" aria-hidden="true"></span>
      <span class="seal__crop seal__crop--br" aria-hidden="true"></span>

      <!-- HUD: cut progress -->
      <div class="seal__hud mono" aria-hidden="true">
        <span class="seal__hud-item">⌀ BOX / 001</span>
        <span class="seal__hud-cue" data-seal-cue>SCROLL TO CUT THE SEAL <span class="r90">▸</span></span>
        <span class="seal__hud-item"><span data-seal-pct>SEAL / 000%</span></span>
      </div>
    </div>

    <!-- ================= INTERIOR (beneath the flaps) ================= -->
    <div class="seal__interior">
      <div class="wrap seal__interior-inner">
        <p class="seal__interior-eyebrow mono">
          <span aria-hidden="true">⌀</span> BOX / 001 — INTERIOR · SEAL CUT
        </p>
        <p class="seal__nothing" aria-label="Nothing hidden.">
          Nothing<br />hidden.
        </p>
        <ul class="seal__contents mono" aria-label="Contents">
          {contents.map((c, i) => (
            <li class:list={["seal__content", { "seal__content--dim": c.dim }]} style={`--i:${i}`}>
              {c.dim ? (
                <span class="seal__content-in">
                  <span class="seal__content-vol">{c.vol}</span>
                  <span class="seal__content-name">{c.codename}</span>
                  <span class="seal__content-status">{c.status}</span>
                </span>
              ) : (
                <a class="seal__content-in" href={c.href}>
                  <span class="seal__content-vol">{c.vol}</span>
                  <span class="seal__content-name">{c.codename}</span>
                  <span class="seal__content-status">{c.status}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
        <p class="seal__interior-cue mono" aria-hidden="true">
          UNPACK BELOW <span class="r90">▸</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     DEFAULT = static, already open. This is what reduced-motion and no-JS
     visitors get: label face (STATUS / OPEN), then the interior, as flow.
     ========================================================================== */
  .seal {
    position: relative;
  }
  .seal__pin {
    position: relative;
  }
  .seal__face {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(color-mix(in oklab, var(--carton) 92%, #fff 8%), var(--carton) 24%, var(--carton-2));
    color: var(--ink);
    overflow: hidden;
  }
  .seal__flap {
    position: relative;
    display: flex;
  }
  .seal__flap--top {
    flex: 1.18;
    align-items: stretch;
  }
  .seal__flap--bottom {
    flex: 1;
  }
  .seal__flapinner {
    position: relative;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
  }
  .seal__flapinner--top {
    justify-content: flex-end;
    padding-top: calc(54px + 2.5rem); /* clear the masthead */
    padding-bottom: clamp(2.4rem, 5.5vh, 4rem);
  }
  .seal__flapinner--bottom {
    justify-content: flex-end;
    padding-top: clamp(2.6rem, 6vh, 4.5rem);
    padding-bottom: clamp(2.6rem, 7vh, 5rem);
  }

  .seal__eyebrow {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--carton-print);
    margin-bottom: clamp(1rem, 2.5vh, 1.8rem);
  }
  .seal__wordmark {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 13.5vh, 9.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.88;
    text-transform: none;
  }
  .seal__edgeprint {
    position: absolute;
    right: calc(var(--gutter) * 0.35);
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
    font-size: 0.56rem;
    letter-spacing: 0.26em;
    color: var(--carton-print);
    opacity: 0.75;
    white-space: nowrap;
  }
  /* the edge print needs empty board to sit on — below 900px it collides
     with the wordmark, so it stays off */
  @media (max-width: 900px) {
    .seal__edgeprint {
      display: none;
    }
  }
  .seal__foldline {
    position: absolute;
    left: 0;
    right: 0;
    border-top: var(--hair) dashed var(--carton-edge);
  }
  .seal__foldline--top {
    top: calc(54px + 0.75rem);
  }
  .seal__foldline--bottom {
    bottom: 0.9rem;
  }

  /* ---- shipping label ---- */
  .seal__labelrow {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.4rem, 4vw, 3.5rem);
    align-items: end;
  }
  @media (min-width: 800px) {
    .seal__labelrow {
      grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
      align-items: start;
    }
  }
  .seal__label {
    border: var(--hair-strong) solid var(--ink);
    background: color-mix(in oklab, var(--paper) 88%, var(--carton));
    padding: clamp(0.8rem, 1.6vw, 1.1rem) clamp(0.9rem, 2vw, 1.3rem);
    max-width: 460px;
    align-self: start;
  }
  .seal__labelline {
    display: grid;
    grid-template-columns: 5.4rem 1fr;
    gap: 0.8rem;
    padding-block: 0.34rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }
  .seal__labelline + .seal__labelline {
    border-top: var(--hair) dotted var(--line-2);
  }
  .seal__labelline dt {
    color: var(--label-aa);
    font-weight: 500;
  }
  .seal__labelline dd {
    color: var(--ink);
    font-weight: 600;
  }
  /* status: default (static fallback) shows OPEN */
  .seal__status-sealed {
    display: none;
  }
  .seal__status-open {
    color: var(--accent-text);
  }
  .seal__openedby {
    color: var(--ink-2);
    font-weight: 500;
    margin-left: 0.6em;
  }
  .seal__openedby:not(:empty)::before {
    content: "· BY YOU · ";
  }

  .seal__labelside {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 44ch;
  }
  .seal__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1rem + 1.1vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .seal__manifesto {
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 40ch;
  }
  .seal__barcode {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    flex-wrap: wrap;
    max-width: 220px;
  }
  .seal__barcode > span:not(.seal__barcode-n) {
    width: var(--w, 1px);
    height: 24px;
    background: var(--ink);
    opacity: 0.85;
  }
  .seal__barcode-n {
    flex-basis: 100%;
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    color: var(--carton-print);
    margin-top: 0.3rem;
  }

  /* ---- the tape ----
     Each flap carries its own half of the tape at the seam edge, so when the
     flaps hinge apart the tape goes with the board — like real packing tape
     that has been cut down the middle. */
  .seal__tapehalf {
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(20px, 3.2vh, 27px);
    overflow: hidden;
    background: var(--accent);
    z-index: 2;
  }
  .seal__flap--top .seal__tapehalf {
    bottom: 0;
  }
  .seal__flap--bottom .seal__tapehalf {
    top: 0;
  }
  .seal__tapetrack {
    position: absolute;
    left: 0;
    display: flex;
    white-space: nowrap;
    animation: seal-tape-scroll 64s linear infinite;
    will-change: transform;
  }
  /* both halves render the same full-height line; the bottom half shifts it up
     so the two strips complete each glyph across the seam */
  .seal__flap--top .seal__tapetrack {
    top: 0;
  }
  .seal__flap--bottom .seal__tapetrack {
    top: calc(-1 * clamp(20px, 3.2vh, 27px));
  }
  .seal__tapetrack span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* printed tape carries constant dark ink — ≥5.9:1 on both theme oranges */
    color: #141210;
    line-height: clamp(40px, 6.4vh, 54px);
    padding-right: 2em;
  }
  @keyframes seal-tape-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* pause points: the HOLD control, hover, or no JS (no control = no motion) */
  .seal.tape-held .seal__tapetrack,
  .seal__tapehalf:hover .seal__tapetrack {
    animation-play-state: paused;
  }
  :global(html:not(.js)) .seal__tapetrack {
    animation-play-state: paused;
  }
  .seal__tapehold {
    position: absolute;
    right: calc(var(--gutter) * 0.5);
    top: 54.15%;
    transform: translateY(-50%);
    z-index: 4;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #141210;
    background: color-mix(in oklab, #ffffff 30%, transparent);
    border: 1px solid #141210;
    border-radius: 2px;
    padding: 0.35em 0.6em;
    white-space: nowrap;
  }
  :global(html:not(.js)) .seal__tapehold {
    display: none;
  }
  /* cut affordances exist only in the enhanced scene */
  .seal__cut,
  .seal__cutline,
  .seal__blade {
    display: none;
  }
  /* static fallback: the tape is already cut — halves rest slightly apart */
  .seal__flap--top .seal__tapehalf {
    transform: translateY(-3px) rotate(-0.2deg);
  }
  .seal__flap--bottom .seal__tapehalf {
    transform: translateY(3px) rotate(0.15deg);
  }

  /* ---- corner crops ---- */
  .seal__crop {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid var(--carton-edge);
    z-index: 3;
  }
  .seal__crop--tl { top: calc(54px + 10px); left: 10px; border-top-width: 1px; border-left-width: 1px; }
  .seal__crop--tr { top: calc(54px + 10px); right: 10px; border-top-width: 1px; border-right-width: 1px; }
  .seal__crop--bl { bottom: 10px; left: 10px; border-bottom-width: 1px; border-left-width: 1px; }
  .seal__crop--br { bottom: 10px; right: 10px; border-bottom-width: 1px; border-right-width: 1px; }

  /* ---- HUD ---- */
  .seal__hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem var(--gutter);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--carton-print);
    z-index: 4;
  }
  .seal__hud-cue {
    display: none; /* only meaningful in the scroll-driven scene */
  }

  /* ---- interior ---- */
  .seal__interior {
    position: relative;
    background: var(--interior);
    color: var(--interior-ink);
    display: flex;
    align-items: center;
  }
  .seal__interior-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: clamp(4rem, 12vh, 8rem);
  }
  .seal__interior-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--interior-ink) 55%, transparent);
    margin-bottom: clamp(1.2rem, 3vh, 2rem);
  }
  .seal__interior-eyebrow span {
    color: var(--accent);
  }
  .seal__nothing {
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vh, 8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.92;
    margin-bottom: clamp(2rem, 5vh, 3.4rem);
  }
  .seal__contents {
    width: 100%;
    max-width: 560px;
    border-top: var(--hair) solid var(--interior-line);
    margin-bottom: clamp(1.8rem, 4vh, 2.8rem);
  }
  .seal__content-in {
    display: grid;
    grid-template-columns: 4.6rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.72rem 0.2rem;
    border-bottom: var(--hair) solid var(--interior-line);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  a.seal__content-in:hover,
  a.seal__content-in:focus-visible {
    background: color-mix(in oklab, var(--interior-ink) 8%, transparent);
  }
  a.seal__content-in:hover .seal__content-name {
    color: var(--accent);
  }
  .seal__content-vol {
    color: color-mix(in oklab, var(--interior-ink) 60%, transparent);
    font-size: 0.66rem;
  }
  .seal__content-name {
    font-weight: 700;
    letter-spacing: 0.14em;
    transition: color 0.15s var(--ease);
  }
  .seal__content-status {
    font-size: 0.6rem;
    color: color-mix(in oklab, var(--interior-ink) 55%, transparent);
  }
  /* the sealed volume reads dimmer via ink mix, never via opacity — it must
     stay legible (≥4.5:1) even while clearly "not yet" */
  .seal__content--dim .seal__content-name {
    color: color-mix(in oklab, var(--interior-ink) 62%, transparent);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .seal__interior-cue {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: color-mix(in oklab, var(--interior-ink) 50%, transparent);
  }

  /* ==========================================================================
     ENHANCED = the scroll-driven scene. Only under html.js + motion-ok, and
     only when the viewport is tall enough to hold the pinned face without
     clipping the label (short/landscape-phone viewports get the static
     already-open layout instead).
     --pcut  0..1  blade travels the tape
     --popen 0..1  flaps hinge apart, interior revealed
     ========================================================================== */
  @media (prefers-reduced-motion: no-preference) and (min-height: 561px) {
    :global(html.js) .seal {
      /* scene length: one viewport pinned + the scroll that drives it */
      height: 300vh;
      height: 300svh;
    }
    :global(html.js) .seal__pin {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }
    :global(html.js) .seal__interior {
      position: absolute;
      inset: 0;
      z-index: 0;
      transform: scale(calc(0.965 + var(--popen, 0) * 0.035));
    }
    /* dim the interior until the flaps let light in */
    :global(html.js) .seal__interior::after {
      content: "";
      position: absolute;
      inset: 0;
      background: #000;
      opacity: calc(0.72 * (1 - var(--popen, 0)));
      pointer-events: none;
    }
    :global(html.js) .seal__face {
      position: absolute;
      inset: 0;
      z-index: 1;
      min-height: 0;
      background: none;
      perspective: 1400px;
      perspective-origin: 50% 50%;
      pointer-events: none;
    }
    :global(html.js) .seal__flap {
      position: absolute;
      left: 0;
      right: 0;
      background:
        linear-gradient(color-mix(in oklab, var(--carton) 92%, #fff 8%), var(--carton) 24%, var(--carton-2));
      backface-visibility: hidden;
      will-change: transform;
      pointer-events: auto;
    }
    /* the face is one printed surface split at the seam: the bottom flap
       carries the shared board gradient offset so the two halves match */
    :global(html.js) .seal__flap--top {
      top: 0;
      height: 54.15%;
      transform-origin: 50% 0%;
      transform: rotateX(calc(var(--popen, 0) * 82deg));
    }
    :global(html.js) .seal__flap--bottom {
      bottom: 0;
      height: 45.85%;
      background: var(--carton-2);
      transform-origin: 50% 100%;
      transform: rotateX(calc(var(--popen, 0) * -82deg));
    }
    /* shade deepens on each flap as it folds away */
    :global(html.js) .seal__flap::after {
      content: "";
      position: absolute;
      inset: 0;
      background: #000;
      opacity: calc(var(--popen, 0) * 0.5);
      pointer-events: none;
    }
    :global(html.js) .seal__flap .seal__flapinner {
      height: 100%;
    }

    /* clip everything to the board — printed content cannot leave the flap */
    :global(html.js) .seal__flap {
      overflow: hidden;
    }
    /* before the cut the halves sit flush; the release is a small snap apart */
    :global(html.js) .seal__flap--top .seal__tapehalf {
      transform: translateY(calc(var(--tsep, 0) * -3px)) rotate(calc(var(--tsep, 0) * -0.2deg));
    }
    :global(html.js) .seal__flap--bottom .seal__tapehalf {
      transform: translateY(calc(var(--tsep, 0) * 3px)) rotate(calc(var(--tsep, 0) * 0.15deg));
    }

    /* the cut overlay: a slit + blade riding its tip along the seam */
    :global(html.js) .seal__cut {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 54.15%;
      height: 0;
      z-index: 3;
      pointer-events: none;
      opacity: calc(1 - var(--popen, 0) * 3);
    }
    :global(html.js) .seal__cutline {
      display: block;
      position: absolute;
      left: 0;
      top: -1.5px;
      width: 100%;
      height: 3px;
      background: var(--ink);
      transform: scaleX(var(--pcut, 0));
      transform-origin: 0 50%;
      will-change: transform;
    }
    :global(html.js) .seal__blade {
      display: block;
      position: absolute;
      left: -11px;
      top: -24px;
      color: var(--ink);
      transform: translateX(calc(var(--pcut, 0) * 100vw));
      will-change: transform;
      opacity: 1;
      transition: opacity 0.25s var(--ease);
    }
    :global(html.js) .seal.is-cut .seal__blade {
      opacity: 0;
    }

    /* status swap: sealed until the cut completes */
    :global(html.js) .seal:not(.is-cut) .seal__status-sealed {
      display: inline;
      color: var(--ink);
    }
    :global(html.js) .seal:not(.is-cut) .seal__status-open {
      display: none;
    }
    :global(html.js) .seal.is-cut .seal__status-open {
      display: inline;
      animation: seal-stamp 0.34s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    @keyframes seal-stamp {
      from {
        opacity: 0;
        transform: scale(1.45);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* HUD cue behavior */
    :global(html.js) .seal__hud {
      z-index: 5;
    }
    :global(html.js) .seal__hud-cue {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      transition: opacity 0.3s var(--ease);
    }
    :global(html.js) .seal.is-cutting .seal__hud-cue {
      opacity: 0;
    }
    :global(html.js) .seal__hud {
      opacity: calc(1 - var(--popen, 0) * 2);
    }

    /* interior copy: held until the flaps open, then set down in sequence */
    :global(html.js) .seal__interior-eyebrow,
    :global(html.js) .seal__nothing,
    :global(html.js) .seal__contents,
    :global(html.js) .seal__interior-cue {
      opacity: 0;
      transform: translateY(26px);
      transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
    }
    :global(html.js) .seal.is-open .seal__interior-eyebrow {
      opacity: 1;
      transform: none;
      transition-delay: 0.05s;
    }
    :global(html.js) .seal.is-open .seal__nothing {
      opacity: 1;
      transform: none;
      transition-delay: 0.12s;
    }
    :global(html.js) .seal.is-open .seal__contents {
      opacity: 1;
      transform: none;
      transition-delay: 0.3s;
    }
    :global(html.js) .seal.is-open .seal__interior-cue {
      opacity: 1;
      transform: none;
      transition-delay: 0.55s;
    }
    /* contents rows tick in one by one */
    :global(html.js) .seal__content {
      opacity: 0;
      transform: translateX(-10px);
      transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
      transition-delay: calc(0.34s + var(--i) * 0.09s);
    }
    :global(html.js) .seal.is-open .seal__content {
      opacity: 1;
      transform: none;
    }

    /* the HOLD control rides the seam like the cut overlay */
    :global(html.js) .seal__tapehold {
      opacity: calc(1 - var(--popen, 0) * 3);
    }
    :global(html.js) .seal.is-open .seal__tapehold {
      pointer-events: none;
    }

    /* shorter scene on small screens — same mechanic, less scroll. The
       pinned bottom flap is only ~45svh tall there, so the label keeps the
       essentials and drops the prose (still present for static visitors). */
    @media (max-width: 720px) {
      :global(html.js) .seal {
        height: 230vh;
        height: 230svh;
      }
      :global(html.js) .seal__manifesto,
      :global(html.js) .seal__barcode {
        display: none;
      }
      :global(html.js) .seal__flapinner--bottom {
        padding-bottom: clamp(1.6rem, 5vh, 2.6rem);
      }
      :global(html.js) .seal__labelline {
        padding-block: 0.26rem;
      }
    }

    /* short-but-pinnable viewports (561–700px): keep the scene, shed bulk so
       the printed stack fits inside each flap and the interior clears the
       masthead */
    @media (max-height: 700px) {
      :global(html.js) .seal__manifesto,
      :global(html.js) .seal__barcode {
        display: none;
      }
      :global(html.js) .seal__flapinner--top {
        padding-bottom: clamp(1.2rem, 3vh, 2rem);
      }
      :global(html.js) .seal__flapinner--bottom {
        padding-top: 1.2rem;
        padding-bottom: clamp(1.4rem, 4vh, 2.2rem);
      }
      :global(html.js) .seal__labelline {
        padding-block: 0.22rem;
      }
      :global(html.js) .seal__eyebrow {
        margin-bottom: 0.7rem;
      }
      :global(html.js) .seal__interior-inner {
        padding-block: 70px 40px;
      }
      :global(html.js) .seal__nothing {
        margin-bottom: 1.4rem;
      }
      :global(html.js) .seal__contents {
        margin-bottom: 1.2rem;
      }
    }
  }

  /* very short screens: keep the wordmark from crowding the label */
  @media (max-height: 620px) {
    .seal__wordmark {
      font-size: clamp(2.8rem, 11vh, 6rem);
    }
  }
</style>

<script>
  /* Scroll driver for the seal scene. Reads one rect per frame, writes CSS
     custom props + threshold classes. Transform/opacity only downstream. */
  function initSeal() {
    // Must mirror the CSS gate exactly: the scene only pins under motion-ok
    // AND a viewport tall enough to hold the printed face.
    const enhanced = window.matchMedia(
      "(prefers-reduced-motion: no-preference) and (min-height: 561px)",
    );
    const seal = document.querySelector<HTMLElement>("[data-seal]");
    const pin = document.querySelector<HTMLElement>("[data-seal-pin]");
    const pct = document.querySelector<HTMLElement>("[data-seal-pct]");
    const openedDate = document.querySelector<HTMLElement>("[data-opened-date]");
    const interior = seal?.querySelector<HTMLElement>(".seal__interior");
    const hold = seal?.querySelector<HTMLButtonElement>("[data-tape-hold]");
    if (!seal || !pin) return;

    // The visit date on the OPENED stamp — the visitor's own, set client-side.
    const stampDate = () => {
      if (openedDate && !openedDate.textContent) {
        const d = new Date();
        openedDate.textContent = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
      }
    };

    // The tape HOLD control works in every mode the marquee runs in.
    hold?.addEventListener("click", () => {
      const held = seal.classList.toggle("tape-held");
      hold.setAttribute("aria-pressed", String(held));
      hold.textContent = held ? "RUN TAPE" : "HOLD TAPE";
      hold.setAttribute(
        "aria-label",
        held ? "Resume the moving tape print" : "Pause the moving tape print",
      );
    });

    if (!enhanced.matches) stampDate();

    let ticking = false;
    let lastText = "";
    let wasCut = false;

    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));

    const update = () => {
      ticking = false;
      if (!enhanced.matches) {
        // static layout (reduced motion or short viewport): no pin, no inert
        interior?.removeAttribute("inert");
        stampDate();
        return;
      }
      const rect = seal.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = rect.height - vh;
      const p = total > 0 ? clamp01(-rect.top / total) : 1;

      // beat of stillness → cut → release → open
      const pcut = clamp01((p - 0.06) / 0.42);
      const tsep = clamp01((pcut - 0.96) / 0.04); // tape tension release
      const popen = clamp01((p - 0.54) / 0.4);

      pin.style.setProperty("--pcut", pcut.toFixed(4));
      pin.style.setProperty("--tsep", tsep.toFixed(3));
      pin.style.setProperty("--popen", popen.toFixed(4));

      seal.classList.toggle("is-cutting", p > 0.06);
      const cut = pcut >= 1;
      seal.classList.toggle("is-cut", cut);
      if (cut && !wasCut) {
        wasCut = true;
        stampDate();
      }
      const open = popen > 0.32;
      seal.classList.toggle("is-open", open);
      // while the flaps still cover the interior, its links must not be
      // reachable by keyboard or assistive tech
      if (interior) interior.toggleAttribute("inert", !open);

      if (pct) {
        const text = cut
          ? "STATUS / OPEN"
          : `SEAL / ${String(Math.round(pcut * 100)).padStart(3, "0")}%`;
        if (text !== lastText) {
          lastText = text;
          pct.textContent = text;
        }
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    enhanced.addEventListener?.("change", onScroll);
    update();
  }

  if (document.readyState !== "loading") initSeal();
  else document.addEventListener("DOMContentLoaded", initSeal);
</script>
