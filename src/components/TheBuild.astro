---
/* =============================================================================
   05 / BUILD — the other half of the workshop.

   The box holds tools. This is the bench beside it: complete websites, built
   one trade at a time, and shown as finished sites rather than described. The
   catalogue lives on its own domain because each design has to be free to look
   nothing like this one — so this section is a door, not a gallery.
   ========================================================================== */
import SectionHeader from "./SectionHeader.astro";
import { build } from "../data/build.ts";
---

<section class="section build-zone" id="build" aria-labelledby="build-h">
  <div class="wrap">
    <SectionHeader
      index="05"
      glyph="✺"
      title="Build"
      sublabel={`${String(build.live).padStart(2, "0")} / ${String(build.listed).padStart(2, "0")} BUILT`}
      kicker="WEBSITES, ONE TRADE AT A TIME"
      id="build-h"
    />

    <div class="build">
      <div class="build__say">
        <p class="build__lede" data-reveal>
          The tools above are for people who already work at a screen. This is for
          the ones who don&rsquo;t — a salon, a clinic, a café, a chemist. One
          complete website per trade, written for that trade, and
          <strong>shown as a finished site instead of a mockup</strong>.
        </p>

        <p class="build__sub muted" data-reveal style="--reveal-delay:.06s">
          Pick the category closest to your business and walk through the whole
          thing — the menu, the prices, the booking — the way a customer would.
          {build.live === 1
            ? "One design is finished so far; the rest of the list is queued and honest about it."
            : `${build.live} designs are finished so far; the rest of the list is queued and honest about it.`}
        </p>

        <div class="build__acts" data-reveal style="--reveal-delay:.12s">
          <a class="btn btn--accent" href={build.url}>
            Open the catalogue <span class="glyph" aria-hidden="true">↪</span>
          </a>
          <a class="btn btn--ghost" href={build.featured.url}>
            See the {build.featured.trade.toLowerCase()} design
          </a>
        </div>
      </div>

      <ul class="build__trades" data-reveal style="--reveal-delay:.08s" aria-label="Trades in the catalogue">
        {
          build.trades.map((t) => (
            <li class="build__trade" data-live={t.live ? "true" : "false"}>
              <span class="build__tradename mono">{t.name}</span>
              <span class="pill build__pill" data-status={t.live ? "live" : undefined}>
                {t.live ? "BUILT" : "QUEUED"}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="build__note mono" data-reveal>
      <span class="glyph" aria-hidden="true">§</span>
      Every business in a demo is invented, and every demo says so. Nothing on that
      site is a real shop.
    </p>
  </div>
</section>

<style>
  /* A different bench: the hairline grid of a drawing board, so the section
     reads as somewhere things are drawn rather than shipped. */
  .build-zone {
    background:
      linear-gradient(to right, color-mix(in oklab, var(--ink) 4%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--ink) 4%, transparent) 1px, transparent 1px),
      var(--paper);
    background-size: 32px 32px, 32px 32px, auto;
    border-block: var(--hair) solid var(--line);
  }

  .build {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .build__say {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .build__lede {
    font-size: clamp(1.05rem, 0.95rem + 0.55vw, 1.4rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    max-width: 42ch;
  }
  .build__lede strong {
    font-weight: 600;
  }
  .build__sub {
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 52ch;
  }
  .build__acts {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }

  .build__trades {
    display: grid;
    gap: 0;
    border: var(--hair) solid var(--line);
    background: var(--paper);
  }
  .build__trade {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    border-bottom: var(--hair) solid var(--line);
  }
  .build__trade:last-child {
    border-bottom: 0;
  }
  .build__trade[data-live="false"] {
    color: var(--ink-2);
  }
  .build__tradename {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
  }
  .build__pill {
    font-size: 0.58rem;
    flex: none;
  }

  .build__note {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.1rem;
    border-top: var(--hair) solid var(--line);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 74ch;
  }
  .build__note .glyph {
    color: var(--accent);
  }

  @media (min-width: 880px) {
    .build {
      grid-template-columns: 1.3fr minmax(17rem, 0.7fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>
