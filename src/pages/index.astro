---
import Base from "../layouts/Base.astro";
import Ticker from "../components/Ticker.astro";
import OpenBox from "../components/OpenBox.astro";
import TheIndex from "../components/TheIndex.astro";
import TheLedger from "../components/TheLedger.astro";
import TheDoctrine from "../components/TheDoctrine.astro";
import InTheLab from "../components/InTheLab.astro";
import Dispatches from "../components/Dispatches.astro";
import Colophon from "../components/Colophon.astro";
import CreaseDivider from "../components/CreaseDivider.astro";
import { site } from "../data/site.ts";
---

<Base path="/">
  <Ticker lead={`FIELD NOTES — ${site.volume}`} items={site.claims} />
  <OpenBox />
  <CreaseDivider variant="fold" />
  <TheIndex />
  <CreaseDivider variant="flap" />
  <TheLedger />
  <CreaseDivider variant="fold" />
  <TheDoctrine />
  <CreaseDivider variant="flap" />
  <InTheLab />
  <CreaseDivider variant="fold" />
  <Dispatches />
  <CreaseDivider variant="flap" />
  <Colophon />
</Base>
