---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../data/site.ts";

export async function getStaticPaths() {
  const posts = await getCollection("dispatches", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, ".");
---

<Base
  title={post.data.title}
  description={post.data.summary}
  path={`/dispatches/${post.id}/`}
  type="article"
>
  <article class="post section">
    <div class="wrap post__wrap">
      <p class="back mono"><a href="/dispatches/">◂ ALL DISPATCHES</a></p>

      <header class="post__head">
        <div class="post__meta mono">
          <span class="post__n">§{String(post.data.n).padStart(3, "0")}</span>
          <span class="dot-sep">·</span>
          <span>{fmt(post.data.date)}</span>
          <span class="tag mono">{post.data.tag}</span>
          {post.data.vol && <span class="tag mono">{post.data.vol}</span>}
        </div>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__summary">{post.data.summary}</p>
      </header>

      <hr class="hairline" />

      <div class="post__body prose">
        <Content />
      </div>

      <footer class="post__foot">
        <a class="btn btn--ghost" href="/dispatches/">◂ MORE DISPATCHES</a>
        <a class="btn btn--ghost" href={site.links.rss}>RSS ▸</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post__wrap {
    max-width: 760px;
  }
  .back {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    margin-bottom: 1.8rem;
  }
  .back a:hover {
    color: var(--accent);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin-bottom: 1.2rem;
  }
  .post__n {
    color: var(--accent);
    font-weight: 600;
  }
  .post__title {
    font-size: clamp(2rem, 1.3rem + 3vw, 3.4rem);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .post__summary {
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }
  .post__body {
    margin-top: 2rem;
  }
  .post__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: var(--hair) solid var(--line);
  }

  /* prose */
  .prose :global(h2) {
    font-size: clamp(1.3rem, 1rem + 1.4vw, 1.8rem);
    letter-spacing: -0.02em;
    margin: 2.2rem 0 0.8rem;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin: 1.8rem 0 0.6rem;
  }
  .prose :global(p) {
    margin-bottom: 1.1rem;
    color: var(--ink);
    max-width: 68ch;
    line-height: 1.65;
  }
  .prose :global(a) {
    color: var(--accent);
    border-bottom: var(--hair) solid currentColor;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .prose :global(li) {
    color: var(--ink-2);
    position: relative;
    padding-left: 1.1em;
    max-width: 66ch;
  }
  .prose :global(ul li)::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .prose :global(ol) {
    counter-reset: li;
  }
  .prose :global(ol li)::before {
    counter-increment: li;
    content: counter(li, decimal-leading-zero);
    position: absolute;
    left: -0.4em;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--shade);
    padding: 0.12em 0.4em;
    border-radius: 2px;
  }
  .prose :global(pre) {
    font-family: var(--font-mono);
    background: var(--field);
    border: var(--hair) solid var(--line-2);
    border-radius: 2px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin-bottom: 1.3rem;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
